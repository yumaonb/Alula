---
// BaseLayout.astro — 基础布局
// 用法：<BaseLayout title="页面标题"> ... </BaseLayout>

import { Image, getImage } from "astro:assets";
import bgImageRaw from "../assets/images/background.jpg";
import avatarRaw from "../assets/images/avatar.png";
import "../assets/css/global.css";
import "../assets/css/skeleton.css";
import NavBar from "../components/layout/NavBar.astro";
import Footer from "../components/layout/Footer.astro";
import BackToTop from "../components/layout/BackToTop.svelte";
import BackToBottom from "../components/layout/BackToBottom.svelte";
import BackToComments from "../components/posts/BackToComments.svelte";
import ReadingProgress from "../components/layout/ReadingProgress.svelte";
import TocModal from "../components/posts/TocModal.svelte";
import PostsFilterFab from "../components/posts/PostsFilterFab.svelte";
import CustomScrollbar from "../components/layout/CustomScrollbar.astro";
import { site } from "../data/site";

const avatarImage = await getImage({
  src: avatarRaw,
  format: "webp",
  quality: 80,
  width: 192,
});

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}

const {
  title,
  description = site.description,
  bodyClass = "",
} = Astro.props;

const pageTitle = title ? `${title} - ${site.name}` : site.name;
const bgAspectStyle = `@media (min-aspect-ratio: ${bgImageRaw.width}/${bgImageRaw.height}) { img.bg-layer { object-fit: fill; } }`;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content={site.colorScheme} />
    <link rel="icon" type="image/webp" href={avatarImage.src} />
    <title>{pageTitle}</title>
    <style set:html={bgAspectStyle} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>

    <Image
      src={bgImageRaw}
      alt=""
      class="bg-layer"
      loading="eager"
      decoding="async"
      aria-hidden="true"
    />
    <div class="page">
      <NavBar />
      <main class="hero transition-main" id="swup">
        <slot />
      </main>
      <Footer />
    </div>
    <div class="side-widgets" id="side-widgets">
      <BackToTop client:load />
      <TocModal client:load />
      <PostsFilterFab client:load />
      <ReadingProgress client:load />
      <BackToComments client:load />
      <BackToBottom client:load />
    </div>
    <CustomScrollbar />
    <script is:inline data-swup-ignore-script>
      // swup 切页联动：点击链接即收回侧边按钮并挂起显示判定；
      // 内容替换后监视滚动，静止 150ms 才解除，避免平滑回顶期间按钮闪现。
      // data-swup-ignore-script：只执行一次，防止每次切页重复绑定监听
      (function() {
        var container = document.getElementById('side-widgets');
        if (!container) return;

        var QUIET_MS = 150;
        var CAP_MS = 2500;
        var CAP_EXTEND_MS = 400;
        var MAX_SUSPEND_MS = 6000;
        var settleTimer = null;
        var capTimer = null;
        var watching = false;
        var suspendStart = 0;
        var lastScrollAt = 0;

        function onScroll() {
          lastScrollAt = Date.now();
          if (settleTimer) clearTimeout(settleTimer);
          settleTimer = setTimeout(settle, QUIET_MS);
        }

        function startWatch() {
          if (watching) return;
          watching = true;
          window.addEventListener('scroll', onScroll, { passive: true });
          settleTimer = setTimeout(settle, QUIET_MS); // 无滚动事件（无复位/瞬时复位）也能解除
        }

        function teardown() {
          if (settleTimer) { clearTimeout(settleTimer); settleTimer = null; }
          if (capTimer) { clearTimeout(capTimer); capTimer = null; }
          if (watching) {
            watching = false;
            window.removeEventListener('scroll', onScroll);
          }
        }

        function settle() {
          teardown();
          container.classList.remove('navigating');
        }

        function capTick() {
          capTimer = null;
          var scrollActive = watching && Date.now() - lastScrollAt < QUIET_MS;
          var withinCeiling = Date.now() - suspendStart < MAX_SUSPEND_MS;
          if (scrollActive && withinCeiling) {
            capTimer = setTimeout(capTick, CAP_EXTEND_MS); // 回顶动画未停，不放行
            return;
          }
          settle();
        }

        document.addEventListener('swup:visit:start', function() {
          teardown(); // 快速连续切页：清掉上一轮的监听和计时器
          container.classList.add('navigating');
          container.querySelectorAll('.back-to-widget').forEach(function(b) {
            b.classList.remove('visible');
          });
          suspendStart = Date.now();
          lastScrollAt = 0;
          capTimer = setTimeout(capTick, CAP_MS);
        });

        document.addEventListener('swup:content:replace', startWatch);
      })();
    </script>
  </body>
</html>
