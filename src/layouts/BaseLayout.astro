---
// BaseLayout.astro — 全站基础布局（背景 / 导航 / 页脚 / 侧边按钮 / 灯箱等）
// 用法：<BaseLayout title="页面标题" description="...">...</BaseLayout>
// 背景由 <Background /> 渲染，换方案改 src/data/background.ts 一处即可；
// 回退到旧的整张背景图：取消下面两行 import 与 <body> 里 <Image class="bg-layer"> 的注释，
// 同时删掉 <Background /> 与 Background 的 import。
// import { Image } from 'astro:assets';
// import bgImageRaw from '../assets/backgrounds/images/background.jpg';
import '../assets/css/global.css';
import '../assets/css/skeleton.css';
import '../assets/css/image-fallback.css';
import NavBar from '../components/layout/NavBar.astro';
import Background from '../components/layout/Background.astro';
import Footer from '../components/layout/Footer.astro';
import SideWidgets from '../components/layout/SideWidgets.astro';
import TocModal from '../components/posts/TocModal.svelte';
import PostsFilterModal from '../components/posts/PostsFilterModal.svelte';
import CustomScrollbar from '../components/layout/CustomScrollbar.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  /** 隐藏文章：给页面加 noindex，别让搜索引擎把直链页收录出去 */
  noindex?: boolean;
}

const { title, description = site.description, bodyClass = '', noindex = false } = Astro.props;

const pageTitle = title ? `${title} - ${site.name}` : site.name;
// const bgAspectStyle = `@media (min-aspect-ratio: ${bgImageRaw.width}/${bgImageRaw.height}) { img.bg-layer { object-fit: fill; } }`;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content={site.colorScheme} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <!-- RSS 自动发现：阅读器与浏览器靠这条找到 /posts/rss.xml -->
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/posts/rss.xml" />
    <title>{pageTitle}</title>
    <!-- 旧背景图的宽高比兜底，随背景图一起保留 -->
    <!-- <style set:html={bgAspectStyle}></style> -->
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <!-- <Image
      src={bgImageRaw}
      alt=""
      class="bg-layer"
      loading="eager"
      decoding="async"
      aria-hidden="true"
    /> -->
    <!-- 全站背景：方案由 src/data/background.ts 决定，绘制样式见 src/assets/backgrounds/ -->
    <Background />
    <div class="page">
      <NavBar />
      <main class="hero transition-main" id="swup">
        <slot />
      </main>
      <Footer />
    </div>
    <!-- 侧边悬浮按钮列：静态标记，运行时（可用性/显隐/进度）由 swup-widgets.js 控制 -->
    <SideWidgets />
    <!-- 正文图片占位图标模板：隐藏不占位，图片加载失败时由 image-fallback.js 克隆 -->
    <div id="alula-img-ph-icon" hidden>
      <Icon name="mdi:image-off-outline" />
    </div>
    <TocModal client:idle />
    <PostsFilterModal client:idle />
    <CustomScrollbar />
    <script>
      // swup-widgets.js：侧边按钮运行时控制器（模块脚本只执行一次，无需 is:inline）
      import '../assets/js/swup-widgets.js';
    </script>
    <script>
      // image-fallback.js：封面图加载失败时隐藏破损图片、露出占位背景
      import '../assets/js/image-fallback.js';
    </script>
    <script>
      // lightbox.js：正文图片灯箱触发器（灯箱本体懒加载，首次点击才加载）
      import '../assets/js/lightbox.js';
    </script>
  </body>
</html>
