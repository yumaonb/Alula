---
// BaseLayout.astro — 全站基础布局（背景 / 导航 / 常驻侧栏 / 页脚 / 侧边按钮 / 灯箱等）
// 用法：<BaseLayout title="页面标题" shellVariant="listing">...</BaseLayout>
//
// 关键结构：文章区左侧边栏（GlobalSidebar）与搜索框（PostSearch）放在 main#swup 之外、
// 所有站点页的壳里——swup 切页只替换 #swup 内容，侧栏与搜索永不重建：
// 搜索若是 #swup 内容里带 data-swup-persist 的岛，每次切页节点都会被摘出再插回，
// .glass 胶囊（backdrop-filter + 投影）的层每次重建，阴影一闪一闪；
// 行级常驻后节点终生不移动、不参与位移动画，阴影/磨砂恒定，切页零闪。
// 非文章页搜索靠 global.css 的 .page-main--* 变体类隐藏（visibility + opacity）；
// 变体类首屏由 shellVariant 决定，切页后由 posts-shell.ts 按内容同步。
// 位置按页头占位符（.posts-header-search）计算写内联 top/left/width：首帧由 body 尾
// is:inline 脚本先写（无网络依赖，慢网下搜索框不等 JS 包即可见），posts-shell.ts
// 加载后重测接管。该脚本带 data-swup-ignore-script——swup 切页不重跑，否则切到列表页
// 会在转场编排前强制显出搜索框（「移两次 / 闪一下」，见 TROUBLESHOOTING 52）。
import '../assets/css/global.css';
import '../assets/css/shared/skeleton.css';
import '../assets/css/posts/image-fallback.css';
import NavBar from '../components/layout/NavBar.astro';
import Background from '../components/layout/Background.astro';
import Footer from '../components/layout/Footer.astro';
import SideWidgets from '../components/layout/SideWidgets.astro';
import GlobalSidebar from '../components/posts/GlobalSidebar.astro';
import PostSearch from '../components/posts/PostSearch.svelte';
import TocModal from '../components/posts/TocModal.svelte';
import PostsFilterModal from '../components/posts/PostsFilterModal.svelte';
import CustomScrollbar from '../components/layout/CustomScrollbar.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';
import { loadBlogData } from '../lib/posts-data';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  /** 隐藏文章：给页面加 noindex，别让搜索引擎把直链页收录出去 */
  noindex?: boolean;
  /** 主内容行变体：plain 普通页 / listing 列表·分类·标签页 / post 文章详情页（PostsShell 传入） */
  shellVariant?: 'plain' | 'listing' | 'post';
}

const {
  title,
  description = site.description,
  bodyClass = '',
  noindex = false,
  shellVariant = 'plain',
} = Astro.props;

const pageTitle = title ? `${title} - ${site.name}` : site.name;
const blog = await loadBlogData();
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <!-- 标记 JS 可用：首载 loading 屏只在 html 带 js 类时显示（无 JS 不显示，避免整屏永久盖住页面） -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/posts/rss.xml" />
    <title>{pageTitle}</title>
    <slot name="head" />
    <!-- 首载 loading 屏样式：必须 is:inline（留在 head 内联，不打包进外链 CSS）。
         首帧只靠这段样式自足：颜色不引用 variables.css 令牌，
         唯一例外是 --bg-base——CSS 背景预设时取预设底色保持衔接，图片预设不定义它则退回深色兜底。 -->
    <style is:inline>
      #boot-splash {
        display: none;
      }
      html.js #boot-splash {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        background:
          radial-gradient(134% 112% at 50% 44%, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 0.5) 100%),
          var(--bg-base, #000);
        transition: opacity 0.5s ease;
      }
      html.js #boot-splash.is-done {
        opacity: 0;
        pointer-events: none;
      }
      .boot-splash-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        animation: boot-splash-in 0.6s ease both;
      }
      .boot-splash-name {
        color: rgba(255, 255, 255, 0.92);
        font-size: 20px;
        letter-spacing: 0.2em;
        text-indent: 0.2em;
      }
      .boot-splash-bar {
        position: relative;
        width: 120px;
        height: 2px;
        border-radius: 999px;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.1);
      }
      .boot-splash-bar-dot {
        position: absolute;
        top: 0;
        left: 0;
        width: 40px;
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(
          90deg,
          rgba(255, 255, 255, 0),
          rgba(255, 255, 255, 0.85),
          rgba(255, 255, 255, 0)
        );
        animation: boot-splash-sweep 1.4s ease-in-out infinite;
      }
      @keyframes boot-splash-in {
        from {
          opacity: 0;
          transform: translateY(6px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
      @keyframes boot-splash-sweep {
        from {
          transform: translateX(-44px);
        }
        to {
          transform: translateX(124px);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        html.js #boot-splash .boot-splash-inner {
          animation: none;
        }
        html.js #boot-splash .boot-splash-bar-dot {
          animation: none;
          opacity: 0;
        }
      }
    </style>
  </head>
  <body class={bodyClass}>
    <!-- 首载 loading 屏：body 第一个元素 + head 内联样式，不依赖任何外部资源即可画出；
         只在首次加载显示（swup 切页不重建 body 壳），页面就绪后 0.5s 渐隐并移除节点 -->
    <div class="boot-splash" id="boot-splash" aria-hidden="true">
      <div class="boot-splash-inner">
        <span class="boot-splash-name">{site.name}</span>
        <span class="boot-splash-bar">
          <span class="boot-splash-bar-dot"></span>
        </span>
      </div>
    </div>
    <Background />
    <div class="page">
      <NavBar />
      <div class:list={['page-main', `page-main--${shellVariant}`]}>
        <GlobalSidebar tree={blog.categoryTree} tags={blog.tags} />
        <main class="hero" id="swup">
          <slot />
        </main>
        <div class="posts-search-float">
          <PostSearch client:load />
        </div>
      </div>
      <Footer />
    </div>
    <SideWidgets />
    <div id="alula-img-ph-icon" hidden>
      <Icon is:inline name="mdi:image-off-outline" />
    </div>
    <TocModal client:idle />
    <PostsFilterModal client:idle />
    <CustomScrollbar />
    <script>
      import '../assets/js/swup-widgets';
    </script>
    <script>
      import '../assets/js/posts-shell';
    </script>
    <script>
      import '../assets/js/image-fallback';
    </script>
    <script>
      import '../assets/js/lightbox';
    </script>
    <script>
      import '../assets/js/shell-guard';
    </script>
    <!-- data-swup-ignore-script：@swup/scripts-plugin（@swup/astro 默认启用）每次切页
      （content:replace）会重跑全 document 的脚本——切到列表页时本脚本会强制把浮层
      opacity 写 1，搜索框先直接出现在终位，入场动画起播时再渐隐+右移+滑回（表现为
      「移两次 / 闪一下」，见 TROUBLESHOOTING 52）。本脚本只服务整页首帧，切页由
      posts-shell.ts 全权负责 -->
    <script is:inline data-swup-ignore-script>
      // 搜索框首帧可见：浮层叠放位置平时由 posts-shell.ts（JS 包加载后）计算写入，此前
      // 被 CSS opacity: 0 隐着——慢网下搜索框要等 JS 包加载完才出现（观感像延迟水合）。
      // 本脚本随文档执行（无网络依赖），在首帧绘制前按页头占位符计算叠放并显出搜索框；
      // posts-shell.ts 加载后重测接管（值一致，无跳变）。仅列表页有占位符，其余页面跳过。
      // 带 data-swup-ignore-script：swup 切页不重跑（重跑会抢在转场编排前显出搜索框）。
      (function () {
        const ph = document.querySelector('.page-main .posts-header-search');
        if (!ph) return;
        const row = ph.closest('.page-main');
        const f = row ? row.querySelector('.posts-search-float') : null;
        if (!f) return;
        const r = row.getBoundingClientRect();
        const slot = ph.closest('.posts-edge-slot');
        if (slot) {
          const s = slot.getBoundingClientRect();
          f.style.top = s.top - r.top + ph.offsetTop + 'px';
          f.style.left = s.left - r.left + ph.offsetLeft + 'px';
        } else {
          const a = ph.getBoundingClientRect();
          f.style.top = a.top - r.top + 'px';
          f.style.left = a.left - r.left + 'px';
        }
        f.style.width = ph.offsetWidth + 'px';
        f.style.opacity = '1';
        f.style.visibility = 'visible';
      })();
    </script>
    <script is:inline>
      // 首载 loading 屏：等页面资源（window load：CSS 背景图、首屏图片、脚本包）就绪才揭幕，
      // 揭开后第一帧就是加载完整的页面；最少展示 500ms 防快网闪屏。
      // 6s 超时兜底：个别资源卡死时遮罩不永久盖住页面。
      // load 后再等一帧 rAF：揭幕画在已绘制的一帧上，不揭开到未绘制的帧。
      // 背景图用 Image 预热：同一 URL 走缓存，加 .is-ready 时图已就位，不闪。
      (function () {
        const splash = document.getElementById('boot-splash');
        if (!splash) return;
        const started = performance.now();
        let finished = false;
        const fade = () => {
          if (finished) return;
          finished = true;
          const minShown = 500; // 快网下防闪：至少展示 500ms
          setTimeout(
            () => {
              splash.classList.add('is-done');
              setTimeout(() => splash.remove(), 800);
            },
            Math.max(0, minShown - (performance.now() - started)),
          );
        };
        const bgEl = document.querySelector('.bg--image');
        const bgUrl = /url\(['"]?([^'")]+)/.exec(
          bgEl ? bgEl.style.getPropertyValue('--bg-image') : '',
        )?.[1];
        if (bgUrl && bgEl) {
          const warm = new Image();
          warm.onload = () => bgEl.classList.add('is-ready');
          warm.src = bgUrl;
        }
        const reveal = () => requestAnimationFrame(fade);
        if (document.readyState === 'complete') {
          reveal();
        } else {
          window.addEventListener('load', reveal, { once: true });
          setTimeout(reveal, 6000); // 兜底：最多遮 6s 也揭幕
        }
      })();
    </script>
  </body>
</html>
