---
// BaseLayout.astro — 全站基础布局（背景 / 导航 / 页脚 / 侧边按钮 / 灯箱等）
// 用法：<BaseLayout title="页面标题">...</BaseLayout>
import '../assets/css/global.css';
import '../assets/css/shared/skeleton.css';
import '../assets/css/posts/image-fallback.css';
import NavBar from '../components/layout/NavBar.astro';
import Background from '../components/layout/Background.astro';
import Footer from '../components/layout/Footer.astro';
import SideWidgets from '../components/layout/SideWidgets.astro';
import TocModal from '../components/posts/TocModal.svelte';
import PostsFilterModal from '../components/posts/PostsFilterModal.svelte';
import CustomScrollbar from '../components/layout/CustomScrollbar.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  /** 隐藏文章：给页面加 noindex，别让搜索引擎把直链页收录出去 */
  noindex?: boolean;
}

const { title, description = site.description, bodyClass = '', noindex = false } = Astro.props;

const pageTitle = title ? `${title} - ${site.name}` : site.name;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/posts/rss.xml" />
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <Background />
    <div class="page">
      <NavBar />
      <main class="hero" id="swup">
        <slot />
      </main>
      <Footer />
    </div>
    <SideWidgets />
    <div id="alula-img-ph-icon" hidden>
      <Icon name="mdi:image-off-outline" />
    </div>
    <TocModal client:idle />
    <PostsFilterModal client:idle />
    <CustomScrollbar />
    <script>
      import '../assets/js/swup-widgets';
    </script>
    <script>
      import '../assets/js/image-fallback';
    </script>
    <script>
      import '../assets/js/lightbox';
    </script>
    <script>
      import '../assets/js/shell-guard';
    </script>
  </body>
</html>
