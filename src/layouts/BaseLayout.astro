---
import { getImage } from "astro:assets";
import bgImageRaw from "../assets/images/bj.jpg";
import avatarRaw from "../assets/images/tx.png";
import "../assets/css/global.css";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";

const bgImage = await getImage({
  src: bgImageRaw,
  format: "webp",
  quality: 80,
  width: 1920,
});

const avatarImage = await getImage({
  src: avatarRaw,
  format: "webp",
  quality: 80,
  width: 192,
});

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "羽毛的小屋",
  description = "羽毛的小屋",
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <style>
      .loading-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgb(0, 0, 0);
        pointer-events: all;
      }
      .loading-overlay.loaded {
        animation: loading-fade-out 0.6s ease-out forwards;
      }
      .loading-spinner {
        display: flex;
        gap: 10px;
      }
      .loading-spinner .dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #fff;
        opacity: 0.4;
        animation: loading-pulse 1.2s ease-in-out infinite;
      }
      .loading-spinner .dot:nth-child(2) { animation-delay: 0.2s; }
      .loading-spinner .dot:nth-child(3) { animation-delay: 0.4s; }
      @keyframes loading-pulse {
        0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
        40% { transform: scale(1); opacity: 1; }
      }
      @keyframes loading-fade-out {
        0% { opacity: 1; }
        100% { opacity: 0; pointer-events: none; }
      }
      @media (max-width: 640px) {
        .loading-spinner .dot { width: 10px; height: 10px; }
      }
    </style>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" as="image" href={bgImage.src} />
    <link rel="icon" type="image/webp" href={avatarImage.src} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body style={`--bg-image: url('${bgImage.src}')`}>
    <div class="loading-overlay" aria-hidden="true">
      <div class="loading-spinner">
        <div class="dot"></div>
        <div class="dot"></div>
        <div class="dot"></div>
      </div>
    </div>
    <script>
      const overlay = document.querySelector(".loading-overlay") as HTMLElement | null;
      const hide = () => {
        overlay?.classList.add("loaded");
        overlay?.addEventListener("animationend", () => {
          overlay.style.display = "none";
        }, { once: true });
      };
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", hide);
      } else {
        hide();
      }
    </script>
    <div class="bg-layer" aria-hidden="true"></div>
    <div class="page">
      <NavBar />
      <main class="hero transition-main" id="swup">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>