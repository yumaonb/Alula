---
import { getImage } from "astro:assets";
import bgImageRaw from "../assets/images/bj.jpg";
import "../assets/css/global.css";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";

const bgImage = await getImage({
  src: bgImageRaw,
  format: "webp",
  quality: 80,
  width: 1920,
});

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "羽毛的小屋",
  description = "羽毛的小屋",
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link slot="head" rel="preload" as="image" href={bgImage.src} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body style={`--bg-image: url('${bgImage.src}')`}>
    <div class="loading-overlay" aria-hidden="true">
      <div class="loading-spinner">
        <div class="dot"></div>
        <div class="dot"></div>
        <div class="dot"></div>
      </div>
    </div>
    <script>
      const overlay = document.querySelector(".loading-overlay");
      const hide = () => overlay?.classList.add("loaded");
      const MIN_WAIT = 800
      const start = Date.now();
      const waitAndHide = () => {
        const elapsed = Date.now() - start;
        elapsed >= MIN_WAIT ? hide() : setTimeout(hide, MIN_WAIT - elapsed);
      };
      if (document.readyState === "complete") waitAndHide();
      else window.addEventListener("load", waitAndHide);
    </script>
    <div class="bg-layer" aria-hidden="true"></div>
    <div class="page">
      <NavBar />
      <main class="hero transition-main" id="swup">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>