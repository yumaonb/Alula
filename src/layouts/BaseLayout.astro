---
import bgImage from "../assets/images/bj.jpg";
import avatarImg from "../assets/images/tx.png";
import "../assets/css/global.css";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "羽毛的小屋",
  description = "羽毛的小屋",
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/png" href={avatarImg.src} />
    <title>{title}</title>
  </head>
  <body style={`--bg-image: url('${bgImage.src}')`}>
    <div class="bg-layer" aria-hidden="true"></div>
    <div class="page">
      <NavBar />
      <main class="hero">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>