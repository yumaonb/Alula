---
import { Image, getImage } from "astro:assets";
import bgImageRaw from "../assets/images/bj.jpg";
import avatarRaw from "../assets/images/tx.png";
import "../assets/css/global.css";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";

const avatarImage = await getImage({
  src: avatarRaw,
  format: "webp",
  quality: 80,
  width: 192,
});

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "羽毛的小屋",
  description = "羽毛的小屋",
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/webp" href={avatarImage.src} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>

    <Image
      src={bgImageRaw}
      alt=""
      class="bg-layer"
      width={1920}
      height={1080}
      loading="eager"
      decoding="async"
      aria-hidden="true"
    />
    <div class="page">
      <NavBar />
      <main class="hero transition-main" id="swup">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>