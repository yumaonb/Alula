---
// BaseLayout.astro — 全站基础布局（背景、导航、页面行、页脚与通用交互）
// 用法：在页面中 import BaseLayout from '../layouts/BaseLayout.astro'。
import { Icon } from 'astro-icon/components';
import { features } from 'virtual:site-features';
import PageRow from 'virtual:features/page-row.astro';
import PageExtras from 'virtual:features/page-extras.astro';

import NavBar from '../components/layout/NavBar.astro';
import Background from '../components/layout/Background.astro';
import PageMeta from '../components/layout/PageMeta.astro';
import Footer from '../components/layout/Footer.astro';
import CustomScrollbar from '../components/layout/CustomScrollbar.astro';
import { site } from '../data/site';

import '../assets/css/global.css';
import '../assets/css/shared/skeleton.css';
import '../assets/css/shared/image-fallback.css';

interface Props {
  title?: string;
  description?: string;
  /** 隐藏文章：给页面加 noindex，别让搜索引擎把直链页收录出去 */
  noindex?: boolean;
  /** 主内容行变体：plain 普通页 / listing 列表·分类·标签页 / post 文章详情页（PostsShell 传入） */
  shellVariant?: 'plain' | 'listing' | 'post';
  /** 对外分享卡配图（文章详情页传封面）；不传就用站点方图 */
  image?: string;
  /** 分享卡类型：文章详情页传 article */
  ogType?: 'website' | 'article';
  /** 文章发布时间（ISO 串），只有 ogType=article 时进分享卡 */
  publishedTime?: string;
}

const {
  title,
  description,
  noindex = false,
  shellVariant = 'plain',
  image,
  ogType = 'website',
  publishedTime,
} = Astro.props;

// 解构默认值只对 undefined 生效，文章缺 description 时传下来的是空串——
// 那样会产出空的 meta description（比不写还差）。空串一并回落到站点描述。
const pageDescription = description || site.description;

const pageTitle = title ? `${title} - ${site.name}` : site.name;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <!-- 标记 JS 可用：首载 loading 屏只在 html 带 js 类时显示（无 JS 不显示，避免整屏永久盖住页面） -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={`${site.url}${Astro.url.pathname}`} />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    {features.pages.posts && features.endpoints.postsRss && (
      <link rel="alternate" type="application/rss+xml" title={site.name} href="/posts/rss.xml" />
    )}
    <title>{pageTitle}</title>
    <PageMeta
      title={pageTitle}
      description={pageDescription}
      image={image}
      type={ogType}
      publishedTime={publishedTime}
    />
    <slot name="head" />
    <!-- 首载 loading 屏样式：必须 is:inline（留在 head 内联，不打包进外链 CSS）。
         首帧只靠这段样式自足：颜色不引用 variables.css 令牌，
         唯一例外是 --bg-base——CSS 背景预设时取预设底色保持衔接，图片预设不定义它则退回深色兜底。 -->
    <style is:inline>
      #boot-splash {
        display: none;
      }
      html.js #boot-splash {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        background:
          radial-gradient(134% 112% at 50% 44%, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 0.5) 100%),
          var(--bg-base, #000);
        transition: opacity 0.5s ease;
      }
      html.js #boot-splash.is-done {
        opacity: 0;
        pointer-events: none;
      }
      .boot-splash-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        animation: boot-splash-in 0.6s ease both;
      }
      .boot-splash-name {
        color: rgba(255, 255, 255, 0.92);
        font-size: 20px;
        letter-spacing: 0.2em;
        text-indent: 0.2em;
      }
      .boot-splash-bar {
        position: relative;
        width: 120px;
        height: 2px;
        border-radius: 999px;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.1);
      }
      .boot-splash-bar-fill {
        position: absolute;
        inset: 0;
        border-radius: inherit;
        transform: scaleX(0);
        transform-origin: left center;
        background: linear-gradient(90deg, rgba(255, 255, 255, 0.25), rgba(255, 255, 255, 0.85));
      }
      @keyframes boot-splash-in {
        from {
          opacity: 0;
          transform: translateY(6px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        html.js #boot-splash .boot-splash-inner {
          animation: none;
        }
      }
    </style>
  </head>
  <body>
    <!-- 首载 loading 屏：body 第一个元素 + head 内联样式，不依赖任何外部资源即可画出；
         只在首次加载显示（swup 切页不重建 body 壳），页面就绪后进度条走完再 0.5s 渐隐并移除节点 -->
    <div class="boot-splash" id="boot-splash" aria-hidden="true">
      <div class="boot-splash-inner">
        <span class="boot-splash-name">{site.name}</span>
        <span class="boot-splash-bar">
          <span class="boot-splash-bar-fill"></span>
        </span>
      </div>
    </div>
    <Background />
    <div class="page">
      <NavBar />
      <PageRow shellVariant={shellVariant}>
        <slot />
      </PageRow>
      <Footer />
    </div>
    <PageExtras />
    <!-- 图片占位图标模板：id 与 ui/image-fallback.ts 的 ICON_TEMPLATE_ID 一致，改 id 两处同改 -->
    <div id="alula-img-ph-icon" hidden>
      <Icon is:inline name="mdi:image-off-outline" />
    </div>
    <CustomScrollbar />
    <script>
      import 'virtual:features/image-fallback';
    </script>
    <script>
      import '../assets/js/nav/shell-guard';
    </script>
    <script is:inline>
      // 等资源就绪后揭幕，最少显示 200ms、最多等待 5s；进度从首个可见帧起算。
      // 隐藏标签页用计时器补足不执行的动画帧，背景预热完成后显出。
      (function () {
        const splash = document.getElementById('boot-splash');
        if (!splash) return;
        const fillEl = splash.querySelector('.boot-splash-bar-fill');
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const started = performance.now();
        let shownAt = -1;
        let finished = false;
        let rafId = 0;
        const tick = (now) => {
          if (finished) return;
          if (shownAt < 0) shownAt = now;
          const p = 0.9 * (1 - Math.exp(-(now - shownAt) / 1200));
          if (fillEl) fillEl.style.transform = 'scaleX(' + p + ')';
          if (!finished) rafId = requestAnimationFrame(tick);
        };
        if (fillEl && !reduced) rafId = requestAnimationFrame(tick);
        const fade = () => {
          if (finished) return;
          finished = true;
          if (rafId) {
            cancelAnimationFrame(rafId);
            rafId = 0;
          }
          const minShown = 200;
          const visibleFor = performance.now() - (shownAt > 0 ? shownAt : started);
          const minDelay = Math.max(0, minShown - visibleFor);
          const fillTime = fillEl && !reduced ? 500 : 0;
          setTimeout(() => {
            if (fillEl && !reduced) {
              // 当前值可能远小于 1，直接赋值会一帧跳满，走 transition 滑满
              fillEl.style.transition = 'transform 0.5s ease';
              fillEl.style.transform = 'scaleX(1)';
            }
            setTimeout(() => {
              splash.classList.add('is-done');
              setTimeout(() => splash.remove(), 800);
            }, fillTime);
          }, minDelay);
        };
        const bgEl = document.querySelector('.bg--image');
        const bgUrl = /url\(['"]?([^'")]+)/.exec(
          bgEl ? bgEl.style.getPropertyValue('--bg-image') : '',
        )?.[1];
        if (bgUrl && bgEl) {
          const warm = new Image();
          warm.onload = () => bgEl.classList.add('is-ready');
          warm.src = bgUrl;
        }
        const reveal = () => {
          requestAnimationFrame(fade);
          // 隐藏标签页不执行动画帧；完成标记保证兜底不会重复揭幕。
          if (document.visibilityState === 'hidden') setTimeout(fade, 200);
        };
        if (document.readyState === 'complete') {
          reveal();
        } else {
          window.addEventListener('load', reveal, { once: true });
          // 兜底：最多遮 5s 也揭幕
          setTimeout(reveal, 5000);
        }
      })();
    </script>
  </body>
</html>
