---
// PostsLayout.astro — 文章页面布局
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/posts/TableOfContents.astro';
import Breadcrumb from '../components/posts/Breadcrumb.astro';
import '../assets/css/markdown.css';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface BreadcrumbItem {
  label: string;
  href?: string;
  icon?: string;
}

interface Props {
  title: string;
  description?: string;
  headings: Heading[];
  breadcrumbs: BreadcrumbItem[];
}

const { title, description, headings, breadcrumbs } = Astro.props;
const hasToc = headings && headings.length > 0;
---

<BaseLayout title={title} description={description}>
  <div class="post-page page-container">
    <div class="post-layout">
      <div class="post-main">
        <div class="breadcrumb-wrap">
          <Breadcrumb items={breadcrumbs} />
        </div>
        <article class="post-content glass glass-tall">
          <div class="post-content-inner">
            <slot />
          </div>
        </article>
        <slot name="postnav" />
        <slot name="comments" />
      </div>
      {hasToc && (
        <aside class="post-sidebar">
          <TableOfContents headings={headings} />
        </aside>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .post-page {
    max-width: 1300px;
    min-width: 0;
  }

  .post-layout {
    display: flex;
    gap: 32px;
    align-items: flex-start;
  }

  .post-main {
    flex: 1;
    min-width: 0;
  }

  .breadcrumb-wrap {
    margin-bottom: 14px;
  }

  .post-content {
    border-radius: var(--radius);
  }

  /* 内边距放在内部包裹层：.glass-tall 的模糊伪元素只铺满容器内容盒 */
  .post-content-inner {
    padding: 36px 40px;
  }

  .post-sidebar {
    width: 240px;
    flex-shrink: 0;
    position: sticky;
    top: 88px;
    /* max-height: calc(100vh - 88px - 60px - 35px); */
    overflow-y: auto;
    scrollbar-width: thin;
  }

  @media (max-width: 768px) {
    .post-layout {
      display: block;
    }

    .post-sidebar {
      display: none;
    }

    .post-content {
      border-radius: 0;
    }

    .post-content-inner {
      padding: 16px;
    }
  }
</style>