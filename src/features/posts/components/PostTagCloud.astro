---
// PostTagCloud.astro — 标签云面板（点击跳转到标签页）
// 用法：<PostTagCloud tags={data.tags} tagUrl={...} activeTag={...} />
import { Icon } from 'astro-icon/components';

interface Props {
  tags: { name: string }[];
  /** 生成标签链接的函数，如 (name) => `/posts/tag/${name}/` */
  tagUrl: (name: string) => string;
  /** 当前所在标签（高亮用，可选） */
  activeTag?: string;
}

const { tags, tagUrl, activeTag = '' } = Astro.props;
---

<section class="tag-panel glass">
  <h2 class="tag-panel-title panel-title">
    <Icon is:inline name="la:tags" class="tag-panel-icon" />
    标签
  </h2>
  <div class="tag-panel-body">
    {tags.map((tag) => (
      <a
        href={tagUrl(tag.name)}
        class:list={['chip', 'hoverable', 'link-plain', { 'chip--active': tag.name === activeTag }]}
      >
        {tag.name}
      </a>
    ))}
  </div>
</section>

<style>
  .tag-panel {
    padding: 16px;
    border-radius: var(--radius);
  }

  /* 面板标题排布走全站 .panel-title，这里只留本面板的字号与间距 */
  .tag-panel-title {
    font-size: 0.72rem;
    margin-bottom: 10px;
    padding-left: 4px;
  }

  .tag-panel-icon {
    width: 12px;
    height: 12px;
    color: var(--ink);
  }

  .tag-panel-body {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
</style>
