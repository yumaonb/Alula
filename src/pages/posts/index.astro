---
// index.astro — 文章列表首页
import BaseLayout from '../../layouts/BaseLayout.astro';
import GlobalSidebar from '../../components/posts/GlobalSidebar.astro';
import PostCard from '../../components/posts/PostCard.astro';
import PostSearch from '../../components/posts/PostSearch.svelte';
import { loadBlogData } from '../../lib/posts-data';
import '../../assets/css/posts-listing.css';

const data = await loadBlogData();
---

<BaseLayout title="文章列表">
  <div class="posts-page page-container">
    <div class="posts-header">
      <h1 class="posts-title section-title">
        文章列表<span class="title-count-sep"> — </span>
        <span class="posts-count">共 {data.posts.length} 篇文章</span>
      </h1>
      <div class="posts-header-search">
        <PostSearch placeholder="搜索文章…" client:load />
      </div>
    </div>

    <div class="posts-with-sidebar">
      <GlobalSidebar tree={data.categoryTree} tags={data.tags} />
      <div class="posts-content">
        <div class="posts-grid">
          {data.posts.map((post) => (
            <div class="post-card-slot">
              <PostCard
                title={post.title}
                date={post.date}
                description={post.description}
                image={post.image || undefined}
                basePath={post.basePath}
                tags={post.tags}
                pinned={post.pinned}
                url={post.url}
                categoryTrail={post.categoryTrail}
                commentCount={post.commentCount}
                words={post.words}
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
