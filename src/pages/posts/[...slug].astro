---
// [...slug].astro — 文章详情页 & 分类列表页（基于 astro:content 集合）
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostsLayout from '../../layouts/PostsLayout.astro';
import GlobalSidebar from '../../components/posts/GlobalSidebar.astro';
import PostCard from '../../components/posts/PostCard.astro';
import Repost from '../../components/posts/Repost.astro';
import PostNav from '../../components/posts/PostNav.astro';
import Comments from '../../components/widgets/Comments.astro';
import PostSearch from '../../components/posts/PostSearch.svelte';
import ImageWrapper from '../../components/posts/ImageWrapper.astro';
import { Icon } from 'astro-icon/components';
import { loadBlogData, renderPost, postBreadcrumbs } from '../../lib/posts-data';
import { postRoute, buildCategoryUrl, postMatchesCategory } from '../../lib/category';
import '../../assets/css/markdown.css';
import '../../assets/css/posts-listing.css';

const data = await loadBlogData();

export async function getStaticPaths() {
  const d = await loadBlogData();
  const routes: { params: { slug: string }; props: { type: 'post' | 'category'; slug?: string; category?: string } }[] = [];
  const seen = new Set<string>();

  // 文章路由：posts 集合的每个条目
  for (const p of d.posts) {
    seen.add(p.slug);
    routes.push({ params: { slug: p.slug }, props: { type: 'post', slug: p.slug } });
  }

  // 分类路由：分类目录（index.json）+ 每篇文章所在目录的祖先目录
  const addCategory = (path: string) => {
    if (!path || seen.has(path)) return;
    seen.add(path);
    routes.push({ params: { slug: path }, props: { type: 'category', category: path } });
  };

  for (const key of Object.keys(d.meta)) addCategory(key);
  for (const p of d.posts) {
    const parts = p.category.split('/').filter(Boolean);
    for (let i = 1; i <= parts.length; i++) addCategory(parts.slice(0, i).join('/'));
  }

  return routes;
}

const { type } = Astro.props;

// ---- 文章页数据 ----
let post = undefined as (typeof data.posts)[number] | undefined;
let entry = undefined as (typeof data.entries)[number] | undefined;
let PostContent: any = undefined;
let headings: { depth: number; slug: string; text: string }[] = [];
let prevPost: { title: string; url: string } | null = null;
let nextPost: { title: string; url: string } | null = null;

if (type === 'post') {
  const slug = Astro.props.slug as string;
  post = data.posts.find((p) => p.slug === slug);
  entry = data.entries.find((e) => e.id === slug);

  if (post && entry) {
    const rendered = await renderPost(entry);
    PostContent = rendered.Content;
    headings = rendered.headings.filter((h) => h.depth >= 1 && h.depth <= 3);

    const idx = data.posts.findIndex((p) => p.slug === slug);
    if (idx > 0) prevPost = { title: data.posts[idx - 1].title, url: data.posts[idx - 1].url };
    if (idx >= 0 && idx < data.posts.length - 1) nextPost = { title: data.posts[idx + 1].title, url: data.posts[idx + 1].url };
  }
}

// ---- 分类页数据 ----
let catPath: string[] = [];
let catName = '';
let catPosts = [] as typeof data.posts;

if (type === 'category') {
  catPath = (Astro.props.category as string).split('/');
  const metaKey = catPath.join('/');
  const meta = data.meta[metaKey];
  catName = meta?.name || catPath[catPath.length - 1] || metaKey;
  catPosts = data.posts.filter((p) => postMatchesCategory(p, metaKey));
}
---

{type === 'category' && (
  <BaseLayout title={`${catName} - 文章分类`}>
    <div class="category-page page-container">
      <div class="category-header">
        <h1 class="category-title section-title">
          {catName}<span class="title-count-sep"> — </span><span class="posts-count">共 {catPosts.length} 篇文章</span>
        </h1>
        <div class="category-header-search">
          <PostSearch
            placeholder={`在「${catName}」中搜索…`}
            categoryPath={buildCategoryUrl(catPath, postRoute)}
            client:load
          />
        </div>
      </div>

      <div class="posts-with-sidebar">
        <GlobalSidebar tree={data.categoryTree} tags={data.tags} />
        <div class="posts-content">
          <div class="posts-grid">
            {catPosts.map((p) => (
              <div class="post-card-slot">
                <PostCard
                  title={p.title}
                  date={p.date}
                  description={p.description}
                  image={p.image || undefined}
                  basePath={p.basePath}
                  tags={p.tags}
                  pinned={p.pinned}
                  url={p.url}
                  categoryTrail={p.categoryTrail}
                  commentCount={p.commentCount}
                  words={p.words}
                />
              </div>
            ))}
          </div>
          {catPosts.length === 0 && <div class="posts-empty glass"><p>该分类下暂无文章</p></div>}
        </div>
      </div>
    </div>
  </BaseLayout>
)}

{type === 'post' && post && entry && PostContent && (
  <PostsLayout
    title={post.title}
    description={post.description}
    headings={headings}
    breadcrumbs={postBreadcrumbs(post, data.meta)}
    categoryTree={data.categoryTree}
    sidebarTags={data.tags}
  >
    <header class="post-header">
      <h1 class="post-title">
        {post.pinned && <span class="post-title-pin"><Icon name="la:thumbtack" class="pin-icon" /></span>}
        {post.title}
      </h1>
      <div class="post-meta">
        {post.date && (
          <span class="post-meta-item">
            <Icon name="la:calendar" class="meta-icon" />
            <time datetime={post.date}>{post.date}</time>
          </span>
        )}
        {post.category && (
          <span class="post-meta-item">
            <Icon name="la:layer-group" class="meta-icon" />
            <a href={buildCategoryUrl(post.category.split('/'), postRoute)} class="post-meta-link">{post.categoryTrail[post.categoryTrail.length - 1].name}</a>
          </span>
        )}
        {post.tags.length > 0 && (
          <span class="post-meta-item">
            <Icon name="la:tag" class="meta-icon" />
            {post.tags.map((tag, i) => (
              <span>
                <a href={`/${postRoute}/tag/${encodeURIComponent(tag)}/`} class="post-meta-link">{tag}</a>
                {i < post.tags.length - 1 && <span class="meta-sep">/</span>}
              </span>
            ))}
          </span>
        )}
      </div>
      {post.image && (
        <div class="post-cover">
          <span class="cover-ph-icon" aria-hidden="true"><Icon name="mdi:image-outline" /></span>
          <ImageWrapper src={post.image} basePath={post.basePath} alt={post.title} class="w-full" style="width: 100%; height: auto; display: block;" sizes="(max-width: 768px) 100vw, 920px" widths={[1280, 1920]} />
        </div>
      )}
    </header>
    <div class="markdown-body">
      <PostContent />
    </div>
    <Repost title={post.title} date={post.date} />
    <PostNav slot="postnav" prev={prevPost} next={nextPost} />
    <Comments slot="comments" />
  </PostsLayout>
)}

<style>
  /* 分类页空态（复用列表共享样式，仅此页保留） */
  .posts-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
    padding: 60px 20px;
    color: rgba(255, 255, 255, 0.45);
    border-radius: var(--radius);
  }

  /* ---- 文章详情页样式 ---- */
  .post-header { margin-bottom: 24px; }
  .post-title { font-size: 2rem; font-weight: 800; color: #fff; line-height: 1.3; margin: 0 0 12px 0; display: flex; align-items: center; gap: 8px; }
  .post-title-pin { display: inline-flex; flex-shrink: 0; }
  .post-title-pin .pin-icon { width: 22px; height: 22px; }
  .post-meta { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-bottom: 12px; }
  .post-meta-item { display: inline-flex; align-items: center; gap: 5px; font-size: 0.85rem; color: rgba(255, 255, 255, 0.5); }
  .meta-icon { width: 15px; height: 15px; opacity: 0.6; flex-shrink: 0; position: relative; top: -1px; }
  .post-meta-link { color: rgba(255, 255, 255, 0.65); text-decoration: none; transition: color 0.2s; }
  .post-meta-link::before { display: none; }
  .post-meta-link:hover { color: #fff; }
  .meta-sep { margin: 0 2px; color: rgba(255, 255, 255, 0.3); }
  .post-cover { margin-top: 20px; border-radius: 8px; overflow: hidden; }
  .post-cover img { width: 100%; height: auto; display: block; }

  @media (max-width: 768px) {
    .post-title { font-size: 1.5rem; }
  }
</style>
