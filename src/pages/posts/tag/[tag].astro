---
// [tag].astro — 标签文章列表页
// 用法：路由 /posts/tag/<tag>/
import PostsShell from '../../../layouts/PostsShell.astro';
import PostSearch from '../../../components/posts/PostSearch.svelte';
import { loadBlogData } from '../../../lib/posts-data';

const data = await loadBlogData();

export async function getStaticPaths() {
  const d = await loadBlogData();
  return d.tags.map((t) => ({ params: { tag: t.name }, props: { tag: t.name } }));
}

const { tag } = Astro.props;
const posts = data.posts.filter((post) => post.tags.includes(tag));
---

<PostsShell
  title={`${tag} - 文章标签`}
  variant="listing"
  heading={`#${tag}`}
  count={posts.length}
  posts={posts}
>
  <PostSearch slot="search" client:load />
</PostsShell>
