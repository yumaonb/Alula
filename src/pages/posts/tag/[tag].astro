---
// [tag].astro — 标签文章列表页
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GlobalSidebar from '../../../components/posts/GlobalSidebar.astro';
import PostCard from '../../../components/posts/PostCard.astro';
import PostSearch from '../../../components/posts/PostSearch.svelte';
import { loadBlogData } from '../../../lib/posts-data';
import '../../../assets/css/posts-listing.css';

const data = await loadBlogData();

export async function getStaticPaths() {
  const d = await loadBlogData();
  return d.tags.map((t) => ({ params: { tag: t.name }, props: { tag: t.name } }));
}

const { tag } = Astro.props;
const posts = data.posts.filter((post) => post.tags.includes(tag));
---

<BaseLayout title={`${tag} - 文章标签`}>
  <div class="category-page page-container">
    <div class="category-header">
      <h1 class="category-title section-title">
        #{tag}
        <span class="title-count-sep"> — </span>
        <span class="posts-count">共 {posts.length} 篇文章</span>
      </h1>
      <div class="category-header-search">
        <PostSearch
          placeholder={`在「${tag}」标签中搜索…`}
          filterUrls={posts.map((p) => p.url)}
          client:load
        />
      </div>
    </div>

    <div class="posts-with-sidebar">
      <GlobalSidebar tree={data.categoryTree} tags={data.tags} activeTag={tag} />
      <div class="posts-content">
        <div class="posts-grid">
          {posts.map((post) => (
            <div class="post-card-slot">
              <PostCard
                title={post.title}
                date={post.date}
                description={post.description}
                image={post.image || undefined}
                basePath={post.basePath}
                tags={post.tags}
                pinned={post.pinned}
                url={post.url}
                categoryTrail={post.categoryTrail}
                commentCount={post.commentCount}
                words={post.words}
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
