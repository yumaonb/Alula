---
// projects.astro — 项目展示页
// 用法：路由 /projects/
import { Icon } from 'astro-icon/components';
import { navItem } from '../data/nav';

import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectsGrid from '../components/widgets/ProjectsGrid.svelte';

// 页头标题图标与导航同源（src/data/nav.ts），页面不写死自己的路径
const pageNav = navItem('projects');
---

<BaseLayout title="项目">
  <div class="projects-page page-top-standard">
    <div class="page-head">
      <h1 class="page-title">
        <Icon is:inline name={pageNav.icon} class="page-title-icon" />
        我的项目
      </h1>
    </div>

    <ProjectsGrid client:load />
  </div>
</BaseLayout>

<style>
  /* ---- 页面 ----（width: 100% 必须有，原因见 about 页注释；横向顶满内容列，同文章区）
     标题区用全站页面标题：.page-head / .page-title / .page-title-icon / .page-top-standard（见 utilities.css） */
  .projects-page {
    width: 100%;
  }
</style>
