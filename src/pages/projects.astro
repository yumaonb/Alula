---
// projects.astro — 项目展示页
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectsGrid from '../components/widgets/ProjectsGrid.svelte';
---

<BaseLayout title="项目">
  <div class="projects-page page-container">
    <div class="page-header">
      <h1 class="page-title">我的项目</h1>
      <p class="page-desc">这里是我的一些开源项目，欢迎Star或Fork</p>
    </div>

    <ProjectsGrid client:load />
  </div>
</BaseLayout>

<style>
  /* ---- 页面 ---- */
  .projects-page {
    max-width: 960px;
  }

  /* ---- 标题区 ---- */
  .page-header {
    text-align: center;
    margin-bottom: 40px;
  }

  /* 页头标题 / 描述的内容排版（原全站公共类，按「元件才算公共」收回到本页） */
  .page-title {
    font-size: 2rem;
    color: var(--hover-ink);
    text-shadow: var(--title-shadow);
    gap: 10px;
  }

  .page-desc {
    font-size: 0.95rem;
    color: var(--color-text);
  }

  /* ---- 手机端适配 ---- */
  @media (max-width: 768px) {
    .page-title {
      font-size: 1.5rem;
    }
  }
</style>
