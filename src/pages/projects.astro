---
// projects.astro — 项目展示页
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectsGrid from '../components/widgets/ProjectsGrid.vue';
---

<BaseLayout title="项目 - 羽毛的小屋">
  <div class="projects-page">
    <!-- 页面标题 -->
    <div class="page-header">
      <h1 class="page-title">我的项目</h1>
      <p class="page-desc">这里是我的一些开源项目，欢迎Star或Fork</p>
    </div>

    <!-- 项目卡片 -->
    <ProjectsGrid client:visible />
  </div>
</BaseLayout>

<style>
  /* ===== 页面 ===== */
  .projects-page {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* 标题区 */
  .page-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .page-title {
    font-size: 2rem;
    color: #fff;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 0 0 8px;
  }

  .page-desc {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
  }

  /* ===== 手机端适配 ===== */
  @media (max-width: 768px) {
    .projects-page {
      padding: 0 16px;
    }

    .page-title {
      font-size: 1.5rem;
    }
  }
</style>