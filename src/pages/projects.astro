---
// projects.astro — 项目展示页
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectsGrid from '../components/widgets/ProjectsGrid.svelte';
---

<BaseLayout title="项目">
  <div class="projects-page page-container">
    <!-- 页面标题 -->
    <div class="page-header">
      <h1 class="page-title section-title">我的项目</h1>
      <p class="page-desc section-desc">这里是我的一些开源项目，欢迎Star或Fork</p>
    </div>

    <!-- 项目卡片 -->
    <ProjectsGrid client:visible />
  </div>
</BaseLayout>

<style>
  /* ===== 页面 ===== */
  .projects-page {
    max-width: 960px;
  }

  /* 标题区 */
  .page-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .page-title {
    gap: 10px;
  }

  /* ===== 手机端适配 ===== */
  @media (max-width: 768px) {
    .page-title {
      font-size: 1.5rem;
    }
  }
</style>