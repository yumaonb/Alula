---
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/widgets/Timeline.astro';
import SkillsBar from '../components/widgets/SkillsBar.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import avatarImg from '../assets/images/tx.png';

const nickname = '羽毛';
const motto = '阅己 越己 悦己';
const bio = '热爱探索的学生，正在全栈开发的路上持续奔跑。喜欢用代码创造有趣的东西，也喜欢折腾各种新技术。';

const socialLinks = [
  { icon: 'la:github', label: 'GitHub', url: 'https://github.com/yumaonb' },
  { icon: 'simple-icons:bilibili', label: 'Bilibili', url: 'https://b23.tv/XFTBHN3' },
  { icon: 'la:envelope', label: '邮箱', url: 'mailto:hbnl555@qq.com' },
];
---

<BaseLayout title="关于 - 羽毛的小屋" description="关于羽毛的个人介绍、技术栈、学习历程">
  <div class="about-page">

    {/* ========== 顶部 Hero ========== */}
    <section class="about-hero">
      <div class="hero-avatar-ring">
        <Image src={avatarImg} alt="羽毛" class="hero-avatar" width={140} height={140} loading="eager" />
      </div>
      <h1 class="hero-name">{nickname}</h1>
      <p class="hero-motto">{motto}</p>
      <p class="hero-bio">{bio}</p>

      <div class="hero-social">
        {socialLinks.map((link) => (
          <a href={link.url} class="glass-btn" title={link.label} target="_blank" rel="noopener">
            <Icon name={link.icon} class="btn-icon" />
          </a>
        ))}
      </div>
    </section>

    {/* ========== 技能栈 ========== */}
    <section class="about-section">
      <h2 class="section-title">
        <Icon name="la:tools" class="section-icon" />
        技能栈
      </h2>
      <SkillsBar />
    </section>

    {/* ========== 学习历程 ========== */}
    <section class="about-section">
      <h2 class="section-title">
        <Icon name="la:history" class="section-icon" />
        我的历程
      </h2>
      <Timeline />
    </section>

  </div>
</BaseLayout>

<style>
  .about-page {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    padding: 0 24px 60px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  /* ===== Hero ===== */
  .about-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
    padding-top: 24px;
  }

  .hero-avatar-ring {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    padding: 3px;
    background: linear-gradient(135deg, rgba(255,255,255,0.7), rgba(255,255,255,0.9));
    box-shadow: 0 0 24px rgba(255, 255, 255, 0.3);
    animation: avatar-glow 4s ease-in-out infinite alternate;
  }

  @keyframes avatar-glow {
    from { box-shadow: 0 0 20px rgba(255, 255, 255, 0.2); }
    to   { box-shadow: 0 0 40px rgba(255, 255, 255, 0.5); }
  }

  .hero-avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .hero-name {
    font-size: 2.2rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.04em;
    margin: 0;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
  }

  .hero-motto {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.3em;
    margin: 0;
  }

  .hero-bio {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.7;
    max-width: 520px;
    margin: 4px 0 8px;
  }

  .hero-social {
    display: flex;
    gap: 16px;
    margin-top: 4px;
  }

  /* ===== Section 标题 ===== */
  .section-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.3rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 24px;
  }

  .section-icon {
    width: 22px;
    height: 22px;
    color: rgba(255, 255, 255, 0.5);
  }

  /* ===== 移动端适配 ===== */
  @media (max-width: 640px) {
    .about-page {
      gap: 36px;
      padding: 0 16px 40px;
    }

    .hero-avatar-ring {
      width: 110px;
      height: 110px;
    }

    .hero-name {
      font-size: 1.7rem;
    }

    .hero-bio {
      font-size: 0.88rem;
    }

    .section-title {
      font-size: 1.15rem;
    }
  }
</style>