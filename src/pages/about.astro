---
// about.astro — 关于页面
import BaseLayout from '../layouts/BaseLayout.astro';
import DaysCounter from '../components/widgets/DaysCounter.vue';
import TechStack from '../components/widgets/TechStack.astro';
import { Image } from 'astro:assets';
import avatarImg from '../assets/images/avatar.png';
import { Content } from '../content/about.md';
import { nickname, motto } from '../data/profile';
import Markdown from '../components/layout/Markdown.astro';
---

<BaseLayout title="关于 - 羽毛的小屋">
  <div class="about-page page-container">

    <!-- ========== 个人介绍区 ========== -->
    <section class="intro-section">
      <div class="intro-header glass">
        <div class="avatar-ring">
          <Image src={avatarImg} alt="头像" class="avatar-img" width={100} height={100} loading="eager" />
        </div>
        <div class="intro-info">
          <h1 class="intro-name section-title">{nickname}</h1>
          <p class="intro-motto text-motto">{motto}</p>
        </div>
      </div>
      <DaysCounter client:visible />
      <TechStack />
      <div class="intro-text glass">
        <Markdown>
          <Content />
        </Markdown>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .about-page {
    min-width: 0;
    max-width: 800px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* ========== 个人介绍区 ========== */
  .intro-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .intro-header {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 28px 36px;
    border-radius: var(--radius);
    width: 100%;
  }

  .intro-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .intro-text {
    width: 100%;
    padding: 24px 28px;
    border-radius: var(--radius);
  }

  /* ========== 手机端适配 ========== */
  @media (max-width: 768px) {
    .about-page {
      gap: 28px;
    }

    .intro-header {
      padding: 24px 20px;
    }

    .avatar-ring {
      --avatar-size: 80px;
    }

    .intro-name {
      font-size: 1.4rem;
    }

    .intro-motto {
      font-size: 0.75rem;
    }
  }
</style>