---
// about.astro — 关于页面（介绍 / 数据统计 / 技术栈 / 自我介绍）
import BaseLayout from '../layouts/BaseLayout.astro';
import DaysCounter from '../components/widgets/DaysCounter.svelte';
import TechStack from '../components/widgets/TechStack.astro';
import { Image } from 'astro:assets';
import avatarImg from '../assets/images/avatar.png';
import { Content } from '../content/about.md';
import { nickname, motto } from '../data/profile';
import Markdown from '../components/layout/Markdown.astro';
---

<BaseLayout title="关于">
  <div class="about-page page-container">
    <!-- ---- 个人介绍区 ---- -->
    <section class="intro-section">
      <div class="intro-header glass">
        <div class="avatar-ring">
          <Image
            src={avatarImg}
            alt="头像"
            class="avatar-img"
            width={100}
            height={100}
            loading="eager"
          />
        </div>
        <div class="intro-info">
          <h1 class="intro-name">{nickname}</h1>
          <p class="intro-motto">{motto}</p>
        </div>
      </div>
      <DaysCounter client:load />
      <TechStack />
      <div class="intro-text glass">
        <Markdown>
          <Content />
        </Markdown>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-page {
    min-width: 0;
    max-width: 800px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* ---- 个人介绍区 ---- */
  .intro-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .intro-header {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 28px 36px;
    border-radius: var(--radius);
    width: 100%;
  }

  .intro-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .intro-text {
    width: 100%;
    padding: 24px 28px;
    border-radius: var(--radius);
  }

  /* 页头标题 / 座右铭的内容排版（原全站公共类，按「元件才算公共」收回到本页） */
  .intro-name {
    font-size: 2rem;
    color: var(--hover-ink);
    text-shadow: var(--title-shadow);
  }

  .intro-motto {
    font-size: 0.9rem;
    color: var(--color-text);
    letter-spacing: 0.25em;
  }

  /* 头像元件（白环 + 圆形裁切，尺寸由 --avatar-size 控制）：本页个人头像用 */
  .avatar-ring {
    --avatar-size: 100px;
    width: var(--avatar-size);
    height: var(--avatar-size);
    border-radius: 50%;
    padding: 2px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 0 12px rgba(255, 255, 255, 0.25);
    flex-shrink: 0;
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  /* ---- 手机端适配 ---- */
  @media (max-width: 768px) {
    .about-page {
      gap: 28px;
    }

    .intro-header {
      padding: 24px 20px;
    }

    .avatar-ring {
      --avatar-size: 80px;
    }

    .intro-name {
      font-size: 1.4rem;
    }

    .intro-motto {
      font-size: 0.75rem;
    }
  }
</style>
