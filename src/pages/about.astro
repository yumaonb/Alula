---
// about.astro — 关于页面（个人名片 / 数据统计 / 技术栈 / 自述 / 成长历程）
// 用法：路由 /about/
import { Image } from 'astro:assets';

import BaseLayout from '../layouts/BaseLayout.astro';
import Markdown from '../components/layout/Markdown.astro';
import TechStack from '../components/widgets/TechStack.astro';
import Timeline from '../components/widgets/Timeline.svelte';
import DaysCounter from '../components/widgets/DaysCounter.svelte';
import { Content } from '../content/about.md';
import { nickname, motto } from '../data/profile';
import avatarImg from '../assets/images/avatar.png';
---

<BaseLayout title="关于">
  <div class="about-page page-top-standard">
    <section class="about-hero glass" aria-label="个人名片">
      <div class="hero-inner">
        <div class="avatar-ring">
          <Image
            src={avatarImg}
            alt={`${nickname}的头像`}
            class="avatar-img"
            width={120}
            height={120}
            loading="eager"
          />
        </div>
        <div class="hero-title">
          <h1 class="hero-name">{nickname}</h1>
          <p class="hero-motto">{motto}</p>
        </div>
      </div>
    </section>

    <div class="about-main">
      <div class="about-left">
        <section class="about-stats" aria-label="数据统计">
          <DaysCounter client:load />
        </section>
        <TechStack />
      </div>
      <div class="about-intro glass">
        <Markdown>
          <div class="markdown-body">
            <Content />
          </div>
        </Markdown>
      </div>
    </div>

    <section class="about-timeline" aria-label="成长历程">
      <Timeline client:load />
    </section>
  </div>
</BaseLayout>

<style>
  /* width: 100% 必须有：.hero 是 flex 容器，只写 max-width 时 auto 宽度
   * 会按内容尺寸收缩（纯中文内容 max-content 约一个字宽，页面会塌成窄缝） */
  .about-page {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* ---- 个人名片 ---- */
  .about-hero {
    position: relative;
    overflow: hidden;
    width: 100%;
    border-radius: var(--radius);
  }

  /* 左上角的一团柔光，让玻璃卡有受光方向 */
  .about-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 130% at 0% 0%, var(--rest-bg), transparent 62%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 26px 34px;
  }

  .avatar-ring {
    --avatar-size: 100px;
    width: var(--avatar-size);
    height: var(--avatar-size);
    border-radius: 50%;
    padding: 2px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 0 12px rgba(255, 255, 255, 0.25);
    flex-shrink: 0;
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .hero-title {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hero-name {
    font-size: 2rem;
    line-height: 1.15;
    letter-spacing: 0.05em;
    color: var(--white);
    text-shadow: var(--shadow);
  }

  .hero-motto {
    font-size: 0.9rem;
    letter-spacing: 0.25em;
    color: var(--ink);
  }

  /* ---- 数据统计 + 技术栈（左列），右侧自述卡与左列同高 ---- */
  .about-main {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr));
    align-items: stretch;
    gap: 16px;
  }

  .about-left {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .about-stats {
    width: 100%;
  }

  /* ---- 自述卡：占右列，随行高拉伸，内容垂直居中 ---- */
  .about-intro {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: 24px 26px;
  }

  /* 卡片首尾贴边，去掉 markdown 正文的上下默认外边距 */
  .about-intro :global(.markdown-body > :first-child) {
    margin-top: 0;
  }

  .about-intro :global(.markdown-body > :last-child) {
    margin-bottom: 0;
  }

  /* ---- 历程 ---- */
  .about-timeline {
    width: 100%;
  }

  /* ---- 手机端适配 ---- */
  @media (max-width: 768px) {
    .hero-inner {
      gap: 16px;
      padding: 22px 18px;
    }

    .avatar-ring {
      --avatar-size: 80px;
    }

    .hero-name {
      font-size: 1.4rem;
    }

    .hero-motto {
      font-size: 0.75rem;
    }

    .about-intro {
      padding: 20px 18px;
    }
  }
</style>
