---
import BaseLayout from '../layouts/BaseLayout.astro';
import Clock from '../components/Clock.vue';
import Quote from '../components/Quote.vue';
import MusicPlayer from '../components/MusicPlayer.vue';
import DaysCounter from '../components/DaysCounter.vue';
import { Icon } from 'astro-icon/components';
import avatarImg from '../assets/images/tx.png';

// 页面数据

const nickname = '羽毛';

// 右栏数据
const startFullstackDate = '2024-03-23'; // 开始全栈学习日期（开发经验也是根据这个日期算的）
const projectsCount = 12; // 项目个数（后续做完项目界面需要改为动态的）

// 联系方式数据
const socialLinks = [
  { icon: 'la:github', label: 'GitHub', url: 'https://github.com/yumaonb' },
  { icon: 'simple-icons:bilibili', label: 'Bilibili', url: 'https://b23.tv/XFTBHN3' },
  { icon: 'la:envelope', label: '邮箱', url: 'mailto:hbnl555@qq.com' },
  { icon: 'la:weixin', label: '微信', url: 'https://weixin.qq.com/g/Q0h_T5g0R3ZP' },
  { icon: 'la:qq', label: 'QQ', url: 'https://qm.qq.com/q/UhGbjbysQW' },
];
---
<BaseLayout title="羽毛的小屋">
  <link slot="head" rel="icon" type="image/png" href={avatarImg.src} />
  <div class="content-wrapper">
    <!-- 左栏 -->
    <div class="left-col">
      <!-- 头像 + 昵称 + 签名 -->
      <div class="avatar-section">
        <div class="avatar-ring">
          <img src={avatarImg.src} alt="头像" class="avatar-img" />
        </div>
        <div class="avatar-text">
          <h1 class="nickname">{nickname}</h1>
          <p class="motto">阅己 越己 悦己</p>
        </div>
      </div>

      <!-- 介绍 -->
      <div class="intro-card glass">
        <div class="intro-about">
          <p>这里是羽毛的小屋，一位热爱全栈的学生。</p>
          <p>本项目技术栈：Astro · Vue 3 · TypeScript</p>
          <p>已开源至github：<a href="https://github.com/yumaonb/jieshaoye/" target="_blank" rel="noopener">点我前往项目地址</a></p>
          <p>记录技术、分享生活、探索无限可能。</p>
        </div>
      </div>

      <!-- 联系方式 -->
      <div class="social-row">
        {socialLinks.map((link) => (
          <a href={link.url} class="glass-btn" title={link.label} target="_blank" rel="noopener">
            <Icon name={link.icon} class="btn-icon" />
          </a>
        ))}
      </div>
    </div>

    <!-- 右栏（屏幕宽度小于769px隐藏） -->
    <div class="right-col">
      <!-- 实时时钟 -->
      <div class="island-slot glass">
        <Clock client:media="(min-width: 769px)" />
      </div>

      <!-- 学习全栈时间、开发经验、项目数量 -->
      <div class="stats-row">
        <DaysCounter startDate={startFullstackDate} client:media="(min-width: 769px)" />
        <div class="stat-card glass">
          <span class="stat-label">项目数量</span>
          <span class="stat-value">{projectsCount}<small>个</small></span>
        </div>
      </div>

      <!-- 随机一言 -->
      <div class="island-slot glass">
        <Quote client:media="(min-width: 769px)" />
      </div>

      <!-- 音乐播放器 -->
      <!-- 音乐播放器还有点问题，先扔这，后续改 -->
      <!-- <div class="island-slot glass">
        <MusicPlayer client:media="(min-width: 769px)" />
      </div> -->
    </div>
  </div>


</BaseLayout>

<style>
  /* 页面布局 */
  .content-wrapper {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 48px;
    max-width: 1100px;
    margin: 0 auto;
    padding: 24px 24px 0;
  }

  /* 左栏 */
  .left-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    width: 360px;
    flex-shrink: 0;
  }

  /* 头像区域 */
  .avatar-section {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 20px;
  }

  .avatar-ring {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    padding: 2px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 0 12px rgba(255, 255, 255, 0.25);
    flex-shrink: 0;
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .avatar-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .nickname {
    font-family: 'ZCOOL KuaiLe', cursive, sans-serif;
    font-size: 2rem;
    color: #fff;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
    letter-spacing: 0.05em;
    margin: 0;
  }

  .motto {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 0.25em;
    margin: 0;
    font-family: 'Noto Sans SC', sans-serif;
  }

  /* 介绍卡片 */
  .intro-card {
    width: 100%;
    padding: 28px 24px;
    position: relative;
    text-align: center;
    border-radius: var(--radius);
    align-self: center;
  }

  .intro-about p {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.7;
    margin: 0;
    font-family: 'Noto Sans SC', sans-serif;
  }

  /* 联系方式 */
  .social-row {
    display: flex;
    gap: 18px;
    justify-content: center;
    flex-wrap: wrap;
    width: 100%;
    align-self: center;
  }

  /* 右栏 */
  .right-col {
    width: 340px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex-shrink: 0;
  }

  /* 学习全栈时间、开发经验、项目数量 */
  .stats-row {
    display: flex;
    gap: 12px;
  }

  .stat-card {
    flex: 1;
    padding: 16px 8px;
    text-align: center;
    border-radius: var(--radius);
  }

  .stat-label {
    display: block;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 6px;
    font-family: 'Noto Sans SC', sans-serif;
    white-space: nowrap;
  }

  .stat-value {
    display: block;
    font-size: 1.35rem;
    font-weight: 700;
    color: #fff;
    font-family: 'ZCOOL KuaiLe', cursive;
    line-height: 1.3;
  }

  .stat-value small {
    font-size: 0.7rem;
    font-weight: 400;
    opacity: 0.7;
  }

  /* 岛屿容器 */
  .island-slot {
    width: 100%;
    padding: 16px 20px;
    border-radius: var(--radius);
  }

  /* 手机端适配 */
  @media (max-width: 768px) {
    .content-wrapper {
      flex-direction: column;
      align-items: center;
      gap: 24px;
    }

    .left-col {
      width: 100%;
      align-items: flex-start;
    }

    .intro-card {
      width: 100%;
      max-width: 100vw;
      box-sizing: border-box;
      padding: 24px 20px;
    }

    .right-col {
      display: none;
    }

    .stats-row {
      gap: 8px;
    }

    .avatar-ring {
      width: 80px;
      height: 80px;
    }

    .nickname {
      font-size: 1.4rem;
    }

    .motto {
      font-size: 0.75rem;
    }

    .island-slot {
      padding: 14px 16px;
    }
  }
</style>