---
// index.astro — 首页

import BaseLayout from '../layouts/BaseLayout.astro';
import Clock from '../components/widgets/Clock.vue';
import Quote from '../components/widgets/Quote.vue';
import DaysCounter from '../components/widgets/DaysCounter.vue';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import avatarImg from '../assets/images/tx.png';

const nickname = '羽毛';

// 联系方式数据
const socialLinks = [
  { icon: 'la:github', label: 'GitHub', url: 'https://github.com/yumaonb' },
  { icon: 'simple-icons:bilibili', label: 'Bilibili', url: 'https://b23.tv/XFTBHN3' },
  { icon: 'la:envelope', label: '邮箱', url: 'mailto:hbnl555@qq.com' },
  { icon: 'la:weixin', label: '微信', url: 'https://weixin.qq.com/g/Q0h_T5g0R3ZP' },
  { icon: 'la:qq', label: 'QQ', url: 'https://qm.qq.com/q/UhGbjbysQW' },
];
---
<BaseLayout title="羽毛的小屋">
  <div class="content-wrapper">
    <!-- 左栏 -->
    <div class="left-col">
      <!-- 头像 + 昵称 + 签名 -->
      <div class="avatar-section">
        <div class="avatar-ring">
          <Image src={avatarImg} alt="头像" class="avatar-img" width={120} height={120} loading="eager" />
        </div>
        <div class="avatar-text">
          <h1 class="nickname">{nickname}</h1>
          <p class="motto">阅己 越己 悦己</p>
        </div>
      </div>

      <!-- 介绍 -->
      <div class="intro-card glass">
        <div class="intro-about">
          <p>这里是羽毛的小屋，一位热爱探索的学生。</p>
          <p>本项目技术栈：Astro · Vue 3 · TypeScript</p>
          <p>源码已开源至github：<a href="https://github.com/yumaonb/jieshaoye/" target="_blank" rel="noopener">点我前往项目地址</a></p>
          <p>本站后续可能会更换域名，建议收藏项目地址</p>
        </div>
      </div>

      <!-- 联系方式 -->
      <div class="social-row">
        {socialLinks.map((link) => (
          <a href={link.url} class="glass-btn" title={link.label} target="_blank" rel="noopener">
            <Icon name={link.icon} class="btn-icon" />
          </a>
        ))}
      </div>
    </div>

    <!-- 右栏（屏幕宽度小于769px隐藏） -->
    <div class="right-col">
      <!-- 实时时钟 -->
      <div class="island-slot glass">
        <Clock client:media="(min-width: 768px)" />
      </div>

      <!-- 入坑全栈时间、开发经验、项目数量 -->
      <div class="stats-row">
        <DaysCounter client:media="(min-width: 768px)" />
      </div>

      <!-- 随机一言 -->
      <div class="island-slot glass">
        <Quote client:media="(min-width: 768px)" />
      </div>
    </div>
  </div>


</BaseLayout>

<style>
  /* 页面布局 */
  .content-wrapper {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 48px;
    max-width: 1100px;
    margin: auto 0;
    padding: 24px 24px 0;
  }

  /* 左栏 */
  .left-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    width: 360px;
    flex-shrink: 0;
  }

  /* 头像区域 */
  .avatar-section {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 20px;
  }

  .avatar-ring {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    padding: 2px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 0 12px rgba(255, 255, 255, 0.25);
    flex-shrink: 0;
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .avatar-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .nickname {
    font-size: 2rem;
    color: #fff;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
    letter-spacing: 0.05em;
    margin: 0;
  }

  .motto {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 0.25em;
    margin: 0;
  }

  /* 介绍卡片 */
  .intro-card {
    width: 100%;
    padding: 28px 24px;
    position: relative;
    text-align: center;
    border-radius: var(--radius);
    align-self: center;
  }

  .intro-about p {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.7;
    margin: 0;
  }

  /* 联系方式 */
  .social-row {
    display: flex;
    gap: 18px;
    justify-content: center;
    flex-wrap: wrap;
    width: 100%;
    align-self: center;
  }

  /* 右栏 */
  .right-col {
    width: 340px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex-shrink: 0;
    min-height: 406px;
  }

  /* 岛屿容器 */
  .island-slot {
    width: 100%;
    padding: 14px 20px;
    border-radius: var(--radius);
  }

  /* 手机端适配 */
  @media (max-width: 768px) {
    .content-wrapper {
      flex-direction: column;
      align-items: center;
      gap: 24px;
    }

    .left-col {
      width: 100%;
      align-items: flex-start;
    }

    .intro-card {
      width: 100%;
      max-width: 100vw;
      box-sizing: border-box;
      padding: 24px 20px;
    }

    .right-col {
      display: none;
    }

    .avatar-ring {
      width: 80px;
      height: 80px;
    }

    .nickname {
      font-size: 1.4rem;
    }

    .motto {
      font-size: 0.75rem;
    }
  }
</style>