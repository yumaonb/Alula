---
// index.astro — 首页

import BaseLayout from '../layouts/BaseLayout.astro';
import Clock from '../components/widgets/Clock.svelte';
import Quote from '../components/widgets/Quote.astro';
import DaysCounter from '../components/widgets/DaysCounter.svelte';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import avatarImg from '../assets/images/avatar.png';
import { nickname, motto, intro, socialLinks } from '../data/profile';
---
<BaseLayout title="首页">
  <div class="content-wrapper">
    <!-- 左栏 -->
    <div class="left-col">
      <!-- 头像 + 昵称 + 签名 -->
      <div class="avatar-section">
        <div class="avatar-ring">
          <Image src={avatarImg} alt="头像" class="avatar-img" width={120} height={120} loading="eager" />
        </div>
        <div class="avatar-text">
          <h1 class="nickname section-title">{nickname}</h1>
          <p class="motto text-motto">{motto}</p>
        </div>
      </div>

      <!-- 介绍 -->
      <div class="intro-card glass">
        <div class="intro-about" set:html={intro}></div>
      </div>

      <!-- 联系方式 -->
      <div class="social-row">
        {socialLinks.map((link) => (
          <a href={link.url} class="glass-btn" title={link.label} target="_blank" rel="noopener">
            <Icon name={link.icon} class="btn-icon" />
          </a>
        ))}
      </div>
    </div>

    <!-- 右栏（屏幕宽度小于769px隐藏） -->
    <div class="right-col">
      <!-- 实时时钟 -->
      <div class="island-slot glass">
        <Clock client:media="(min-width: 768px)" />
      </div>

      <!-- 入坑全栈时间、开发经验、项目数量 -->
      <div class="stats-row">
        <DaysCounter client:media="(min-width: 768px)" />
      </div>

      <!-- 随机一言 -->
      <div class="island-slot glass">
        <Quote />
      </div>
    </div>
  </div>


</BaseLayout>

<style>
  /* 页面布局 */
  .content-wrapper {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 48px;
    max-width: 1100px;
    margin: auto 0;
    padding: 24px 24px 0;
  }

  /* 左栏 */
  .left-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    width: 360px;
    flex-shrink: 0;
  }

  /* 头像区域 */
  .avatar-section {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 20px;
  }

  .avatar-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .nickname {
    letter-spacing: 0.05em;
  }

  /* 介绍卡片 */
  .intro-card {
    width: 100%;
    padding: 28px 24px;
    position: relative;
    text-align: center;
    border-radius: var(--radius);
    align-self: center;
  }

  .intro-about {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.7;
  }

  /* 联系方式 */
  .social-row {
    display: flex;
    gap: 18px;
    justify-content: center;
    flex-wrap: wrap;
    width: 100%;
    align-self: center;
  }

  /* 右栏 */
  .right-col {
    width: 340px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex-shrink: 0;
    min-height: 406px;
  }

  /* 岛屿容器 */
  .island-slot {
    width: 100%;
    padding: 14px 20px;
    border-radius: var(--radius);
  }

  /* 手机端适配 */
  @media (max-width: 768px) {
    .content-wrapper {
      flex-direction: column;
      align-items: center;
      gap: 24px;
    }

    .left-col {
      width: 100%;
      align-items: flex-start;
    }

    .intro-card {
      width: 100%;
      max-width: 100vw;
      box-sizing: border-box;
      padding: 24px 20px;
    }

    .right-col {
      display: none;
    }

    .avatar-ring {
      --avatar-size: 80px;
    }

    .nickname {
      font-size: 1.4rem;
    }

    .motto {
      font-size: 0.75rem;
    }
  }
</style>