---
// friends.astro — 友情链接页面
// 用法：路由 /friends/
import { Icon } from 'astro-icon/components';
import { navItem } from '../data/nav';

import BaseLayout from '../layouts/BaseLayout.astro';
import { friends } from '../data/friends';

// 页头标题图标与导航同源（src/data/nav.ts），页面不写死自己的路径
const pageNav = navItem('friends');
---

<BaseLayout title="友情链接">
  <div class="friends-page page-top-standard">
    <header class="page-head">
      <h1 class="page-title">
        <Icon is:inline name={pageNav.icon} class="page-title-icon" />
        友情链接
      </h1>
    </header>

    <div class="friends-grid">
      {friends.map((f) => (
        <a href={f.url} class="friend-card glass hoverable link-plain" target="_blank" rel="noopener">
          <div class="friend-avatar avatar-ring" style="--avatar-size:52px;">
            <img src={f.avatar} alt={f.name} class="avatar-img" loading="lazy" />
          </div>
          <div class="friend-info">
            <span class="friend-name">{f.name}</span>
            <span class="friend-desc">{f.desc}</span>
          </div>
        </a>
      ))}
    </div>

    <section class="apply-section">
      <div class="apply-header">
        <span class="apply-line"></span>
        <p class="apply-label">申请友链</p>
        <span class="apply-line"></span>
      </div>
      <div class="apply-card glass">
        <p class="apply-text">如果你想交换友链，请通过首页联系方式联系我，首选QQ联系，其他联系方式可能存在回复不及时的情况</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* width: 100% 必须有：.hero 是 flex 容器，只写 max-width 会塌成窄缝（见 about 页注释）
     标题区用全站页面标题：.page-head / .page-title / .page-title-icon / .page-top-standard（见 utilities.css） */
  .friends-page {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  /* ---- 友链网格 ---- */
  .friends-grid {
    display: grid;
    /* 列数由容器宽度决定（单卡最窄 300px），不设上限：宽屏 / 超宽屏自动多列 */
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 12px;
    margin-bottom: 32px; /* 网格→申请区间距（标题→网格由页头 margin-bottom 16px 定） */
  }

  .friend-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px 18px;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius);
  }

  .avatar-ring {
    --avatar-size: 100px;
    width: var(--avatar-size);
    height: var(--avatar-size);
    border-radius: 50%;
    padding: 2px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 0 12px rgba(255, 255, 255, 0.25);
    flex-shrink: 0;
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .friend-avatar {
    flex-shrink: 0;
    margin: 4px 0 4px 2px;
  }

  .friend-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .friend-name {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .friend-desc {
    font-size: 0.78rem;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ---- 申请友链 ---- */
  .apply-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .apply-header {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .apply-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(255, 255, 255, 0.18));
  }

  .apply-line:last-child {
    background: linear-gradient(to left, transparent, rgba(255, 255, 255, 0.18));
  }

  .apply-label {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink);
    white-space: nowrap;
  }

  .apply-card {
    padding: 20px 24px;
    border-radius: var(--radius);
  }

  .apply-text {
    font-size: 0.88rem;
    color: var(--ink);
    line-height: 1.7;
  }

  /* ---- 小屏适配 ----（标题字号 / 顶距由全站页面标题统一处理，这里只管网格） */
  @media (max-width: 768px) {
    .friends-grid {
      grid-template-columns: 1fr;
    }

    .friend-card {
      padding: 14px 16px;
    }
  }
</style>
