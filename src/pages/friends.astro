---
// friends.astro — 友情链接页面
// 用法：路由 /friends/
import BaseLayout from '../layouts/BaseLayout.astro';
import { friends } from '../data/friends';
---

<BaseLayout title="友情链接">
  <div class="friends-page">
    <header class="friends-header">
      <h1 class="friends-title">友情链接</h1>
      <p class="friends-desc">欢迎各位互加友链，本站域名后续可能更换，如介意请勿申请友链</p>
    </header>

    <div class="friends-grid">
      {friends.map((f) => (
        <a href={f.url} class="friend-card glass hoverable link-plain" target="_blank" rel="noopener">
          <div class="friend-avatar avatar-ring" style="--avatar-size:52px;">
            <img src={f.avatar} alt={f.name} class="avatar-img" loading="lazy" />
          </div>
          <div class="friend-info">
            <span class="friend-name">{f.name}</span>
            <span class="friend-desc">{f.desc}</span>
          </div>
        </a>
      ))}
    </div>

    <section class="apply-section">
      <p class="apply-label">申请友链</p>
      <div class="apply-card glass">
        <p class="apply-text">如果你想交换友链，请通过首页联系方式联系我，首选QQ联系，其他联系方式可能存在回复不及时的情况</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* width: 100% 必须有：.hero 是 flex 容器，只写 max-width 会塌成窄缝（见 about 页注释） */
  .friends-page {
    width: 100%;
    max-width: 800px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* ---- 标题区 ---- */
  .friends-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .friends-title {
    font-size: 2rem;
    color: var(--hover-ink);
    text-shadow: var(--title-shadow);
  }

  .friends-desc {
    font-size: 0.95rem;
    color: var(--color-text);
  }

  /* ---- 友链网格 ---- */
  .friends-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .friend-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px 18px;
    text-decoration: none;
    color: inherit;
    border-radius: 12px;
  }

  .avatar-ring {
    --avatar-size: 100px;
    width: var(--avatar-size);
    height: var(--avatar-size);
    border-radius: 50%;
    padding: 2px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 0 12px rgba(255, 255, 255, 0.25);
    flex-shrink: 0;
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .friend-avatar {
    flex-shrink: 0;
    margin: 4px 0 4px 2px;
  }

  .friend-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .friend-name {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .friend-desc {
    font-size: 0.78rem;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ---- 申请友链 ---- */
  .apply-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .apply-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text);
    padding-left: 4px;
  }

  .apply-card {
    padding: 20px 24px;
    border-radius: var(--radius);
  }

  .apply-text {
    font-size: 0.88rem;
    color: var(--color-text);
    line-height: 1.7;
  }

  /* 标题移动端档与全站页头一致用 768px 断点（本页网格是 640px，两码事） */
  @media (max-width: 768px) {
    .friends-title {
      font-size: 1.5rem;
    }
  }

  /* ---- 手机端适配 ---- */
  @media (max-width: 640px) {
    .friends-grid {
      grid-template-columns: 1fr;
    }

    .friend-card {
      padding: 14px 16px;
    }
  }
</style>
