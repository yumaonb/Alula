---
// sponsor.astro — 赞助页面
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { sponsorLink, sponsorList, supportActions } from '../data/sponsor';
---

<BaseLayout title="赞助">
  <div class="sponsor-page page-container">

    <!-- 标题区 -->
    <header class="sponsor-header">
      <h1 class="header-title section-title">赞助支持</h1>
      <p class="header-desc section-desc">如果我的内容对你有帮助，欢迎请我喝杯咖啡</p>
    </header>

    <!-- 主赞助卡片 -->
    <a href={sponsorLink.href} class="hero-card glass" target="_blank" rel="noopener">
      <div class="hero-card-inner">
        <div class="hero-text">
          <span class="hero-label">推荐支持</span>
          <h2 class="hero-name">{sponsorLink.name}</h2>
          <p class="hero-desc">{sponsorLink.desc}</p>
        </div>
        <div class="hero-arrow">
          <Icon name="la:angle-right" />
        </div>
      </div>
    </a>

    <!-- 赞助名单 -->
    <a href={sponsorList.href} class="action-card glass" target={sponsorList.target} rel="noopener">
      <Icon name={sponsorList.icon} class="action-icon" />
      <div class="action-body">
        <span class="action-title">{sponsorList.title}</span>
        <span class="action-desc">{sponsorList.desc}</span>
      </div>
    </a>

    <!-- 其他支持方式 -->
    <section class="other-section">
      <div class="other-header">
        <span class="other-line"></span>
        <p class="other-label">其他方式</p>
        <span class="other-line"></span>
      </div>
      <div class="action-grid">
        {supportActions.map((a) => (
          a.href ? (
            <a href={a.href} class="grid-card glass" target={a.target} rel="noopener">
              <Icon name={a.icon} class="grid-icon" />
              <div class="grid-body">
                <span class="grid-title">{a.title}</span>
                <span class="grid-desc">{a.desc}</span>
              </div>
            </a>
          ) : (
            <div class="grid-card glass">
              <Icon name={a.icon} class="grid-icon" />
              <div class="grid-body">
                <span class="grid-title">{a.title}</span>
                <span class="grid-desc">{a.desc}</span>
              </div>
            </div>
          )
        ))}
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .sponsor-page {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  /* ---- 标题区 ---- */
  .sponsor-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .header-title {
    margin: 0 0 8px;
  }

  /* ---- 主赞助卡片 ---- */
  .hero-card {
    margin-top: 25px;
    width: 100%;
    text-decoration: none;
    color: inherit;
    border-radius: 14px;
    position: relative;
    overflow: hidden;
    transition: filter 0.25s ease;
  }

  .hero-card:hover {
    filter: brightness(1.15);
  }

  .hero-card-inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 28px 24px;
  }

  .hero-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .hero-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.45);
  }

  .hero-name {
    font-size: 1.2rem;
    font-weight: 700;
    color: #fff;
  }

  .hero-desc {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.4);
  }

  .hero-arrow {
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.2);
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .hero-arrow :global(svg) {
    width: 20px;
    height: 20px;
  }

  .hero-card:hover .hero-arrow {
    color: rgba(255, 255, 255, 0.5);
  }

  /* ---- 其他支持方式 ---- */
  .other-section {
    margin-top: 14px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* 分组标题：左右短线夹住文字，比纯小字更醒目 */
  .other-header {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .other-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(255, 255, 255, 0.18));
  }

  .other-line:last-child {
    background: linear-gradient(to left, transparent, rgba(255, 255, 255, 0.18));
  }

  .other-label {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.55);
    white-space: nowrap;
  }

  /* 三张卡片横向排列，窄屏回落为纵向 */
  .action-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  /* 横排卡片：图标居中在上、文字在下 */
  .grid-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    padding: 22px 14px 18px;
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    transition: filter 0.25s ease;
  }

  .grid-card:hover {
    filter: brightness(1.15);
  }

  .grid-icon {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    color: rgba(255, 255, 255, 0.5);
    transition: color 0.25s ease;
  }

  .grid-icon :global(svg) {
    width: 30px;
    height: 30px;
  }

  .grid-card:hover .grid-icon {
    color: rgba(255, 255, 255, 0.85);
  }

  .grid-body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .grid-title {
    font-size: 0.88rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
  }

  .grid-desc {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.35);
  }

  .action-card {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    padding: 18px 20px;
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    transition: filter 0.25s ease;
  }

  .action-card:hover {
    filter: brightness(1.15);
  }

  .action-icon {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    color: rgba(255, 255, 255, 0.45);
    transition: color 0.25s ease;
  }

  .action-card:hover .action-icon {
    color: rgba(255, 255, 255, 0.7);
  }

  .action-icon :global(svg) {
    width: 30px;
    height: 30px;
  }

  .action-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .action-title {
    font-size: 0.88rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
  }

  .action-desc {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.35);
  }

  /* ---- 手机端适配 ---- */
  @media (max-width: 768px) {
    .sponsor-page {
      gap: 10px;
    }

    .hero-card-inner {
      padding: 22px 18px;
      gap: 16px;
    }

    .hero-icon {
      width: 44px;
      height: 44px;
    }

    .hero-name {
      font-size: 1.05rem;
    }

    .action-card {
      padding: 15px 16px;
      gap: 14px;
    }

    .action-icon {
      width: 25px;
      height: 25px;
    }

    .action-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .grid-card {
      flex-direction: row;
      text-align: left;
      padding: 15px 16px;
      gap: 14px;
    }

    .grid-body {
      flex: 1;
    }

    .grid-icon {
      width: 22px;
      height: 22px;
    }

    .other-section {
      margin-top: 6px;
      gap: 14px;
    }
  }
</style>