---
// categories.astro — 后台分类管理（列出仓库里的分类目录与 index.json）
// 用法：路由 /admin/categories/
//
// 列表不是读某个配置：分类从仓库 src/content/posts/ 下的目录推出来，
// 文章所在的每一层目录算一个，只有 index.json 没有文章的目录也算一个。
import AdminLayout from '../../layouts/AdminLayout.astro';
import { Icon } from 'astro-icon/components';
---

<AdminLayout title="管理分类">
  <div class="admin-page" data-admin-page="categories" data-admin-title="管理分类">
    <div class="admin-gate glass">
      <Icon is:inline name="mdi:lock-outline" class="admin-gate-icon" />
      <p>
        还没有连接 GitHub。
        <br />
        填好仓库与访问令牌后即可管理分类。
      </p>
      <button class="btn glass btn--primary" data-conn-open type="button">
        去连接
      </button>
    </div>

    <section class="card glass admin-needs-conn">
      <div class="card-head">
        <h2 class="card-title">分类目录</h2>
        <span class="card-extra" id="admin-cats-status">未连接</span>
      </div>
      <div class="toolbar">
        <input
          class="input"
          id="admin-cats-filter"
          type="search"
          placeholder="按路径筛选…"
          autocomplete="off"
        />
      </div>
      <ul class="file-list" id="admin-cats-list">
        <li class="empty">连接后显示分类列表</li>
      </ul>
    </section>
  </div>
</AdminLayout>
