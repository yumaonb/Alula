---
// categories.astro — 后台分类管理（列出仓库里的分类目录与 index.json）
// 用法：路由 /admin/categories/
//
// 分类只由目录结构决定（见 .dsh/rules/50-content.md），所以这一页读的是
// src/content/posts/ 下的目录与它们各自的 index.json，而不是任何配置。
import AdminLayout from '../../layouts/AdminLayout.astro';
import { Icon } from 'astro-icon/components';
---

<AdminLayout title="管理分类">
  <div class="admin-page" data-admin-page="categories" data-admin-title="管理分类">
    <div class="admin-gate">
      <Icon name="mdi:lock-outline" class="admin-gate-icon" />
      <p>
        还没有连接 GitHub。
        <br />
        填好仓库与访问令牌后即可管理分类。
      </p>
      <button class="admin-btn admin-btn--primary" data-conn-open type="button">
        去连接
      </button>
    </div>

    <section class="admin-card admin-needs-conn">
      <div class="admin-card-head">
        <h2 class="admin-card-title">分类目录</h2>
        <span class="admin-card-extra" id="admin-cats-status">未连接</span>
      </div>
      <div class="admin-toolbar">
        <input
          class="admin-input"
          id="admin-cats-filter"
          type="search"
          placeholder="按路径筛选…"
          autocomplete="off"
        />
      </div>
      <ul class="admin-file-list" id="admin-cats-list">
        <li class="admin-empty">连接后显示分类列表</li>
      </ul>
    </section>
  </div>
</AdminLayout>
