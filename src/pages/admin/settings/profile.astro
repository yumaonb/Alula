---
// profile.astro — 网站设置 / 个人信息（对应 src/data/profile.ts）
// 用法：路由 /admin/settings/profile/
//
// 这份数据同时喂首页（昵称/签名/自我介绍/社交图标）、关于页（昵称/签名）、
// 作者卡与转载组件。
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Icon } from 'astro-icon/components';
---

<AdminLayout title="个人信息">
  <div class="admin-page" data-admin-page="settings-profile" data-admin-title="个人信息">
    <div class="admin-gate">
      <Icon name="mdi:lock-outline" class="admin-gate-icon" />
      <p>
        还没有连接 GitHub。
        <br />
        填好仓库与访问令牌后即可修改配置。
      </p>
      <button class="btn btn--primary" data-conn-open type="button">
        去连接
      </button>
    </div>

    <section class="card admin-needs-conn">
      <div class="card-head">
        <h2 class="card-title">昵称与签名</h2>
      </div>
      <div class="form-grid">
        <label class="field">
          <span class="field-label">昵称</span>
          <input class="input" id="admin-profile-nickname" type="text" autocomplete="off" />
        </label>
        <label class="field">
          <span class="field-label">签名 / 座右铭</span>
          <input class="input" id="admin-profile-motto" type="text" autocomplete="off" />
        </label>
      </div>
    </section>

    <section class="card admin-needs-conn">
      <div class="card-head">
        <h2 class="card-title">首页自我介绍</h2>
      </div>
      <label class="field">
        <span class="field-label">正文</span>
        <textarea class="input input--area" id="admin-profile-intro"></textarea>
      </label>
      <p class="hint">
        支持 HTML，换行要写成 &lt;br&gt;，链接直接写 &lt;a href="..."&gt;文字&lt;/a&gt;。
      </p>
    </section>

    <section class="card admin-needs-conn">
      <div class="card-head">
        <h2 class="card-title">社交链接</h2>
      </div>
      <p class="card-desc">
        图标用 Iconify 名称（如 la:github / simple-icons:bilibili），一行一条，顺序就是首页的显示顺序。
      </p>
      <div class="rows" id="admin-profile-social-rows">
        <div class="row">
          <input class="input" type="text" placeholder="图标，如 la:github" />
          <input class="input" type="text" placeholder="名称" />
          <input class="input" type="text" placeholder="链接" />
          <button class="row-remove" type="button" aria-label="删除这条">
            <Icon name="mdi:close" />
          </button>
        </div>
      </div>
      <div class="toolbar">
        <button class="btn btn--dashed" id="admin-profile-social-add" type="button">
          <Icon name="mdi:plus" class="btn-icon" />
          添加一条
        </button>
      </div>
    </section>
  </div>
</AdminLayout>
