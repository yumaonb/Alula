---
// background.astro — 后台系统设置 · 全站背景（结构化表单编辑 src/data/background.ts）
// 用法：路由 /admin/settings/background/
import { Icon } from 'astro-icon/components';

import AdminLayout from '../_admin/AdminLayout.astro';
---

<AdminLayout title="全站背景">
  <div class="admin-page" data-admin-page="settings-background" data-admin-title="全站背景">
    <div class="admin-gate">
      <Icon is:inline name="mdi:lock-outline" class="admin-gate-icon" />
      <p>
        还没有连接 GitHub。
        <br />
        填好仓库与访问令牌后即可编辑站点数据。
      </p>
      <button class="btn btn--primary" data-conn-open type="button">
        去连接
      </button>
    </div>

    <section class="card admin-needs-conn">
      <div class="card-head">
        <h2 class="card-title">全站背景</h2>
        <span class="badge" id="admin-data-state">
          未暂存
        </span>
      </div>
      <p class="hint">
        只填文件名，type 决定去哪个文件夹找，写错会在构建期直接报错。压暗强度 0~1，0
        为不压暗。改动后本地开发需重启 <code>pnpm dev</code>，正式站点需提交并重新构建后生效。
      </p>
      <div id="admin-data-form">
        <p class="empty">连接 GitHub 后自动加载</p>
      </div>
    </section>
  </div>
</AdminLayout>
