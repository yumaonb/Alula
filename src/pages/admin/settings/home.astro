---
// home.astro — 网站设置 / 首页组件（对应 src/data/dayscounter.ts）
// 用法：路由 /admin/settings/home/
//
// 首页右栏有统计卡片（本页）、时钟（不需要配置）与随机一言（在「随机一言」页配置）。
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Icon } from 'astro-icon/components';
---

<AdminLayout title="首页组件">
  <div class="admin-page" data-admin-page="settings-home" data-admin-title="首页组件">
    <div class="admin-gate glass">
      <Icon name="mdi:lock-outline" class="admin-gate-icon" />
      <p>
        还没有连接 GitHub。
        <br />
        填好仓库与访问令牌后即可修改配置。
      </p>
      <button class="btn glass btn--primary" data-conn-open type="button">
        去连接
      </button>
    </div>

    <section class="card glass admin-needs-conn">
      <div class="card-head">
        <h2 class="card-title">统计卡片</h2>
      </div>
      <div class="form-grid">
        <label class="field">
          <span class="field-label">标签</span>
          <input
            class="input"
            id="admin-days-label"
            type="text"
            placeholder="入坑全栈"
            autocomplete="off"
          />
        </label>
        <label class="field">
          <span class="field-label">起始日期</span>
          <input class="input" id="admin-days-start" type="date" autocomplete="off" />
        </label>
      </div>
      <p class="hint">
        页面会按起始日期实时算出已过去的天数，不需要手动维护数字。这张卡片首页与关于页都会渲染。
      </p>
    </section>
  </div>
</AdminLayout>
