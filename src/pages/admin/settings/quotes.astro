---
// index.astro — 网站设置 / 随机一言（对应 src/data/quotes.ts）
// 用法：路由 /admin/settings/quotes/
//
// 这份数据有 30 条，逐条做成行列表在后台会很长，所以正文用「一行一条」的文本域批量编辑，
// 只在需要看单条结构时才逐行展开。出处与作者用竖线分隔，跟数据文件里的写法一致。
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { Icon } from 'astro-icon/components';
---

<AdminLayout title="随机一言">
  <div data-admin-page="settings-quotes" data-admin-title="随机一言">
    <div class="admin-card">
      <div class="admin-card-inner">
        <h1 class="admin-page-title">随机一言</h1>
        <p class="admin-page-desc">
          对应 src/data/quotes.ts。首页右栏每次刷新随机抽一条；出处与作者留空时页面上不显示那一行。
        </p>
      </div>
    </div>

    <div class="admin-gate">
      <Icon name="mdi:lock-outline" class="admin-gate-icon" />
      <p>
        还没有连接 GitHub。
        <br />
        展开右上角「连接」，填入仓库与访问令牌。
      </p>
    </div>

    <div class="admin-card admin-needs-conn">
      <div class="admin-card-inner">
        <h2 class="admin-card-title">
          <Icon name="mdi:format-quote-open-outline" class="admin-card-title-icon" />
          批量编辑
        </h2>
        <label class="admin-field">
          <span class="admin-field-label">每行一条：正文 | 出处 | 作者</span>
          <textarea
            class="admin-input admin-input--area"
            id="admin-quotes-bulk"
            rows="14"
            placeholder="人生若只如初见，何事秋风悲画扇。 | 木兰花·拟古决绝词柬友 | 纳兰性德"
          ></textarea>
        </label>
        <div class="admin-toolbar">
          <span class="admin-status" id="admin-quotes-status">共 0 条</span>
        </div>
        <p class="admin-hint">
          出处与作者可以省略（只写正文，或「正文 | 出处」）。竖线是分隔符，正文里不要出现竖线。
        </p>
      </div>
    </div>

    <div class="admin-card admin-needs-conn">
      <div class="admin-card-inner">
        <h2 class="admin-card-title">
          <Icon name="mdi:table-eye" class="admin-card-title-icon" />
          逐条查看
        </h2>
        <p class="admin-page-desc">
          数据量大时逐条校验用，编辑仍以上面的文本域为准。每行一条，出处与作者可留空。
        </p>
        <div class="admin-rows" id="admin-quote-rows">
          <div class="admin-row">
            <input class="admin-input" type="text" placeholder="正文" />
            <input class="admin-input" type="text" placeholder="出处（可空）" />
            <input class="admin-input" type="text" placeholder="作者（可空）" />
            <button class="admin-row-remove" type="button" aria-label="删除这条">
              <Icon name="mdi:close" />
            </button>
          </div>
        </div>
        <div class="admin-toolbar">
          <button class="admin-btn admin-btn--ghost" id="admin-quote-add" type="button">
            <Icon name="mdi:plus" class="admin-btn-icon" />
            添加一条
          </button>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>
