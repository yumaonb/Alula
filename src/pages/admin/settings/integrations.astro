---
// integrations.astro — 网站设置 / 技术与集成（对应 src/data/techstack.ts 与 src/data/github.ts）
// 用法：路由 /admin/settings/integrations/
//
// techstack.ts 喂关于页的技术栈卡片；github.ts 是后台自身与评论区的接入参数，
// 两者都不跟随任何单个站点页面，所以单独成页。
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Icon } from 'astro-icon/components';
---

<AdminLayout title="技术与集成">
  <div class="admin-page" data-admin-page="settings-integrations" data-admin-title="技术与集成">
    <div class="admin-gate">
      <Icon name="mdi:lock-outline" class="admin-gate-icon" />
      <p>
        还没有连接 GitHub。
        <br />
        填好仓库与访问令牌后即可修改配置。
      </p>
      <button class="btn btn--primary" data-conn-open type="button">
        去连接
      </button>
    </div>

    <section class="card admin-needs-conn">
      <div class="card-head">
        <h2 class="card-title">技术栈</h2>
      </div>
      <p class="card-desc">每个分类一行，条目用逗号分隔。关于页按这里的顺序从上到下渲染。</p>
      <div class="rows" id="admin-tech-rows">
        <div class="row">
          <input class="input" type="text" placeholder="分类，如 前端" />
          <input class="input" type="text" placeholder="条目，逗号分隔" />
          <button class="row-remove" type="button" aria-label="删除这条">
            <Icon name="mdi:close" />
          </button>
        </div>
      </div>
      <div class="toolbar">
        <button class="btn btn--dashed" id="admin-tech-add" type="button">
          <Icon name="mdi:plus" class="btn-icon" />
          添加一行
        </button>
      </div>
    </section>

    <section class="card admin-needs-conn">
      <div class="card-head">
        <h2 class="card-title">GitHub 集成</h2>
      </div>
      <div class="form-grid">
        <label class="field">
          <span class="field-label">用户名</span>
          <input
            class="input"
            id="admin-gh-username"
            type="text"
            autocomplete="off"
          />
        </label>
        <label class="field">
          <span class="field-label">giscus 仓库名</span>
          <input class="input" id="admin-gh-repo" type="text" autocomplete="off" />
        </label>
      </div>
      <label class="field">
        <span class="field-label">缓存时间（毫秒）</span>
        <input
          class="input"
          id="admin-gh-ttl"
          type="number"
          min="0"
          step="1000"
          autocomplete="off"
        />
      </label>
      <p class="hint">
        仓库名必须与 Comments.astro 里的 giscus 配置一致，否则评论区会指向另一个仓库。
        缓存时间默认为 3600000（1 小时）。
      </p>
    </section>
  </div>
</AdminLayout>
