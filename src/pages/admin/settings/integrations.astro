---
// integrations.astro — 后台系统设置 · 第三方服务（结构化表单编辑 src/data/github.ts）
// 用法：路由 /admin/settings/integrations/
import { Icon } from 'astro-icon/components';

import AdminLayout from '../_admin/AdminLayout.astro';
---

<AdminLayout title="第三方服务">
  <div class="admin-page" data-admin-page="settings-integrations" data-admin-title="第三方服务">
    <div class="admin-gate">
      <Icon is:inline name="mdi:lock-outline" class="admin-gate-icon" />
      <p>
        还没有连接 GitHub。
        <br />
        填好仓库与访问令牌后即可编辑站点数据。
      </p>
      <button class="btn btn--primary" data-conn-open type="button">
        去连接
      </button>
    </div>

    <section class="card admin-needs-conn">
      <div class="card-head">
        <h2 class="card-title">第三方服务</h2>
        <span class="badge" id="admin-data-state">
          未暂存
        </span>
      </div>
      <p class="hint">
        giscus 评论仓库（换仓库时仓库 id / 讨论区 id / 讨论区名要一起换）、项目拉取账号、
        后台默认连接的仓库。改动提交并重新构建站点后生效。
      </p>
      <div id="admin-data-form">
        <p class="empty">连接 GitHub 后自动加载</p>
      </div>
    </section>
  </div>
</AdminLayout>
