---
// friends.astro — 网站设置 / 友情链接（对应 src/data/friends.ts）
// 用法：路由 /admin/settings/friends/
//
// 只服务 /friends/ 一个页面，内容是一条条独立记录，所以单独成项而不是挂在别的页里。
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Icon } from 'astro-icon/components';
---

<AdminLayout title="友情链接">
  <div data-admin-page="settings-friends" data-admin-title="友情链接">
    <div class="admin-card">
      <div class="admin-card-inner">
        <h1 class="admin-page-title">友情链接</h1>
        <p class="admin-page-desc">
          对应 src/data/friends.ts，渲染在 /friends/。一行一条，顺序就是页面上的显示顺序。
        </p>
      </div>
    </div>

    <div class="admin-gate">
      <Icon name="mdi:lock-outline" class="admin-gate-icon" />
      <p>
        还没有连接 GitHub。
        <br />
        展开右上角「连接」，填入仓库与访问令牌。
      </p>
    </div>

    <div class="admin-card admin-needs-conn">
      <div class="admin-card-inner">
        <h2 class="admin-card-title">
          <Icon name="mdi:account-group-outline" class="admin-card-title-icon" />
          友链列表
        </h2>
        <div class="admin-rows" id="admin-friend-rows">
          <div class="admin-row">
            <input class="admin-input" type="text" placeholder="名称" />
            <input class="admin-input" type="text" placeholder="头像地址" />
            <input class="admin-input" type="text" placeholder="描述" />
            <input class="admin-input" type="text" placeholder="链接" />
            <button class="admin-row-remove" type="button" aria-label="删除这条">
              <Icon name="mdi:close" />
            </button>
          </div>
        </div>
        <div class="admin-toolbar">
          <button class="admin-btn admin-btn--ghost" id="admin-friend-add" type="button">
            <Icon name="mdi:plus" class="admin-btn-icon" />
            添加一条
          </button>
          <span class="admin-status" id="admin-friend-status">共 0 条</span>
        </div>
        <p class="admin-hint">
          头像与链接都写完整地址。头像用外链时建议选稳定的图床，站点换域名不会影响它。
        </p>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-card-inner">
        <h2 class="admin-card-title">
          <Icon name="mdi:pencil-outline" class="admin-card-title-icon" />
          申请说明
        </h2>
        <p class="admin-page-desc">
          页面上「申请友链」那段的文案目前写死在 src/pages/friends.astro 里，不在这份数据中。
          要改成可配置的话，需要先把它提成 data 字段。
        </p>
      </div>
    </div>
  </div>
</AdminLayout>
