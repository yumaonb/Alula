---
// site.astro — 网站设置 / 站点信息（对应 src/data/site.ts）
// 用法：路由 /admin/settings/site/
//
// 这一页只管全站级的元信息与页脚，不碰任何单个前端页面自己的内容。
// 语言会影响 <html lang>，也就是整站外壳。
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Icon } from 'astro-icon/components';
---

<AdminLayout title="站点信息">
  <div class="admin-page" data-admin-page="settings-site" data-admin-title="站点信息">
    <div class="admin-gate">
      <Icon name="mdi:lock-outline" class="admin-gate-icon" />
      <p>
        还没有连接 GitHub。
        <br />
        填好仓库与访问令牌后即可修改配置。
      </p>
      <button class="btn btn--primary" data-conn-open type="button">
        去连接
      </button>
    </div>

    <section class="card admin-needs-conn">
      <div class="card-head">
        <h2 class="card-title">基本信息</h2>
      </div>
      <div class="form-grid">
        <label class="field">
          <span class="field-label">站点名称</span>
          <input class="input" id="admin-site-name" type="text" autocomplete="off" />
        </label>
        <label class="field">
          <span class="field-label">站点域名</span>
          <input
            class="input"
            id="admin-site-domain"
            type="text"
            placeholder="example.com"
            autocomplete="off"
          />
        </label>
        <label class="field">
          <span class="field-label">语言</span>
          <input
            class="input"
            id="admin-site-lang"
            type="text"
            placeholder="zh-CN"
            autocomplete="off"
          />
        </label>
      </div>
      <label class="field">
        <span class="field-label">站点描述（SEO）</span>
        <input class="input" id="admin-site-desc" type="text" autocomplete="off" />
      </label>
    </section>

    <section class="card admin-needs-conn">
      <div class="card-head">
        <h2 class="card-title">页脚</h2>
      </div>
      <label class="field">
        <span class="field-label">版权文字</span>
        <input class="input" id="admin-site-copyright" type="text" autocomplete="off" />
      </label>
      <label class="field">
        <span class="field-label">页脚备注</span>
        <textarea class="input input--area" id="admin-site-footnote"></textarea>
      </label>
      <p class="hint">
        页脚备注支持 HTML，例如指向 Astro / Svelte 的链接就是靠 &lt;a&gt; 标签渲染的。
      </p>
    </section>
  </div>
</AdminLayout>
