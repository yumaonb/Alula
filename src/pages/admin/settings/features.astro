---
// features.astro — 后台系统设置 · 功能开关（占位页）
// 用法：路由 /admin/settings/features/
import AdminLayout from '../_admin/AdminLayout.astro';
---

<AdminLayout title="功能开关">
  <div class="admin-page" data-admin-page="settings-features" data-admin-title="功能开关">
    <section class="card">
      <div class="card-head">
        <h2 class="card-title">功能开关</h2>
        <span class="card-extra">建设中</span>
      </div>
      <p class="hint">
        这一节将管理页面与端点的构建开关（<code>src/data/config.ts</code>
        ）：关于 / 项目 / 文章 / 工具 / 友链 / 赞助六个页面开关，以及 sitemap / 文章 RSS
        两个端点开关。开关在构建期生效，改动提交并重新构建站点后才会体现。
      </p>
    </section>
  </div>
</AdminLayout>
