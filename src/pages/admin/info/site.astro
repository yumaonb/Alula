---
// site.astro — 后台网站信息 · 站点信息（结构化表单编辑 src/data/site.ts）
// 用法：路由 /admin/info/site/
import { Icon } from 'astro-icon/components';

import AdminLayout from '../_admin/AdminLayout.astro';
---

<AdminLayout title="站点信息">
  <div class="admin-page" data-admin-page="info-site" data-admin-title="站点信息">
    <div class="admin-gate">
      <Icon is:inline name="mdi:lock-outline" class="admin-gate-icon" />
      <p>
        还没有连接 GitHub。
        <br />
        填好仓库与访问令牌后即可编辑站点数据。
      </p>
      <button class="btn btn--primary" data-conn-open type="button">
        去连接
      </button>
    </div>

    <section class="card admin-needs-conn">
      <div class="card-head">
        <h2 class="card-title">站点信息</h2>
        <span class="badge" id="admin-data-state">
          未暂存
        </span>
      </div>
      <p class="hint">
        站点名称、域名、描述、版权、内容许可与页脚。页脚版权与 RSS 版权必须同一句。
        改动提交并重新构建站点后生效。
      </p>
      <div id="admin-data-form">
        <p class="empty">连接 GitHub 后自动加载</p>
      </div>
    </section>
  </div>
</AdminLayout>
