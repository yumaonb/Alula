---
// AdminLayout.astro — 后台独立外壳（自带文档骨架，不用 BaseLayout）
// 用法：<AdminLayout title="仪表盘">...</AdminLayout>
//
// 关键结构：连接面板（AdminToken）与待提交面板（AdminChanges）放在 main#swup 之外，
// 所以 swup 切页只替换 #swup 里的内容，这两块不会消失——连接状态与暂存队列得以跨页保留。
import './css/base.css';
import './css/elements.css';
import './css/admin.css';
import { Icon } from 'astro-icon/components';
import CustomScrollbar from './components/CustomScrollbar.astro';
import AdminToken from './components/AdminToken.astro';
import AdminNav from './components/AdminNav.astro';
import AdminChanges from './components/AdminChanges.svelte';
import { site } from '../../../data/site';

interface Props {
  title?: string;
}

const { title = '后台' } = Astro.props;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <title>{title} - 后台 - {site.name}</title>
  </head>
  <body class="admin-body">
    <!-- data-shell 是 shell-guard 识别后台外壳的唯一依据，改它会让守卫失效 -->
    <div class="admin-shell" id="admin-shell" data-shell="admin">
      <AdminNav />

      <div class="admin-content">
        <header class="admin-topbar">
          <button
            class="admin-drawer-toggle"
            id="admin-drawer-toggle"
            type="button"
            aria-label="展开菜单"
            aria-expanded="false"
            aria-controls="admin-nav"
          >
            <Icon is:inline name="mdi:menu" class="admin-drawer-icon" />
          </button>
          <span class="admin-brand" id="admin-topbar-title">
            {title}
          </span>
          <div class="admin-topbar-right">
            <AdminToken part="trigger" />
          </div>
        </header>

        <!-- transition-page：swup animationClass 的等待目标占位类（后台无转场动画，见 base.css） -->
        <main class="admin-main transition-page" id="swup">
          <slot />
        </main>
      </div>

      <button class="admin-drawer-backdrop" data-drawer-close aria-label="收起侧栏"></button>
    </div>

    <AdminToken part="modal" />

    <AdminChanges client:idle />
    <CustomScrollbar />
    <div class="admin-toast-stack" id="admin-toast-stack" aria-live="polite"></div>

    <script>
      import './js/shell-guard';
      import './js/shell';
      import './js/dirty-guard';
      import './js/pages';
    </script>
  </body>
</html>
