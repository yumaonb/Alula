---
// index.astro — 后台首页
// 用法：路由 /admin/
//
// 这一页只是个演示性质的落地页：真正的连接状态在右上角的弹窗里、
// 待提交在右下角的队列面板里，所以这里不放「未连接」提示，也不放统计。
import AdminLayout from '../../layouts/AdminLayout.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../../data/site';

const cards = [
  {
    icon: 'mdi:file-document-edit-outline',
    title: '文章管理',
    desc: '读仓库里的 src/content/posts/，目录结构就是分类。',
    href: '/admin/posts/list/',
    action: '去管理文章',
  },
  {
    icon: 'mdi:source-branch',
    title: '一次性提交',
    desc: '改动先进右下角的队列，攒够一批再合成一次提交推上去。',
    href: '/admin/posts/edit/',
    action: '去编辑',
  },
  {
    icon: 'mdi:cog-outline',
    title: '网站设置',
    desc: '站点信息、个人信息、外观背景、首页组件、友情链接、随机一言、赞助页面、技术与集成。',
    href: '/admin/settings/site/',
    action: '去设置',
  },
];
---

<AdminLayout title="首页">
  <div data-admin-page="dashboard" data-admin-title="首页">
    <div class="admin-card">
      <div class="admin-card-inner">
        <h1 class="admin-page-title">{site.name}后台</h1>
        <p class="admin-page-desc">
          右上角连仓库，右下角看攒下的改动。点右上角的按钮填仓库地址与访问令牌即可开始。
        </p>
      </div>
    </div>

    <div class="admin-stats">
      {cards.map((card) => (
        <div class="admin-card admin-demo-card">
          <div class="admin-card-inner">
            <h2 class="admin-card-title">
              <Icon name={card.icon} class="admin-card-title-icon" />
              {card.title}
            </h2>
            <p class="admin-page-desc">{card.desc}</p>
            <div class="admin-toolbar">
              <a class="admin-btn link-plain" href={card.href}>
                <Icon name="mdi:arrow-right" class="admin-btn-icon" />
                {card.action}
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</AdminLayout>
