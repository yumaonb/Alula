---
// GlobalSidebar.astro — 文章区常驻侧边栏（作者卡 + 分类树 + 标签云）
// 用法：<GlobalSidebar tree={data.categoryTree} tags={data.tags} />
// 由 BaseLayout 渲染在 main#swup 之外（切页不重建）；显示与否由 global.css 按
// .page-main--* 变体与宽度决定；高亮与展开态首屏由本文件按 URL 算好，
// swup 切页后由 posts-shell.ts 同步（保留用户手动开合的节点）。
import AuthorCard from '../widgets/AuthorCard.astro';
import PostCategoryTree from './PostCategoryTree.astro';
import PostTagCloud from './PostTagCloud.astro';
import {
  activeCategoryOf,
  activeTagOf,
  buildCategoryUrl,
  buildTagUrl,
  postPathSegments,
  type CategoryTreeNode,
} from '../../lib/category';

interface Props {
  /** 分类树（来自 loadBlogData()） */
  tree?: CategoryTreeNode[];
  /** 标签计数（来自 loadBlogData()） */
  tags?: { name: string; count: number }[];
}

const { tree = [], tags = [] } = Astro.props;

const categoryTree = tree;

const catUrl = (path: string) => buildCategoryUrl(path.split('/'));

/* ---- 当前页对应的分类与标签（高亮 + 自动展开祖先） ---- */
// 收集分类树中全部分类路径，从 URL 解析出能匹配到分类的最长前缀
const allCatPaths = new Set<string>();
const collect = (nodes: CategoryTreeNode[]) => {
  for (const n of nodes) {
    allCatPaths.add(n.path);
    collect(n.children);
  }
};
collect(categoryTree);

const catSegments = postPathSegments(Astro.url.pathname);
const activeCategory = activeCategoryOf(catSegments, allCatPaths);

// 标签页还要确认标签真实存在（排除恰好叫 "tag" 的分类目录）
const tagCandidate = activeTagOf(catSegments);
const activeTag = tags.some((t) => t.name === tagCandidate) ? tagCandidate : '';
---

<aside class="global-sidebar posts-sidebar">
  <AuthorCard />

  <div class="sidebar-filter">
    {categoryTree.length > 0 && (
      <PostCategoryTree tree={categoryTree} categoryUrl={catUrl} activeCategory={activeCategory} />
    )}
    {tags.length > 0 && <PostTagCloud tags={tags} tagUrl={buildTagUrl} activeTag={activeTag} />}
  </div>
</aside>

<style>
  .global-sidebar {
    width: var(--posts-side-w, 260px);
    flex-shrink: 0;
    /* 拉伸到与内容列同高：让内部的 .sidebar-filter 有滚动行程，sticky 才能生效 */
    align-self: stretch;
    margin: 0;
    flex-direction: column;
    gap: var(--card-gap);
    z-index: 10;
  }

  /* 分类树 + 标签云：随页面滚动，滚到分类处再固定 */
  .sidebar-filter {
    position: sticky;
    top: 84px;
    display: flex;
    flex-direction: column;
    gap: var(--card-gap);
    max-height: calc(100vh - 104px);
    overflow-y: auto;
    scrollbar-width: thin;
  }
</style>
