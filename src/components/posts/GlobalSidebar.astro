---
// GlobalSidebar.astro — 文章区左侧边栏（分类树 + 标签云）
// 用法：<GlobalSidebar tree={data.categoryTree} tags={data.tags} activeTag={activeTag} />
import AuthorCard from '../widgets/AuthorCard.astro';
import PostCategoryTree from './PostCategoryTree.astro';
import PostTagCloud from './PostTagCloud.astro';
import { postRoute, type CategoryTreeNode } from '../../lib/category';

interface Props {
  /** 分类树（来自 loadBlogData()） */
  tree?: CategoryTreeNode[];
  /** 标签计数（来自 loadBlogData()） */
  tags?: { name: string; count: number }[];
  /** 当前所在标签（高亮用，可选） */
  activeTag?: string;
}

const { tree = [], tags = [], activeTag = '' } = Astro.props;

const categoryTree = tree;

const catUrl = (path: string) => `/${[postRoute, ...path.split('/')].join('/')}/`;
const tagUrl = (name: string) => `/${postRoute}/tag/${encodeURIComponent(name)}/`;

// ---- 当前页对应的分类（用于高亮 + 自动展开祖先） ----
// 收集分类树中全部分类路径，从 URL 解析出能匹配到分类的最长前缀
const allCatPaths = new Set<string>();
const collect = (nodes: CategoryTreeNode[]) => {
  for (const n of nodes) { allCatPaths.add(n.path); collect(n.children); }
};
collect(categoryTree);

const segments = Astro.url.pathname.replace(/\/+$/, '').split('/').filter(Boolean);
const rpIdx = segments.indexOf(postRoute);
const catSegments = rpIdx >= 0 ? segments.slice(rpIdx + 1) : segments;
let activeCategory = '';
for (let i = catSegments.length; i > 0; i--) {
  const candidate = decodeURIComponent(catSegments.slice(0, i).join('/'));
  if (allCatPaths.has(candidate)) { activeCategory = candidate; break; }
}
---

<aside class="global-sidebar posts-sidebar">
  <div class="sidebar-top"><slot name="top" /></div>
  <AuthorCard />

  <div class="sidebar-filter">
    {categoryTree.length > 0 && (
      <PostCategoryTree tree={categoryTree} categoryUrl={catUrl} activeCategory={activeCategory} />
    )}
    {tags.length > 0 && (
      <PostTagCloud tags={tags} tagUrl={tagUrl} activeTag={activeTag} />
    )}
  </div>
</aside>

<style>
  .global-sidebar {
    width: 260px;
    flex-shrink: 0;
    /* 拉伸到与内容列同高：让内部的 .sidebar-filter 有滚动行程，sticky 才能生效 */
    align-self: stretch;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    z-index: 10;
  }

  /* 面包屑行：不换行，放不下时向右延伸到文章区上方；空时不占位 */
  .sidebar-top {
    display: flex;
    align-items: center;
    overflow: visible;
    white-space: nowrap;
    min-height: 22px;
  }

  .sidebar-top:empty {
    display: none;
  }

  /* 分类树 + 标签云：随页面滚动，滚到分类处再固定 */
  .sidebar-filter {
    position: sticky;
    top: 84px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-height: calc(100vh - 104px);
    overflow-y: auto;
    scrollbar-width: thin;
  }
</style>
