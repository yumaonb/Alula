---
// PostsFilterFab.astro — 分类与标签悬浮按钮（文章区专属）
// 与 TocModal 的目录按钮同构：静态渲染在 BaseLayout 的 .side-widgets 按钮列里，
// 不用脚本搬运。仅手机端（≤768px，断点同 breakpoint.js）显示；桌面端隐藏。
// 显隐随滚动：滚过 100px 弹出、回到顶部收回，与其他悬浮按钮一致。
import { Icon } from 'astro-icon/components';
---

<button class="back-to-widget" id="posts-filter-fab" aria-label="分类与标签" aria-haspopup="dialog" aria-expanded="false">
  <Icon name="la:tags" class="back-to-widget-icon" />
</button>

<style>
  /* 桌面端不显示（桌面端由左侧边栏承载分类树/标签云） */
  @media (min-width: 769px) {
    #posts-filter-fab {
      display: none;
    }
  }
</style>

<script is:inline data-swup-ignore-script>
  // 只执行一次（BaseLayout 级）
  (function() {
    var fab = document.getElementById('posts-filter-fab');
    if (!fab || fab.dataset.pfabInit) return;
    fab.dataset.pfabInit = '1';

    var HIDE_AT_TOP = 100; // 与目录按钮一致：滚过 100px 才弹出

    // 文章区页面才可用；非文章区移除占位（.unavailable = display:none）
    function syncAvailability() {
      var onPosts = !!document.querySelector('.posts-sidebar');
      fab.classList.toggle('unavailable', !onPosts);
    }

    // 随滚动收起/展开：顶部收回、下滑弹出；切页时 BaseLayout 会先统一收回
    function updateVisibility() {
      fab.classList.toggle('visible', window.scrollY > HIDE_AT_TOP);
    }

    window.addEventListener('scroll', updateVisibility, { passive: true });
    document.addEventListener('swup:content:replace', function() {
      syncAvailability();
      updateVisibility();
    });

    syncAvailability();
    updateVisibility();
  })();
</script>
