---
// Repost.astro — 记录/来源组件
import { Icon } from 'astro-icon/components';
import { nickname } from '../../data/profile';
import { site } from '../../data/site';

interface Props {
  title: string;
  url?: string;
  date: string;
}

const { title, url = `https://${site.domain}${Astro.url.pathname}`, date } = Astro.props;
const licenseUrl = 'https://creativecommons.org/licenses/by-nc-sa/4.0/';
---

<div class="repost-card">
  <div class="repost-content">
    <h3 class="repost-title">{title}</h3>
    <a href={url} target="_blank" rel="noopener noreferrer" class="repost-url">{url}</a>
    <div class="repost-meta">
      <div class="repost-meta-item">
        <span class="repost-meta-label">作者</span>
        <span class="repost-meta-value">{nickname}</span>
      </div>
      <div class="repost-meta-item">
        <span class="repost-meta-label">发布于</span>
        <span class="repost-meta-value">{date}</span>
      </div>
      <div class="repost-meta-item">
        <span class="repost-meta-label">许可协议</span>
        <a href={licenseUrl} target="_blank" rel="noopener noreferrer" class="repost-meta-value repost-license">CC BY-NC-SA 4.0</a>
      </div>
    </div>
  </div>
  <div class="repost-cc-icon">
      <Icon name="la:creative-commons" />
  </div>
</div>

<style>
  .repost-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 28px;
    border-radius: var(--radius);
    margin-top: 32px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.88);
    position: relative;
    overflow: hidden;
  }
  .repost-content { flex: 1; min-width: 0; position: relative; z-index: 1; }
  .repost-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 8px 0;
  }
  .repost-url {
    display: block;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    word-break: break-all;
    margin-bottom: 16px;
    transition: color 0.2s;
  }
  .repost-url:hover {
    color: #fff;
  }
  .repost-meta { display: flex; gap: 32px; flex-wrap: wrap; }
  .repost-meta-item { display: flex; flex-direction: column; gap: 2px; }
  .repost-meta-label { font-size: 0.65rem; color: rgba(255, 255, 255, 0.6); line-height: 1.3; }
  .repost-meta-value {
    font-size: 0.8rem;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.88);
    text-decoration: none;
    transition: color 0.2s;
  }
  .repost-license { color: rgba(255, 255, 255, 0.85); text-decoration: none; }
  .repost-license:hover { color: #fff; }
  .repost-cc-icon {
    position: absolute;
    right: 24px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: rgba(255, 255, 255, 0.05);
    flex-shrink: 0;
  }
  .repost-cc-icon :global(svg) {
    width: 25rem;
    height: 25rem;
  }
  @media (max-width: 768px) {
    .repost-card { flex-direction: column; align-items: flex-start; padding: 20px; }
    .repost-cc-icon { right: -30px; }
    .repost-meta { gap: 25px; }
    .repost-cc-icon :global(svg) { width: 18rem; height: 18rem; }
  }
</style>