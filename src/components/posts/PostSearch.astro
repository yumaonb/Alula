---
// PostSearch.astro — 文章搜索框组件（玻璃样式，配合 post-listing.ts 做客户端搜索）
// 功能：实时过滤、清除按钮、Esc 清空、按 / 聚焦
// 搜索结果以下拉浮层形式展示在本输入框下方（结果由 post-listing.ts 渲染进 #post-search-dropdown）
import { Icon } from 'astro-icon/components';

interface Props {
  placeholder?: string;
}

const { placeholder = '搜索文章…' } = Astro.props;
---

<div class="post-search-wrap">
  <div class="post-search" id="post-search-box">
    <Icon name="la:search" class="post-search-icon" />
    <input
      type="search"
      id="post-search"
      class="post-search-input"
      placeholder={placeholder}
      autocomplete="off"
      spellcheck="false"
    />
    <button type="button" class="post-search-clear" aria-label="清空搜索" hidden>
      <Icon name="la:times" class="post-search-clear-icon" />
    </button>
    <kbd class="post-search-kbd" aria-hidden="true">/</kbd>
  </div>
  <!-- 搜索结果下拉浮层（内容由 post-listing.ts 渲染） -->
  <div class="post-search-dropdown" id="post-search-dropdown" hidden></div>
</div>

<script is:inline>
  // 事件全部委托到 document：swup 切页后无需重新绑定
  (function() {
    if (window.__postSearchBound) return;
    window.__postSearchBound = true;

    // swup 切页后新 #post-search 出现在 DOM 中，需要重新绑定 SearchController
    document.addEventListener('swup:content:replace', function() {
      if (typeof window.__initPostSearch === 'function') {
        window.__initPostSearch();
      }
    });

    // 输入时切换清除按钮/快捷键提示可见性（过滤由 post-listing.ts 处理）
    document.addEventListener('input', function(e) {
      if (!e.target || e.target.id !== 'post-search') return;
      var box = e.target.closest('.post-search');
      if (!box) return;
      var clearBtn = box.querySelector('.post-search-clear');
      var kbd = box.querySelector('.post-search-kbd');
      var has = e.target.value.length > 0;
      if (clearBtn) clearBtn.hidden = !has;
      if (kbd) kbd.style.display = has ? 'none' : '';
    });

    function clearSearch(input) {
      if (!input || !input.value) return;
      input.value = '';
      input.dispatchEvent(new Event('input', { bubbles: true }));
      input.focus();
    }

    // 清除按钮
    document.addEventListener('click', function(e) {
      var btn = e.target.closest ? e.target.closest('.post-search-clear') : null;
      if (!btn) return;
      var box = btn.closest('.post-search');
      var input = box && box.querySelector('.post-search-input');
      clearSearch(input);
    });

    document.addEventListener('keydown', function(e) {
      // Esc 清空当前搜索框
      if (e.key === 'Escape' && e.target && e.target.id === 'post-search') {
        clearSearch(e.target);
        return;
      }
      // 按 / 快速聚焦（不在输入框时）
      if (e.key !== '/') return;
      var t = e.target;
      if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
      var input = document.getElementById('post-search');
      if (input) {
        e.preventDefault();
        input.focus();
      }
    });
  })();
</script>

<style>
  .post-search {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.1),
      0 4px 16px rgba(0, 0, 0, 0.2);
    transition: box-shadow 0.25s ease, background 0.25s ease;
  }

  .post-search:focus-within {
    background: rgba(255, 255, 255, 0.08);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.3),
      0 4px 16px rgba(0, 0, 0, 0.2);
  }

  .post-search-icon {
    width: 15px;
    height: 15px;
    color: rgba(255, 255, 255, 0.4);
    flex-shrink: 0;
  }

  .post-search-input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    color: #fff;
    font: inherit;
    font-size: 0.88rem;
  }

  .post-search-input::placeholder {
    color: rgba(255, 255, 255, 0.35);
  }

  .post-search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .post-search-clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .post-search-clear:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.2);
  }

  .post-search-clear[hidden] {
    display: none;
  }

  .post-search-clear-icon {
    width: 10px;
    height: 10px;
  }

  .post-search-kbd {
    flex-shrink: 0;
    min-width: 18px;
    height: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.4);
    font-family: inherit;
    font-size: 0.7rem;
    line-height: 1;
  }

  /* 手机端隐藏 / 快捷键提示（触屏无键盘） */
  @media (max-width: 768px) {
    .post-search-kbd {
      display: none;
    }
  }
</style>
