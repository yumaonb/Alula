---
// BackToComments.astro — 到评论按钮
import { Icon } from 'astro-icon/components';
---

<button class="back-to-widget" id="back-to-comments" aria-label="到评论">
  <Icon name="la:comment" class="back-to-widget-icon" />
</button>

<script is:inline data-swup-ignore-script>
(function() {
  var btn = document.getElementById('back-to-comments');
  if (!btn) return;

  var settleTimer = null;
  var lastHiddenAt = 0;

  /* 占位增减推迟到按钮完全收回后应用，避免其余按钮跳动聚拢 */
  function syncAvailability(hasTarget) {
    var wantUnavailable = !hasTarget;
    if (btn.classList.contains('unavailable') === wantUnavailable) return;

    var settled = !btn.classList.contains('visible') && Date.now() - lastHiddenAt > 300;
    if (!settled) {
      if (!settleTimer) {
        settleTimer = setTimeout(function() {
          settleTimer = null;
          toggleBtn();
        }, 400);
      }
      return;
    }
    btn.classList.toggle('unavailable', wantUnavailable);
  }

  function toggleBtn() {
    var hasTarget = !!document.getElementById('comments-section');
    syncAvailability(hasTarget);

    var wasShown = btn.classList.contains('visible');
    btn.classList.toggle('visible', hasTarget && window.scrollY > 100);
    if (wasShown && !btn.classList.contains('visible')) lastHiddenAt = Date.now();
  }

  btn.addEventListener('click', function() {
    var target = document.getElementById('comments-section');
    if (!target) return;
    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  window.addEventListener('scroll', toggleBtn, { passive: true });
  toggleBtn();
})();
</script>