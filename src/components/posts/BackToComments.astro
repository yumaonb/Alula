---
// BackToComments.astro — 到评论按钮
import { Icon } from 'astro-icon/components';
---

<button class="back-to-widget" id="back-to-comments" aria-label="到评论">
  <Icon name="la:comment" class="back-to-widget-icon" />
</button>

<script is:inline>
(function() {
  var btn = document.getElementById('back-to-comments');
  if (!btn) return;

  function toggleBtn() {
    var hasTarget = !!document.getElementById('comments-section');
    btn.classList.toggle('visible', hasTarget && window.scrollY > 100);
  }

  btn.addEventListener('click', function() {
    var target = document.getElementById('comments-section');
    if (!target) return;
    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  window.addEventListener('scroll', toggleBtn, { passive: true });
  toggleBtn();
})();
</script>

<style>
  .back-to-widget { bottom: 160px; }
</style>