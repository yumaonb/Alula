---
// ImageWrapper.astro — 图片包装：本地图片走 astro:assets 压缩，外链原样渲染
// 用法：<ImageWrapper src={...} basePath={...} alt={...} sizes={...} widths={...} />
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import {
  contentImageGlob,
  resolveContentImageKey,
  imageKeyToSourcePath,
} from '../../lib/content-image';

interface Props {
  src: string;
  alt?: string;
  class?: string;
  basePath?: string;
  style?: string;
  /** 图片的固定显示宽度（CSS 像素）。锚定后窗口缩放不会切换 srcset 候选 */
  sizes?: string;
  /** srcset 候选宽度（px），应覆盖 1x/2x DPR */
  widths?: number[];
}

const { src, alt = '', basePath = '/', style, sizes, widths } = Astro.props;
const className = Astro.props.class;

const isLocal = !(
  src.startsWith('/') ||
  src.startsWith('http') ||
  src.startsWith('https') ||
  src.startsWith('data:')
);

let img: ImageMetadata | undefined;

if (isLocal) {
  const normalizedPath = resolveContentImageKey(basePath, src);

  const file = contentImageGlob[normalizedPath];
  if (file) {
    img = await file();
  } else {
    console.error(`[ImageWrapper] 图片文件未找到：${imageKeyToSourcePath(normalizedPath)}`);
  }
}

// 尺寸不在这里定：由各调用处的容器规则负责（`.post-cover img` / `.post-card-cover img`），
// 传了 class 才透传，避免组件自带一套和容器打架的默认尺寸
const imageClass = className;
---

{isLocal && img && (
  <Image src={img} alt={alt} class={imageClass} style={style} sizes={sizes} widths={widths} />
)}
{!isLocal && (
  <img src={src} alt={alt} class={imageClass} loading="lazy" decoding="async" style={style} />
)}
