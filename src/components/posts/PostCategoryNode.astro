---
// PostCategoryNode.astro — 分类树节点（递归组件，配合 PostCategoryTree 使用）
import { Icon } from 'astro-icon/components';
import type { CategoryTreeNode } from '../../lib/category';
// 递归渲染子分类：Astro 中自引用需显式 import 自身
import Self from './PostCategoryNode.astro';

interface Props {
  node: CategoryTreeNode;
  depth: number;
  /** 当前选中的分类路径（slug 用 / 连接），空串表示全部 */
  activeCategory?: string;
  /** 为 true 时分类项渲染为链接（导航到分类页），否则为筛选按钮 */
  linkMode?: boolean;
  /** linkMode 下生成分类链接的函数 */
  categoryUrl?: (path: string) => string;
}

const { node, depth, activeCategory = '', linkMode = false, categoryUrl } = Astro.props;

const hasChildren = node.children.length > 0;
const isActive = node.path === activeCategory;
// 当前选中分类位于该节点子树内时自动展开
const isOpen = hasChildren
  && (activeCategory === node.path || activeCategory.startsWith(node.path + '/'));
const url = linkMode && categoryUrl ? categoryUrl(node.path) : '';
---

<li class:list={['cat-node', { 'cat-node--open': isOpen }]}>
  <div class="cat-row" style={`--depth:${depth}`}>
    {linkMode ? (
      <a href={url} class:list={['cat-item', { 'cat-item--active': isActive }]} data-category={node.path}>
        <span class="cat-name">{node.name}</span>
        <span class="cat-count">{node.count}</span>
      </a>
    ) : (
      <button type="button" class:list={['cat-item', { 'cat-item--active': isActive }]} data-category={node.path}>
        <span class="cat-name">{node.name}</span>
        <span class="cat-count">{node.count}</span>
      </button>
    )}
    {hasChildren && (
      <button
        type="button"
        class="cat-toggle"
        aria-label={isOpen ? '收起子分类' : '展开子分类'}
        aria-expanded={isOpen ? 'true' : 'false'}
      >
        <Icon name="la:chevron-right" class="cat-toggle-icon" />
      </button>
    )}
  </div>

  {hasChildren && (
    <ul class="cat-children" hidden={!isOpen}>
      {node.children.map(child => (
        <Self
          node={child}
          depth={depth + 1}
          activeCategory={activeCategory}
          linkMode={linkMode}
          categoryUrl={categoryUrl}
        />
      ))}
    </ul>
  )}
</li>

<style>
  .cat-node {
    list-style: none;
  }

  .cat-row {
    display: flex;
    align-items: center;
    gap: 2px;
    /* 层级缩进 */
    padding-left: calc(10px + var(--depth) * 14px);
  }

  /* .cat-item / .cat-name / .cat-count 样式见 assets/css/posts-listing.css */

  /* 展开/收起箭头 */
  .cat-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    padding: 0;
    border: none;
    border-radius: 5px;
    background: transparent;
    color: rgba(255, 255, 255, 0.35);
    cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .cat-toggle:hover {
    color: rgba(255, 255, 255, 0.8);
    background: rgba(255, 255, 255, 0.08);
  }

  .cat-toggle-icon {
    width: 12px;
    height: 12px;
    transition: transform 0.2s ease;
  }

  .cat-node--open > .cat-row .cat-toggle-icon {
    transform: rotate(90deg);
  }

  .cat-children {
    margin: 0;
    padding: 0;
  }
</style>
