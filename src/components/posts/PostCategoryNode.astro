---
// PostCategoryNode.astro — 分类树节点（递归组件）
// 用法：<PostCategoryNode node={...} depth={...} ... />（由 PostCategoryTree 递归渲染）
import { Icon } from 'astro-icon/components';
import type { CategoryTreeNode } from '../../lib/category';
import Self from './PostCategoryNode.astro';

interface Props {
  node: CategoryTreeNode;
  depth: number;
  activeCategory?: string;
  linkMode?: boolean;
  categoryUrl?: (path: string) => string;
}

const { node, depth, activeCategory = '', linkMode = false, categoryUrl } = Astro.props;

const hasChildren = node.children.length > 0;
const isActive = node.path === activeCategory;
const isOpen =
  hasChildren && (activeCategory === node.path || activeCategory.startsWith(node.path + '/'));
const url = linkMode && categoryUrl ? categoryUrl(node.path) : '';
---

<li class:list={['cat-node', { 'cat-node--open': isOpen }]}>
  <div class="cat-row" style={`--depth:${depth}`}>
    {linkMode ? (
      <a
        href={url}
        class:list={['cat-item', 'link-plain', { 'cat-item--active': isActive }]}
        data-category={node.path}
      >
        <span class="cat-name">{node.name}</span>
      </a>
    ) : (
      <button
        type="button"
        class:list={['cat-item', { 'cat-item--active': isActive }]}
        data-category={node.path}
      >
        <span class="cat-name">{node.name}</span>
      </button>
    )}
    {hasChildren && (
      <button
        type="button"
        class="cat-toggle"
        aria-label={isOpen ? '收起' : '展开'}
        aria-expanded={isOpen ? 'true' : 'false'}
      >
        <Icon is:inline name="la:angle-right" class="cat-toggle-icon" />
      </button>
    )}
  </div>

  {hasChildren && (
    <div class="cat-children-wrap">
      <ul class="cat-children">
        {node.children.map((child) => (
          <Self
            node={child}
            depth={depth + 1}
            activeCategory={activeCategory}
            linkMode={linkMode}
            categoryUrl={categoryUrl}
          />
        ))}
      </ul>
    </div>
  )}
</li>

<style>
  .cat-node {
    list-style: none;
  }

  .cat-row {
    display: flex;
    align-items: center;
    gap: 0;
    padding: 2px 0;
    padding-left: calc(var(--depth) * 14px);
  }

  /* 右侧展开按钮 */
  .cat-toggle {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    margin-left: auto;
    padding: 0;
    border: none;
    border-radius: 5px;
    background: transparent;
    color: var(--icon-ink);
    cursor: pointer;
    transition: color 0.15s ease;
  }

    .cat-toggle-icon {
    width: 13px;
    height: 13px;
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .cat-node--open > .cat-row .cat-toggle-icon {
    transform: rotate(90deg);
  }

  .cat-node--open > .cat-row .cat-toggle {
    color: var(--icon-hover);
  }

  /* 展开容器：让出/收回空间的那扇「窗」。开合动效由 motion 驱动（category-tree.ts），
   * max-height 只改窗口大小，内层恒为天然高度、任何一帧都不被压缩；
   * 这里只定义开/关端点状态；上限取 --cat-sub-h（category-tree.ts 量出的内容实高），600px 兜底只服务无 JS / 首次量高之前 */
  .cat-children-wrap {
    max-height: 0;
    overflow: hidden;
  }

  .cat-node--open > .cat-children-wrap {
    max-height: var(--cat-sub-h, 600px);
  }

  /* 内层：整组子项作为刚体，从父项底下滑出/收回（位移同样由 motion 驱动） */
  .cat-children {
    margin: 0;
    padding: 0;
    list-style: none;
    transform: translateY(-100%);
  }

  .cat-node--open > .cat-children-wrap > .cat-children {
    transform: translateY(0);
  }
</style>
