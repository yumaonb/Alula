---
// PostCategoryNode.astro — 分类树节点（递归组件）
// 用法：<PostCategoryNode node={...} depth={...} ... />（由 PostCategoryTree 递归渲染）
import { Icon } from 'astro-icon/components';
import type { CategoryTreeNode } from '../../lib/category';
import Self from './PostCategoryNode.astro';

interface Props {
  node: CategoryTreeNode;
  depth: number;
  activeCategory?: string;
  linkMode?: boolean;
  categoryUrl?: (path: string) => string;
}

const { node, depth, activeCategory = '', linkMode = false, categoryUrl } = Astro.props;

const hasChildren = node.children.length > 0;
const isActive = node.path === activeCategory;
const isOpen =
  hasChildren && (activeCategory === node.path || activeCategory.startsWith(node.path + '/'));
const url = linkMode && categoryUrl ? categoryUrl(node.path) : '';
---

<li class:list={['cat-node', { 'cat-node--open': isOpen }]}>
  <div class="cat-row" style={`--depth:${depth}`}>
    {linkMode ? (
      <a
        href={url}
        class:list={['cat-item', { 'cat-item--active': isActive }]}
        data-category={node.path}
      >
        <span class="cat-name">{node.name}</span>
      </a>
    ) : (
      <button
        type="button"
        class:list={['cat-item', { 'cat-item--active': isActive }]}
        data-category={node.path}
      >
        <span class="cat-name">{node.name}</span>
      </button>
    )}
    {hasChildren && (
      <button
        type="button"
        class="cat-toggle"
        aria-label={isOpen ? '收起' : '展开'}
        aria-expanded={isOpen ? 'true' : 'false'}
      >
        <Icon name="la:angle-right" class="cat-toggle-icon" />
      </button>
    )}
  </div>

  {hasChildren && (
    <div class="cat-children-wrap">
      <ul class="cat-children">
        {node.children.map((child) => (
          <Self
            node={child}
            depth={depth + 1}
            activeCategory={activeCategory}
            linkMode={linkMode}
            categoryUrl={categoryUrl}
          />
        ))}
      </ul>
    </div>
  )}
</li>

<style>
  .cat-node {
    list-style: none;
  }

  .cat-row {
    display: flex;
    align-items: center;
    gap: 0;
    padding: 2px 0;
    padding-left: calc(var(--depth) * 14px);
  }

  /* 右侧展开按钮 */
  .cat-toggle {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    margin-left: auto;
    padding: 0;
    border: none;
    border-radius: 5px;
    background: transparent;
    color: rgba(255, 255, 255, 0.55);
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .cat-toggle:hover {
    color: #fff;
  }

  .cat-toggle-icon {
    width: 13px;
    height: 13px;
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .cat-node--open > .cat-row .cat-toggle-icon {
    transform: rotate(90deg);
  }

  .cat-node--open > .cat-row .cat-toggle {
    color: rgba(255, 255, 255, 0.85);
  }

  /* 子分类展开动画：grid-template-rows 精确贴合实际高度 */
  .cat-children-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .cat-node--open > .cat-children-wrap {
    grid-template-rows: 1fr;
  }

  .cat-children {
    margin: 0;
    padding: 0;
    list-style: none;
    overflow: hidden;
    min-height: 0;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .cat-node--open > .cat-children-wrap > .cat-children {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .cat-children {
      transition: none;
    }
    .cat-toggle-icon {
      transition: none;
    }
  }
</style>
