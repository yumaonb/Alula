---
// PostCategoryTree.astro — 分类树面板（点击展开/收起，点分类名跳转）
// 用法：<PostCategoryTree tree={...} categoryUrl={...} activeCategory={...} />
import { Icon } from 'astro-icon/components';
import PostCategoryNode from './PostCategoryNode.astro';
import type { CategoryTreeNode } from '../../lib/category';

interface Props {
  tree: CategoryTreeNode[];
  categoryUrl: (path: string) => string;
  activeCategory?: string;
}

const { tree, categoryUrl, activeCategory = '' } = Astro.props;
---

<section class="cat-panel glass">
  <h2 class="cat-panel-title">
    <Icon is:inline name="la:layer-group" class="cat-panel-icon" />
    分类
  </h2>

  <!-- data-cat-init：首屏高度还没量完时的动画锁（在位期间开合不播动画、直接落位），量完由 category-tree.ts 摘掉 -->
  <div class="cat-panel-body" id="category-tree" data-cat-init>
    <ul class="cat-root-list">
      {tree.map((node) => (
        <PostCategoryNode
          node={node}
          depth={0}
          activeCategory={activeCategory}
          linkMode={true}
          categoryUrl={categoryUrl}
        />
      ))}
    </ul>
  </div>
</section>

<style>
  .cat-panel {
    padding: 14px 12px;
    border-radius: var(--radius);
  }

  .cat-panel-title {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text);
    margin-bottom: 8px;
    padding-left: 4px;
  }

  .cat-panel-icon {
    width: 11px;
    height: 11px;
    color: var(--icon-ink);
  }

  .cat-panel-body {
    display: flex;
    flex-direction: column;
  }

  .cat-root-list {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
</style>
