---
// PostCategoryTree.astro — 分类树面板
// 点击右侧箭头展开/收起子分类，点击分类名跳转
import { Icon } from 'astro-icon/components';
import PostCategoryNode from './PostCategoryNode.astro';
import type { CategoryTreeNode } from '../../lib/category';

interface Props {
  tree: CategoryTreeNode[];
  categoryUrl: (path: string) => string;
  activeCategory?: string;
}

const { tree, categoryUrl, activeCategory = '' } = Astro.props;
---

<section class="cat-panel glass">
  <h2 class="cat-panel-title">
    <Icon name="la:layer-group" class="cat-panel-icon" />
    分类
  </h2>

  <div class="cat-panel-body" id="category-tree">
    <ul class="cat-root-list">
      {tree.map(node => (
        <PostCategoryNode
          node={node}
          depth={0}
          activeCategory={activeCategory}
          linkMode={true}
          categoryUrl={categoryUrl}
        />
      ))}
    </ul>
  </div>
</section>

<script is:inline>
  // 点击右侧展开按钮切换子分类，不影响分类名链接的导航
  (function() {
    if (window.__postCatTreeBound) return;
    window.__postCatTreeBound = true;
    document.addEventListener('click', function(e) {
      var btn = e.target.closest ? e.target.closest('button.cat-toggle') : null;
      if (!btn || !document.contains(btn)) return;
      var node = btn.closest('.cat-node');
      if (!node) return;
      e.preventDefault();
      e.stopPropagation();
      node.classList.toggle('cat-node--open');
      btn.setAttribute('aria-expanded',
        node.classList.contains('cat-node--open') ? 'true' : 'false');
    });
  })();
</script>

<style>
  .cat-panel {
    padding: 14px 12px;
    border-radius: var(--radius);
  }

  .cat-panel-title {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.3);
    margin-bottom: 8px;
    padding-left: 4px;
  }

  .cat-panel-icon {
    width: 11px;
    height: 11px;
    color: rgba(255, 255, 255, 0.3);
  }

  .cat-panel-body {
    display: flex;
    flex-direction: column;
  }

  .cat-root-list {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
</style>
