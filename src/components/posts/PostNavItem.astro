---
// PostNavItem.astro — 上一篇 / 下一篇导航单卡（有目标文章渲染链接，否则渲染不可点占位）
// 用法：<PostNavItem dir="prev" post={navPost} />
import { Icon } from 'astro-icon/components';

interface Props {
  /** prev = 上一篇，next = 下一篇：决定图标与文字顺序 */
  dir: 'prev' | 'next';
  /** 目标文章；为空渲染占位卡 */
  post?: { title: string; url: string } | null;
}

const { dir, post = null } = Astro.props;
const icon = dir === 'prev' ? 'la:arrow-left' : 'la:arrow-right';
const titleText = dir === 'prev' ? '上一篇' : '下一篇';
---

{post ? (
  <a href={post.url} class={`post-nav-item post-nav-${dir} glass hoverable link-plain`} rel={dir}>
    <span class="post-nav-label">
      {dir === 'prev' && <Icon is:inline name={icon} class="post-nav-icon" />}
      {titleText}
      {dir === 'next' && <Icon is:inline name={icon} class="post-nav-icon" />}
    </span>
    <span class="post-nav-title">{post.title}</span>
  </a>
) : (
  <span class={`post-nav-item post-nav-empty post-nav-${dir} glass`}>
    <span class="post-nav-label">
      {dir === 'prev' && <Icon is:inline name={icon} class="post-nav-icon" />}
      {titleText}
      {dir === 'next' && <Icon is:inline name={icon} class="post-nav-icon" />}
    </span>
    <span class="post-nav-title">没有更多文章了</span>
  </span>
)}
