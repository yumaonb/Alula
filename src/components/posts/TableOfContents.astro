---
// TableOfContents.astro — 文章目录（编译期生成，滚动高亮）
// 用法：<TableOfContents headings={headings} />
import { Icon } from 'astro-icon/components';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

const hasH1 = headings.some((h) => h.depth === 1);
const hasH2 = headings.some((h) => h.depth === 2);
const hasH3 = headings.some((h) => h.depth === 3);

let tocItems: Heading[] = [];

if (hasH1 && hasH2) {
  tocItems = headings.filter((h) => h.depth <= 2);
} else if (hasH2 && hasH3) {
  tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
} else if (hasH1) {
  tocItems = headings.filter((h) => h.depth === 1);
} else if (hasH2) {
  tocItems = headings.filter((h) => h.depth === 2);
} else if (hasH3) {
  tocItems = headings.filter((h) => h.depth === 3);
}
---

{tocItems.length > 0 && (
  <nav class="toc-nav" aria-label="文章目录">
    <div class="toc-header">
      <Icon name="la:list" class="toc-icon" />
      <span>文章目录</span>
    </div>
    <div class="toc-track" id="toc-list">
      <div class="toc-active-bar" id="toc-bar"></div>
      <ul class="toc-list">
        {tocItems.map((heading) => (
          <li
            class:list={['toc-item', { 'toc-sub': heading.depth > tocItems[0].depth }]}
            data-target={heading.slug}
          >
            <a class="toc-link link-plain" data-target={heading.slug}>
              {heading.text.replace(/\s*#$/, '')}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
)}

<script>
  import '../../assets/js/toc';
</script>

<style>
  .toc-nav {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .toc-header {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .toc-icon {
    width: 14px;
    height: 14px;
    opacity: 0.55;
  }

  .toc-track {
    position: relative;
    max-height: calc(100vh - 211px);
    overflow-y: auto;
    overflow-x: hidden;
    padding-left: 6px;
  }

  .toc-track::-webkit-scrollbar {
    width: 2px;
  }
  .toc-track::-webkit-scrollbar-track {
    background: transparent;
  }
  .toc-track::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
  }

  .toc-active-bar {
    position: absolute;
    left: 0;
    width: 2px;
    background: rgba(255, 255, 255, 0.85);
    pointer-events: none;
    z-index: 1;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .toc-item {
    border-radius: 4px;
  }

  .toc-link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--icon-ink);
    text-decoration: none;
    border-radius: 4px;
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.15s;
  }

  .toc-sub .toc-link {
    padding-left: 24px;
    font-size: 0.76rem;
    color: var(--icon-ink);
  }

  /* 悬停不走全站 .hoverable（那会加白底描边）：
   * 只提亮文字、不要轮廓，统一走亮色令牌。
   * 两条都排在 .active 规则之前，悬停在活动项上时规则一致。 */
  .toc-link:hover,
  .toc-link:focus-visible {
    color: var(--icon-hover);
  }

  .toc-sub .toc-link:hover,
  .toc-sub .toc-link:focus-visible {
    color: var(--icon-hover);
  }

  .toc-item.active .toc-link {
    color: var(--icon-hover);
    font-weight: 500;
  }

  .toc-sub.active .toc-link {
    font-weight: 400;
  }
</style>
