---
// PostCard.astro — 文章卡片组件（整个卡片可点击）
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  date: string;
  description?: string;
  image?: string;
  tags?: string[];
  pinned?: boolean;
  url: string;
  category?: string;
}

const { title, date, description, image, tags = [], pinned = false, url, category } = Astro.props;

function formatDate(dateStr: string): string {
  const d = new Date(dateStr);
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}
---

<a href={url} class="post-card glass">
  {image && (
    <div class="post-card-cover">
      <img src={image} alt={title} loading="lazy" />
    </div>
  )}
  <div class="post-card-body">
    <div class="post-card-meta">
      {pinned && (
        <span class="post-card-pin">
          <Icon name="la:thumbtack" class="pin-icon" />
        </span>
      )}
      <h3 class="post-card-title">{title}</h3>
    </div>
    <div class="post-card-sub">
      <time class="post-card-date" datetime={date}>{formatDate(date)}</time>
      {category && (
        <span class="post-card-category">{category}</span>
      )}
    </div>
    {description && (
      <p class="post-card-desc">{description}</p>
    )}
    {tags.length > 0 && (
      <div class="post-card-tags">
        {tags.map(tag => (
          <span class="post-card-tag">{tag}</span>
        ))}
      </div>
    )}
  </div>
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: row;
    border-radius: var(--radius);
    overflow: hidden;
    transition: filter 0.3s ease, box-shadow 0.3s ease;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .post-card::before {
    display: none;
  }

  .post-card:hover {
    filter: brightness(1.15);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
  }

  .post-card-cover {
    display: block;
    width: 280px;
    flex-shrink: 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    align-self: stretch;
  }

  .post-card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-card-body {
    flex: 1;
    min-width: 0;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .post-card-pin {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .pin-icon {
    width: 14px;
    height: 14px;
  }

  .post-card-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.4;
    margin: 0;
  }

  .post-card-sub {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .post-card-date {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.45);
  }

  .post-card-category {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.65);
    background: rgba(255, 255, 255, 0.08);
    padding: 2px 8px;
    border-radius: 4px;
  }

  .post-card-desc {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }

  .post-card-tag {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.06);
    padding: 3px 8px;
    border-radius: 4px;
  }

  @media (max-width: 768px) {
    /* 手机端恢复上下结构：封面整宽在上，内容在下 */
    .post-card { flex-direction: column; }
    .post-card-cover { width: 100%; aspect-ratio: 16 / 9; }
    .post-card-body { padding: 16px; }
    .post-card-title { font-size: 1rem; }
  }
</style>