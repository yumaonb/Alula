---
// PostCard.astro — 文章卡片
//
// 布局参考 Fuwari 主题的文章卡片（保留本站暗色玻璃风格，非直接移植）：
//   - 标题前主色竖条（accent bar）为白色，配合本站白字主题；
//   - 元信息行（日期 / 分类 / 字数 / 评论数）带图标，图标与文章详情页一致；
//   - 桌面端：封面固定在卡片右侧（约 28% 宽，图片拉伸铺满），
//     无封面时右侧显示「进入」按钮；
//   - 手机端：封面移到顶部，accent bar 与「进入」按钮隐藏，正文完整保留。
//
// 卡片整体可点击（stretched-link 模式），分类链做成独立链接指向各级分类页。
import { Icon } from 'astro-icon/components';
import ImageWrapper from './ImageWrapper.astro';
import type { CategoryTrailItem } from '../../lib/category';

interface Props {
  title: string;
  /** 已格式化日期（YYYY-MM-DD），空串不显示 */
  date: string;
  description?: string;
  image?: string;
  basePath?: string;
  tags?: string[];
  pinned?: boolean;
  url: string;
  /** 完整分类链（父分类 → … → 当前分类）；不传则只显示日期/字数/评论数 */
  categoryTrail?: CategoryTrailItem[];
  /** 评论数；不传（数据不可用）则不显示 */
  commentCount?: number;
  /** 估算字数；不传则不显示（放在评论数前） */
  words?: number;
}

const {
  title,
  date,
  description,
  image,
  basePath = "/",
  tags = [],
  pinned = false,
  url,
  categoryTrail,
  commentCount,
  words,
} = Astro.props;

const hasCover = !!image;
const hasStats = typeof words === 'number' && words > 0;
const trail = categoryTrail || [];
const hasCategory = trail.length > 0;
const hasMeta = !!date || hasCategory || hasStats || commentCount !== undefined;
---

<article class:list={["post-card glass", { "has-cover": hasCover }]}>
  <!-- 全卡片点击层 -->
  <a href={url} class="post-card-link" aria-label={title}></a>

  <!-- 封面图（桌面在右 / 手机在顶部） -->
  {hasCover && (
    <div class="post-card-cover" aria-hidden="true">
      <span class="cover-ph-icon"><Icon name="mdi:image-outline" /></span>
      <ImageWrapper src={image!} basePath={basePath} alt={title} />
      <span class="cover-overlay">
        <Icon name="mdi:chevron-right" class="cover-chevron" />
      </span>
    </div>
  )}

  <!-- 无封面时的「进入」按钮（桌面端，纯装饰：整卡已是链接） -->
  {!hasCover && (
    <span class="post-card-enter" aria-hidden="true">
      <Icon name="mdi:chevron-right" class="post-card-enter-icon" />
    </span>
  )}

  <!-- 正文 -->
  <div class="post-card-body">
    <div class="post-card-head">
      <span class="post-card-accent" aria-hidden="true"></span>
      {pinned && (
        <span class="post-card-pin" title="置顶">
          <Icon name="la:thumbtack" class="pin-icon" />
        </span>
      )}
      <h3 class="post-card-title">{title}</h3>
    </div>

    {hasMeta && (
      <div class="post-card-meta">
        {date && (
          <span class="post-card-meta-item">
            <Icon name="la:calendar" class="meta-icon" />
            <time datetime={date}>{date}</time>
          </span>
        )}
        {hasCategory && (
          <span class="post-card-meta-item">
            <Icon name="la:layer-group" class="meta-icon" />
            <span class="post-card-categories">
              {trail.map((item, i) => (
                <span class="post-card-cat-item">
                  {i > 0 && <span class="post-card-cat-sep" aria-hidden="true">/</span>}
                  <a href={item.url} class="post-card-category" title={`分类：${item.name}`}>{item.name}</a>
                </span>
              ))}
            </span>
          </span>
        )}
        {hasStats && (
          <span class="post-card-meta-item" title={`${words} 字`}>
            <Icon name="la:file-alt" class="meta-icon" />
            <span>{words} 字</span>
          </span>
        )}
        {commentCount !== undefined && (
          <span class="post-card-meta-item" title={`${commentCount} 条评论`}>
            <Icon name="la:comments" class="meta-icon" />
            <span>{commentCount}</span>
          </span>
        )}
      </div>
    )}

    {description && (
      <p class="post-card-desc">{description}</p>
    )}

    {tags.length > 0 && (
      <div class="post-card-tags">
        {tags.map((tag) => (
          <a
            href={`/posts/tag/${encodeURIComponent(tag)}/`}
            class="post-card-tag"
            title={`标签：${tag}`}
          >{tag}</a>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  /* ---- 卡片骨架 ---- */
  .post-card {
    position: relative;
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    transition: filter 0.3s ease, box-shadow 0.3s ease;
  }

  .post-card:hover {
    filter: brightness(1.15);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
  }

  /* 全卡片点击层：抵消全局链接样式的干扰 */
  .post-card-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    padding: 0;
    border-radius: 0;
    overflow: visible;
  }

  .post-card-link::before {
    display: none;
  }

  /* ---- 正文（在点击层之上；整体不拦截点击，仅分类链接可点） ---- */
  .post-card-body {
    position: relative;
    z-index: 2;
    pointer-events: none;
    padding: 18px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    box-sizing: border-box;
  }

  /* 桌面端：有封面留出右侧封面位；无封面留出「进入」按钮位 */
  .has-cover .post-card-body {
    padding-right: calc(28% + 36px);
  }

  .post-card:not(.has-cover) .post-card-body {
    padding-right: calc(52px + 28px);
  }

  .post-card-head {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* ---- 白色竖条（标题前，参考 Fuwari） ---- */
  .post-card-accent {
    flex-shrink: 0;
    width: 4px;
    height: 1.15em;
    min-height: 16px;
    border-radius: 4px;
    background: #fff;
  }

  .post-card-pin {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    color: #fff;
  }

  .pin-icon {
    width: 14px;
    height: 14px;
  }

  .post-card-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.4;
    margin: 0;
    flex: 1;
    min-width: 0;
  }

  /* ---- 元信息行：日期 / 分类 / 评论数（图标与详情页一致） ---- */
  .post-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 16px;
  }

  .post-card-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
    white-space: nowrap;
  }

  .meta-icon {
    width: 15px;
    height: 15px;
    opacity: 0.6;
    flex-shrink: 0;
    position: relative;
    top: -1px;
  }

  .post-card-categories {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    column-gap: 4px;
    row-gap: 2px;
    white-space: normal;
  }

  .post-card-cat-item {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .post-card-cat-sep {
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.85em;
  }

  .post-card-category {
    /* 抵消全局链接样式 + 卡片正文 pointer-events:none，链接单独可点击 */
    display: inline;
    padding: 0;
    border-radius: 0;
    position: static;
    overflow: visible;
    pointer-events: auto;
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    transition: color 0.2s;
  }

  .post-card-category::before {
    display: none;
  }

  .post-card:hover .post-card-category {
    color: #fff;
  }

  .post-card-desc {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .post-card-tag {
    display: inline-block;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.06);
    padding: 3px 8px;
    border-radius: 4px;
    text-decoration: none;
    position: relative;
    z-index: 3;
    pointer-events: auto;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .post-card-tag:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.12);
  }

  /* ---- 「进入」按钮（无封面时，桌面端右侧） ---- */
  .post-card-enter {
    position: absolute;
    top: 12px;
    right: 12px;
    bottom: 12px;
    width: 52px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.06);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
    transition: background 0.25s ease, box-shadow 0.25s ease;
  }

  .post-card:hover .post-card-enter {
    background: rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 0 0 1px #fff;
  }

  .post-card-enter-icon {
    width: 1.9rem;
    height: 1.9rem;
    color: #fff;
    transform: translateX(-2px);
    transition: transform 0.25s ease;
  }

  .post-card:hover .post-card-enter-icon {
    transform: translateX(0);
  }

  /* ---- 封面图（桌面：右侧固定区域） ---- */
  .post-card-cover {
    position: absolute;
    top: 12px;
    right: 12px;
    bottom: 12px;
    width: 28%;
    z-index: 2;
    pointer-events: none;
    display: none;
    border-radius: 12px;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.06);
  }

  .has-cover .post-card-cover {
    display: block;
  }

  .post-card-cover img {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: fill; /* 封面不符合尺寸时拉伸铺满 */
    display: block;
    transition: transform 0.3s ease;
  }

  .post-card:hover .post-card-cover img {
    transform: scale(1.02);
  }

  /* 封面悬停遮罩 + 箭头（深灰半透明，接近 fuwari 的观感） */
  .cover-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.45);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .post-card:hover .cover-overlay {
    opacity: 1;
  }

  .cover-chevron {
    width: 2.5rem;
    height: 2.5rem;
    color: #fff;
    transform: translateX(-6px);
    transition: transform 0.3s ease;
  }

  .post-card:hover .cover-chevron {
    transform: translateX(0);
  }

  /* ---- 手机端：封面移到顶部，进入按钮/竖条隐藏，正文完整保留 ---- */
  @media (max-width: 768px) {
    .has-cover .post-card-body,
    .post-card:not(.has-cover) .post-card-body {
      padding: 16px;
    }

    .post-card-accent {
      display: none;
    }

    .post-card-enter {
      display: none;
    }

    .post-card-cover {
      position: relative;
      top: auto;
      right: auto;
      bottom: auto;
      width: auto;
      display: block;
      margin: 12px 12px 0;
      max-height: 20vh;
      border-radius: var(--radius);
    }

    .post-card-cover img {
      height: auto;
      max-height: 20vh;
      object-fit: fill;
    }

    .post-card-title {
      font-size: 1.05rem;
    }

    .cover-overlay {
      display: none;
    }
  }
</style>
