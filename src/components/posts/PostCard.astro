---
// PostCard.astro — 文章卡片

// 卡片本身不可点击，正文整体 pointer-events:none，仅各链接单独可点。
import { Icon } from 'astro-icon/components';
import ImageWrapper from './ImageWrapper.astro';
import type { CategoryTrailItem } from '../../lib/category';

interface Props {
  title: string;
  /** 已格式化日期（YYYY-MM-DD），空串不显示 */
  date: string;
  description?: string;
  image?: string;
  basePath?: string;
  tags?: string[];
  pinned?: boolean;
  url: string;
  /** 完整分类链（父分类 → … → 当前分类）；不传则只显示日期/字数/评论数 */
  categoryTrail?: CategoryTrailItem[];
  /** 评论数；不传（数据不可用）则不显示 */
  commentCount?: number;
  /** 估算字数；不传则不显示（放在评论数前） */
  words?: number;
}

const {
  title,
  date,
  description,
  image,
  basePath = "/",
  tags = [],
  pinned = false,
  url,
  categoryTrail,
  commentCount,
  words,
} = Astro.props;

const hasCover = !!image;
const hasStats = typeof words === 'number' && words > 0;
const trail = categoryTrail || [];
const hasCategory = trail.length > 0;
const hasMeta = !!date || hasCategory || hasStats || commentCount !== undefined;
---

<article class:list={["post-card glass", { "has-cover": hasCover }]}>
  <!-- 封面（右侧，固定 4:3） -->
  {hasCover && (
    <a href={url} class="post-card-cover" aria-label={`阅读：${title}`}>
      <span class="cover-ph-icon"><Icon name="mdi:image-outline" /></span>
      <ImageWrapper src={image!} basePath={basePath} alt={title} sizes="170px" widths={[320, 640]} />
      <span class="cover-overlay">
        <Icon name="mdi:chevron-right" class="cover-chevron" />
      </span>
    </a>
  )}

  <!-- 正文 -->
  <div class="post-card-body">
    <div class="post-card-head">
      <span class="post-card-accent" aria-hidden="true"></span>
      {pinned && (
        <span class="post-card-pin" title="置顶">
          <Icon name="la:thumbtack" class="pin-icon" />
        </span>
      )}
      <h3 class="post-card-title">
        <a href={url} class="post-card-title-link">{title}</a>
      </h3>
    </div>

    {description && (
      <a href={url} class="post-card-desc" aria-label={`阅读：${title}`}>{description}</a>
    )}

    <!-- 底部：元信息靠左，标签靠右（手机端隐藏标签） -->
    <div class="post-card-bottom">
      {hasMeta && (
        <div class="post-card-meta">
          {date && (
            <span class="post-card-meta-item">
              <Icon name="la:calendar" class="meta-icon" />
              <time datetime={date}>{date}</time>
            </span>
          )}
          {hasCategory && (
            <span class="post-card-meta-item">
              <Icon name="la:layer-group" class="meta-icon" />
              <span class="post-card-categories">
                {trail.map((item, i) => (
                  <span class="post-card-cat-item">
                    {i > 0 && <span class="post-card-cat-sep" aria-hidden="true">/</span>}
                    <a href={item.url} class="post-card-category" title={`分类：${item.name}`}>{item.name}</a>
                  </span>
                ))}
              </span>
            </span>
          )}
          {hasStats && (
            <span class="post-card-meta-item post-card-meta-words" title={`${words} 字`}>
              <Icon name="la:file-alt" class="meta-icon" />
              <span>{words} 字</span>
            </span>
          )}
          {commentCount !== undefined && (
            <span class="post-card-meta-item post-card-meta-comments" title={`${commentCount} 条评论`}>
              <Icon name="la:comments" class="meta-icon" />
              <span>{commentCount}</span>
            </span>
          )}
        </div>
      )}

      {tags.length > 0 && (
        <div class="post-card-tags">
          {tags.map((tag) => (
            <a
              href={`/posts/tag/${encodeURIComponent(tag)}/`}
              class="post-card-tag"
              title={`标签：${tag}`}
            >{tag}</a>
          ))}
        </div>
      )}
    </div>
  </div>
</article>

<style>
  /* ---- 卡片骨架 ---- */
  .post-card {
    position: relative;
    display: flex;
    height: 150px;
    border-radius: var(--radius);
    overflow: hidden;
    color: inherit;
    container-type: inline-size; /* 供 @container 按卡片宽度生效 */
  }

  /* 有封面时卡片为 flex：正文居左，封面居右（row-reverse 让封面显示在右） */
  .post-card.has-cover {
    display: flex;
    flex-direction: row-reverse;
    align-items: stretch;
  }

  /* ---- 正文（整体不拦截点击，仅标题 / 分类 / 标签可点） ---- */
  .post-card-body {
    position: relative;
    z-index: 2;
    pointer-events: none;
    padding: 18px 22px;
    display: flex;
    flex-direction: column;
    gap: 8px; /* 标题↔介绍↔元信息 之间稍收紧，超长标题时不易截底 */
    min-width: 0;
    box-sizing: border-box;
    flex: 1 1 auto;
  }

  .has-cover .post-card-body {
    flex: 1 1 auto;
  }

  .post-card-head {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* ---- 标题前的白色竖条：悬停配色与标题同步 ---- */
  .post-card-accent {
    flex-shrink: 0;
    width: 4px;
    height: 1.15em;
    min-height: 16px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.6);
    transition: background 0.06s ease;
  }

  .post-card-head:has(.post-card-title-link:hover) .post-card-accent {
    background: #fff;
  }

  .post-card-pin {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    color: #fff;
  }

  .pin-icon {
    width: 14px;
    height: 14px;
  }

  .post-card-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.4;
    margin: 0;
    flex: 1;
    min-width: 0;
    display: -webkit-box; /* 固定一行，超出的部分省略 */
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.06s ease;
  }

  .post-card-title-link {
    display: inline;
    padding: 0;
    border-radius: 0;
    position: static;
    overflow: visible;
    pointer-events: auto;
    color: inherit;
    text-decoration: none;
    transition: color 0.06s ease;
  }

  .post-card-title-link::before {
    display: none;
  }

  /* 悬停时标题变纯白 */
  .post-card-title:hover,
  .post-card-title-link:hover {
    color: #fff;
  }

  /* ---- 元信息行：日期 / 分类 / 评论数（图标与详情页一致） ---- */
  /* 底部行：元信息居左、标签居右；margin-top:auto 让该行贴住卡片底部
     （有封面时正好与右侧 4:3 封面的底部对齐） */
  .post-card-bottom {
    margin-top: auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 4px 16px; /* 换行时（标签掉到日期下方）行距收紧，少占介绍的空间 */
    flex-wrap: wrap;
    min-width: 0;
  }

  .post-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 16px;
    min-width: 0;
  }

  .post-card-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
    white-space: nowrap;
  }

  .meta-icon {
    width: 15px;
    height: 15px;
    opacity: 0.6;
    flex-shrink: 0;
    position: relative;
    top: -1px;
  }

  .post-card-categories {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    column-gap: 4px;
    row-gap: 2px;
    white-space: normal;
  }

  .post-card-cat-item {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .post-card-cat-sep {
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.85em;
  }

  .post-card-category {
    /* 抵消全局链接样式 + 卡片正文 pointer-events:none，链接单独可点击 */
    display: inline;
    padding: 0;
    border-radius: 0;
    position: static;
    overflow: visible;
    pointer-events: auto;
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    transition: color 0.2s;
  }

  .post-card-category::before {
    display: none;
  }

  .post-card-category:hover {
    color: #fff;
  }

  .post-card-desc {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    height: calc(0.88rem * 1.6 * 2); /* 固定占两行，短介绍也保持两行外观 */
    flex-shrink: 0; /* 空间紧张时不被压缩成单行 */
    /* 可点击，但无悬停效果 */
    pointer-events: auto;
    text-decoration: none;
  }

  .post-card-desc::before {
    display: none;
  }

  .post-card-desc:hover {
    color: rgba(255, 255, 255, 0.55);
  }

  /* 底部元信息一行放不下时渐进让位：先隐藏字数 → 再评论 → 再分类，日期始终保留 */
  @container (max-width: 400px) {
    .post-card-meta-words {
      display: none;
    }
  }

  @container (max-width: 300px) {
    .post-card-meta-comments {
      display: none;
    }
  }

  @container (max-width: 260px) {
    .post-card-meta-item:has(.post-card-categories) {
      display: none;
    }
  }

  /* 封面卡片正文列更窄，提前按同样顺序渐进让位 */
  @container (max-width: 480px) {
    .has-cover .post-card-meta-words {
      display: none;
    }
  }

  @container (max-width: 440px) {
    .has-cover .post-card-meta-comments {
      display: none;
    }
  }

  @container (max-width: 400px) {
    .has-cover .post-card-meta-item:has(.post-card-categories) {
      display: none;
    }
  }

  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: flex-end;
    margin: 0;
    min-width: 0;
  }

  .post-card-tag {
    display: inline-block;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.06);
    padding: 2px 8px; /* 比日期行略矮，保证标签显示时介绍仍有完整两行 */
    border-radius: 4px;
    text-decoration: none;
    position: relative;
    z-index: 3;
    pointer-events: auto;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .post-card-tag:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.12);
  }

  /* 卡片过窄时隐藏标签 */
  @container (max-width: 560px) {
    .post-card-tags {
      display: none;
    }
  }


  /* ---- 封面（卡片右侧：高度控制，宽度按 4:3 自动推导） ---- */
  .post-card-cover {
    flex: 0 0 auto;
    width: auto; /* 宽度由高度按 4:3 比例推导 */
    align-self: flex-start;
    display: block;
    position: relative;
    aspect-ratio: 4 / 3;
    height: calc(100% - 24px); /* 高度 = 卡片高度 - 上下 12px 留白 */
    max-width: 320px;
    margin: 12px 12px 12px 0;
    z-index: 2;
    pointer-events: auto;
    overflow: hidden;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.06);
    text-decoration: none;
    color: inherit;
  }

  .post-card-cover::before {
    display: none;
  }

  .post-card-cover img {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: fill; /* 非 4:3 的图片拉伸为 4:3 填满 */
    display: block;
    transition: transform 0.22s ease;
  }

  .post-card-cover:hover img {
    transform: scale(1.02);
  }

  /* 封面悬停遮罩与箭头 */
  .cover-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.45);
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }

  .post-card-cover:hover .cover-overlay {
    opacity: 1;
  }

  .cover-chevron {
    width: 2.5rem;
    height: 2.5rem;
    color: #fff;
    transform: translateX(-6px);
    transition: transform 0.2s ease;
  }

  .post-card-cover:hover .cover-chevron {
    transform: translateX(0);
  }

  /* ---- 手机端：封面仍在右侧（4:3） ---- */
  @media (max-width: 768px) {
    .post-card {
      height: 140px; /* 卡片收窄，标题一行 + 介绍两行仍放得下 */
    }

    .post-card-body {
      padding: 16px;
      gap: 6px; /* 行距收紧，标签与日期同行时介绍仍保持两行 */
    }

    .post-card-accent {
      display: none;
    }

    .post-card-cover {
      height: calc(100% - 20px); /* 上下留白 10px */
      margin: 10px 10px 10px 0;
      border-radius: 10px;
    }

    .post-card-cover:hover img {
      transform: none;
    }

    .cover-overlay {
      display: none;
    }

    .post-card-title {
      font-size: 1.05rem;
    }
  }
</style>
