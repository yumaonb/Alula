---
// PostCard.astro — 文章卡片组件（整个卡片可点击），参考 Fuwari 布局
import { Icon } from 'astro-icon/components';
import ImageWrapper from './ImageWrapper.astro';

interface Props {
  title: string;
  /** 已格式化的日期（YYYY-MM-DD）或可解析的日期串 */
  date: string;
  description?: string;
  image?: string;
  basePath?: string;
  tags?: string[];
  pinned?: boolean;
  url: string;
  /** 分类显示名（如「CSS」），展示在卡片上 */
  category?: string;
}

const { title, date, description, image, basePath = "/", tags = [], pinned = false, url, category } = Astro.props;

const hasCover = !!image;
---

<a href={url} class:list={["post-card glass", { "has-cover": hasCover }]} aria-label={title}>
  <!-- 文本内容区域（左侧） -->
  <div class="post-card-body">
    <div class="post-card-meta">
      {pinned && (
        <span class="post-card-pin">
          <Icon name="la:thumbtack" class="pin-icon" />
        </span>
      )}
      <h3 class="post-card-title">{title}</h3>
      <Icon name="mdi:chevron-right" class="post-card-chevron" />
    </div>

    <div class="post-card-sub">
      <time class="post-card-date" datetime={date}>{date}</time>
      {category && (
        <span class="post-card-category">{category}</span>
      )}
    </div>

    {description && (
      <p class="post-card-desc">{description}</p>
    )}

    {tags.length > 0 && (
      <div class="post-card-tags">
        {tags.map(tag => (
          <span class="post-card-tag">{tag}</span>
        ))}
      </div>
    )}
  </div>

  <!-- 封面图片区域（右侧） -->
  {hasCover && (
    <div class="post-card-cover">
      <span class="cover-ph-icon" aria-hidden="true"><Icon name="mdi:image-outline" /></span>
      <ImageWrapper src={image!} basePath={basePath} alt={title} class="w-full object-contain" />
    </div>
  )}
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    border-radius: var(--radius);
    overflow: hidden;
    max-height: 204px;
    transition: filter 0.3s ease, box-shadow 0.3s ease;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .post-card::before {
    display: none;
  }

  .post-card:hover {
    filter: brightness(1.15);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
  }

  /* 文本区域（左侧，flex: 1 自动撑满） */
  .post-card-body {
    flex: 1;
    min-width: 0;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    overflow: hidden;
  }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    position: relative;
  }

  .post-card-pin {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .pin-icon {
    width: 14px;
    height: 14px;
  }

  .post-card-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.4;
    margin: 0;
    flex: 1;
    min-width: 0;
  }

  .post-card-chevron {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    opacity: 0;
    transition: opacity 0.3s, transform 0.3s;
    color: var(--primary, #e4b1f0);
  }

  .post-card:hover .post-card-chevron {
    opacity: 1;
    transform: translateX(-4px);
  }

  .post-card-sub {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .post-card-date {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.45);
  }

  .post-card-category {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.65);
    background: rgba(255, 255, 255, 0.08);
    padding: 2px 8px;
    border-radius: 4px;
  }

  .post-card-desc {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }

  .post-card-tag {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.06);
    padding: 3px 8px;
    border-radius: 4px;
  }

  /* 封面图片 — 右侧固定宽度区域 */
  .post-card-cover {
    flex-shrink: 0;
    width: 200px;
    padding: 12px 12px 12px 0;
    display: none;
  }

  .post-card-cover img {
    width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: 12px;
    display: block;
    transition: transform 0.3s ease;
  }

  .post-card:hover .post-card-cover img {
    transform: scale(1.02);
  }

  .has-cover .post-card-cover {
    display: block;
  }

  @media (max-width: 768px) {
    /* 手机端：封面整宽在上，文本在下 */
    .post-card {
      flex-direction: column;
      max-height: none;
    }

    .post-card-cover {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      padding: 0;
      display: block;
    }

    .post-card-cover img {
      border-radius: 0;
    }

    .post-card-body {
      padding: 16px;
    }

    .post-card-title {
      font-size: 1rem;
    }

    .post-card-chevron {
      display: none;
    }
  }
</style>