---
// PostNav.astro — 文章 上一篇 / 下一篇 导航
// 用法：<PostNav prev={...} next={...} />
import PostNavItem from './PostNavItem.astro';

interface NavPost {
  title: string;
  url: string;
}

interface Props {
  // 上一篇（较新）
  prev?: NavPost | null;
  // 下一篇（较旧）
  next?: NavPost | null;
}

const { prev = null, next = null } = Astro.props;
---

{(prev || next) && (
  <nav class="post-nav" aria-label="文章导航">
    <PostNavItem dir="prev" post={prev} />
    <PostNavItem dir="next" post={next} />
  </nav>
)}

<style>
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--card-gap);
    margin-top: 24px;
  }

  @media (max-width: 768px) {
    .post-nav {
      grid-template-columns: 1fr;
      gap: var(--card-gap);
    }
  }
</style>
