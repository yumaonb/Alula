---
// AdminNav.astro — 后台侧边分区导航
// 用法：由 AdminLayout 渲染一次，位于 main#swup 之外
import { Icon } from 'astro-icon/components';

const items = [
  { href: '/admin/', label: '仪表盘', icon: 'mdi:view-dashboard-outline' },
  { href: '/admin/posts/', label: '文章管理', icon: 'mdi:file-document-edit-outline' },
];

const current = Astro.url.pathname.replace(/\/+$/, '') || '/admin';
const isActive = (href: string) => href.replace(/\/+$/, '') === current;
---

<aside class="admin-nav">
  <nav class="admin-nav-list" aria-label="后台分区">
    {items.map((item) => (
      <a
        class:list={[
          'admin-nav-link',
          'link-plain',
          'hoverable',
          isActive(item.href) && 'is-active',
        ]}
        href={item.href}
        data-nav-path={item.href}
      >
        <Icon name={item.icon} class="admin-nav-icon" />
        <span>{item.label}</span>
      </a>
    ))}
  </nav>

  <!-- data-no-swup：站点页与后台页的外壳不同，交给浏览器整页加载，别让 swup 把内容塞进错误的外壳 -->
  <a class="admin-nav-link admin-nav-back hoverable link-plain" href="/" data-no-swup>
    <Icon name="mdi:arrow-left" class="admin-nav-icon" />
    <span>回到站点</span>
  </a>
</aside>
