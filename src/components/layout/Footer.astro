---
// Footer.astro — 页脚
// 用法：<Footer />
import { site } from '../../data/site';
---

<footer class="site-footer glass">
  <div class="footer-inner">
    <p class="footer-copy">{site.footerCopyright}</p>
    <p class="footer-note">
      <Fragment set:html={site.footerNote} />
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-radius: 0;
    padding: 0;
    position: relative;
    z-index: 10;
    contain: layout style paint;
  }

  /* 宽度公式与 global.css 的 .page-main 同源（改 .page-main 宽度时同步改这里），
     页脚文字左缘与正文对齐 */
  .footer-inner {
    width: min(100% - var(--page-gutter) * 2, var(--content-width));
    margin: 0 auto;
    padding: 20px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .footer-copy {
    font-size: 0.8rem;
    color: var(--ink);
  }

  .footer-note {
    font-size: 0.75rem;
    color: var(--ink);
  }

  @media (max-width: 768px) {
    .footer-inner {
      width: calc(100% - var(--page-gutter-mobile) * 2);
    }
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      gap: 4px;
      padding: 16px 0;
      text-align: center;
    }
  }
</style>
