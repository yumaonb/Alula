---
// CustomScrollbar.astro — 自定义悬浮滚动条
// 用法：<CustomScrollbar />
---

<!-- 触发区：鼠标靠近右侧 60px 时激活滚动条 -->
<div class="scrollbar-hover-zone" id="scrollbar-hover-zone"></div>

<div class="custom-scrollbar-container" id="custom-scrollbar">
  <div class="custom-scrollbar-track" id="scrollbar-track">
    <div class="custom-scrollbar-thumb" id="scrollbar-thumb"></div>
  </div>
</div>

<script>
  import '../../assets/js/scrollbar.js';
</script>

<style>
  /* 右侧 60px 不可见触发区 */
  .scrollbar-hover-zone {
    position: fixed;
    right: 0;
    top: 0;
    width: 60px;
    height: 100vh;
    z-index: 40;
    pointer-events: auto;
  }

  .custom-scrollbar-container {
    position: fixed;
    right: 0;
    top: 0;
    height: 100vh;
    width: 8px;
    z-index: 9999;
    padding: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    margin: 0;
  }

  .custom-scrollbar-container.visible {
    opacity: 1;
    pointer-events: auto;
  }

  .custom-scrollbar-track {
    position: relative;
    width: 6px;
    height: 100%;
    margin: 0 auto;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    cursor: pointer;
  }

  .custom-scrollbar-thumb {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    background: rgba(255, 255, 255, 0.45);
    border-radius: 3px;
    transition: background 0.2s ease;
    cursor: grab;
    min-height: 30px;
  }

  .custom-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.7);
  }

  .custom-scrollbar-thumb.active {
    cursor: grabbing;
    background: rgba(255, 255, 255, 0.9);
  }

  /* 移动端隐藏自定义滚动条 */
  @media (max-width: 768px) {
    .scrollbar-hover-zone {
      display: none;
    }
    .custom-scrollbar-container {
      display: none;
    }
  }
</style>
