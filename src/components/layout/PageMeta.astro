---
// PageMeta.astro — 对外分享卡（Open Graph / Twitter Card）
// 用法：由 BaseLayout 的 <head> 引入，页面不直接用——页面只需给 BaseLayout 传 image / ogType
//
// 只做「链接贴进聊天软件时那张卡」这一件事：title / description 由 BaseLayout 算好传进来，
// 这里只负责拼绝对地址与卡片类型。全站大多数页面没有配图，回落站点方图并降级成 summary
// （大图卡配一张 68px 的方图会被裁得很难看）；文章页带封面时用 summary_large_image。
import { site } from '../../data/site';

interface Props {
  /** 已含站点名的完整标题 */
  title: string;
  description: string;
  /** 封面或站点图；根相对路径、外链都行，这里统一补成绝对地址 */
  image?: string;
  type?: 'website' | 'article';
  /** 文章页的发布时间（ISO 串），只有 type=article 时有意义 */
  publishedTime?: string;
}

const { title, description, image, type = 'website', publishedTime } = Astro.props;

const origin = site.url;

/** 站内根相对路径补成绝对地址：分享卡爬虫不认相对路径 */
function absolute(url: string): string {
  if (/^https?:\/\//.test(url)) return url;
  return new URL(url, origin).href;
}

// 没配图时用站点方图：比例是 1:1，只能走小卡
const hasWideImage = Boolean(image);
const cardImage = absolute(image ?? '/images/favicon.png');
const pageUrl = new URL(Astro.url.pathname, origin).href;
---

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.lang.replace('-', '_')} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={pageUrl} />
<meta property="og:image" content={cardImage} />
{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
<meta name="twitter:card" content={hasWideImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={cardImage} />
