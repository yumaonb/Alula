---
// ReadingProgress.astro — 阅读进度按钮（仅在没有评论区的页面显示）
---

<button class="back-to-widget" id="reading-progress" aria-label="阅读进度">
  <svg class="progress-ring" viewBox="0 0 54 54" aria-hidden="true">
    <rect class="progress-ring-bg" x="1" y="1" width="52" height="52" rx="5" pathLength="100" />
    <rect class="progress-ring-bar" id="progress-ring-bar" x="1" y="1" width="52" height="52" rx="5" pathLength="100" />
  </svg>
  <span class="progress-text" id="progress-ring-text">0%</span>
</button>

<script is:inline data-swup-ignore-script>
(function() {
  var btn = document.getElementById('reading-progress');
  var bar = document.getElementById('progress-ring-bar');
  var text = document.getElementById('progress-ring-text');
  if (!btn || !bar || !text) return;

  // pathLength="100" 把周长归一化为 100，直接用百分比算偏移
  bar.style.strokeDasharray = '100';
  bar.style.strokeDashoffset = '100';

  function update() {
    // 滚动超过 100px 才出现
    btn.classList.toggle('visible', window.scrollY > 100);

    var max = document.documentElement.scrollHeight - window.innerHeight;
    var p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    bar.style.strokeDashoffset = String(100 * (1 - p));
    text.textContent = Math.round(p * 100) + '%';
  }

  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update, { passive: true });
  update();
})();
</script>

<style>
  .back-to-widget { overflow: visible; }

  .progress-ring {
    position: absolute;
    /* 向外扩 1px 覆盖按钮的 border-box，描边中心正好落在按钮边缘上 */
    inset: -1px;
    width: calc(100% + 2px);
    height: calc(100% + 2px);
    pointer-events: none;
  }

  .progress-ring-bg {
    fill: none;
    stroke: rgba(255, 255, 255, 0.08);
    stroke-width: 2;
  }

  .progress-ring-bar {
    fill: none;
    stroke: rgba(255, 255, 255, 0.9);
    stroke-width: 2;
    stroke-linecap: round;
    filter: drop-shadow(0 0 3px rgba(255, 255, 255, 0.8)); /* 白色发光 */
    transition: stroke-dashoffset 0.1s linear;
  }

  .progress-text {
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.75);
    font-variant-numeric: tabular-nums;
  }
</style>