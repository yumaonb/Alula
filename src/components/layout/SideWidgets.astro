---
// SideWidgets.astro — 侧边悬浮按钮列（纯静态标记，交互由 swup-widgets.js 控制）
// 用法：<SideWidgets />（BaseLayout 引入）
// DOM 约定：容器 #side-widgets；每个按钮 .back-to-widget +
//   data-widget="top|toc|filter|progress|comments|bottom"；
//   目录 / 筛选按钮 id 固定为 #toc-fab / #posts-filter-fab（由 TocModal / PostsFilterModal 监听）
import { Icon } from 'astro-icon/components';
---

<div class="side-widgets" id="side-widgets">
  <button class="back-to-widget" data-widget="top" aria-label="返回顶部">
    <Icon name="la:arrow-up" class="back-to-widget-icon" />
  </button>

  <button
    class="back-to-widget"
    data-widget="toc"
    id="toc-fab"
    aria-label="文章目录"
    aria-haspopup="dialog"
    aria-expanded="false"
  >
    <svg class="back-to-widget-icon" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
      <path d="M4 5v6h6V5zm2 2h2v2H6zm6 0v2h15V7zm-8 6v6h6v-6zm2 2h2v2H6zm6 0v2h15v-2zm-8 6v6h6v-6zm2 2h2v2H6zm6 0v2h15v-2z" />
    </svg>
  </button>

  <button
    class="back-to-widget"
    data-widget="filter"
    id="posts-filter-fab"
    aria-label="分类与标签"
    aria-haspopup="dialog"
    aria-expanded="false"
  >
    <Icon name="la:tags" class="back-to-widget-icon" />
  </button>

  <button class="back-to-widget" data-widget="progress" aria-label="阅读进度">
    <svg class="progress-ring" viewBox="0 0 54 54" aria-hidden="true">
      <rect class="progress-ring-bg" x="1" y="1" width="52" height="52" rx="5" pathLength="100" />
      <rect
        class="progress-ring-bar"
        x="1"
        y="1"
        width="52"
        height="52"
        rx="5"
        pathLength="100"
        stroke-dasharray="100"
        stroke-dashoffset="100"
      />
    </svg>
    <span class="progress-text">0%</span>
  </button>

  <button class="back-to-widget" data-widget="comments" aria-label="到评论">
    <Icon name="la:comment" class="back-to-widget-icon" />
  </button>

  <button class="back-to-widget" data-widget="bottom" aria-label="到底部">
    <Icon name="la:arrow-down" class="back-to-widget-icon" />
  </button>
</div>

<style>
  /* ---- 目录按钮：桌面端有右侧目录栏，隐藏悬浮按钮 ---- */
  @media (min-width: 769px) {
    #toc-fab {
      display: none;
    }
  }

  /* ---- 筛选按钮：>1000px 一律隐藏（桌面侧栏常驻） ---- */
  @media (min-width: 1001px) {
    #posts-filter-fab {
      display: none;
    }
  }

  /* 列表页缩小为紧凑按钮 */
  #posts-filter-fab.compact {
    width: 40px;
    height: 40px;
  }

  #posts-filter-fab.compact :global(.back-to-widget-icon) {
    width: 18px;
    height: 18px;
  }

  /* ---- 阅读进度环 ---- */
  .progress-ring {
    position: absolute;
    inset: -1px;
    width: calc(100% + 2px);
    height: calc(100% + 2px);
    pointer-events: none;
  }

  .progress-ring-bg {
    fill: none;
    stroke: rgba(255, 255, 255, 0.08);
    stroke-width: 2;
  }

  .progress-ring-bar {
    fill: none;
    stroke: rgba(255, 255, 255, 0.9);
    stroke-width: 2;
    stroke-linecap: round;
    filter: drop-shadow(0 0 3px rgba(255, 255, 255, 0.8));
    transition: stroke-dashoffset 0.1s linear;
  }

  .progress-text {
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.75);
    font-variant-numeric: tabular-nums;
  }
</style>
