---
// SideWidgets.astro — 通用悬浮按钮列与功能按钮插槽
// 用法：由 PageExtras 通过 './SideWidgets.astro' 引入，功能外壳可传入额外按钮。
// 容器与按钮标记供悬浮按钮脚本读取；进度环的 pathLength 与脚本百分比刻度须同改。
import { Icon } from 'astro-icon/components';
---

<div class="side-widgets" id="side-widgets">
  <button class="back-to-widget glass hoverable" data-widget="top" aria-label="返回顶部">
    <Icon is:inline name="la:arrow-up" class="back-to-widget-icon" />
  </button>

  <slot />

  <button class="back-to-widget glass hoverable" data-widget="progress" aria-label="阅读进度">
    <svg class="progress-ring" viewBox="0 0 54 54" aria-hidden="true">
      <rect class="progress-ring-bg" x="1" y="1" width="52" height="52" pathLength="100" />
      <rect
        class="progress-ring-bar"
        x="1"
        y="1"
        width="52"
        height="52"
        pathLength="100"
        stroke-dasharray="100"
        stroke-dashoffset="100"
      />
    </svg>
    <span class="progress-text">0%</span>
  </button>

  <button class="back-to-widget glass hoverable" data-widget="bottom" aria-label="到底部">
    <Icon is:inline name="la:arrow-down" class="back-to-widget-icon" />
  </button>
</div>

<style>
  /* ---- 阅读进度环 ---- */
  .progress-ring {
    position: absolute;
    inset: -1px;
    width: calc(100% + 2px);
    height: calc(100% + 2px);
    pointer-events: none;
  }

  .progress-ring-bg {
    fill: none;
    stroke: rgba(255, 255, 255, 0.08);
    stroke-width: 2;
  }

  /* 圆角按进度环视口缩放补偿；改按钮尺寸或视口时同步分母。 */
  .progress-ring rect {
    rx: calc(var(--radius) * 54 / 46);
  }

  @media (max-width: 768px) {
    .progress-ring rect {
      rx: calc(var(--radius) * 54 / 40);
    }
  }

  .progress-ring-bar {
    fill: none;
    stroke: rgba(255, 255, 255, 0.9);
    stroke-width: 2;
    stroke-linecap: round;
    transition: stroke-dashoffset 0.1s linear;
  }

  @media (prefers-reduced-motion: reduce) {
    .progress-ring-bar {
      transition: none;
    }
  }

  .progress-text {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
</style>
