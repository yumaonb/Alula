---
// NavBar.astro — 导航栏（桌面链接 + 移动端汉堡菜单）
// 用法：<NavBar />（BaseLayout 引入）
import { Icon } from 'astro-icon/components';
import { site } from '../../data/site';
import { navMatch } from '../../lib/nav-match';

const navItems = [
  { href: '/', label: '首页', mobileIcon: 'la:home' },
  { href: '/about/', label: '关于', mobileIcon: 'la:user' },
  { href: '/projects/', label: '项目', mobileIcon: 'la:cubes' },
  { href: '/posts/', label: '文章', mobileIcon: 'la:pen-fancy' },
  { href: '/friends/', label: '友链', mobileIcon: 'la:link' },
  { href: '/sponsor/', label: '赞助', mobileIcon: 'la:hand-holding-heart' },
];

// is-active / aria-current 服务端渲染：下划线在首屏 HTML 里即可见，不依赖 JS；
// 切页后由 nav-indicator.ts 在这块常驻导航上更新
const items = navItems.map((item) => ({ ...item, active: navMatch(item.href, Astro.url.pathname) }));
---

<nav class="navbar glass">
  <div class="nav-inner">
    <a href="/" class="nav-logo link-plain" aria-label="首页">
      <Icon name="la:home" class="nav-home-icon" />
      {site.name}
    </a>

    <ul class="nav-links">
      {
        items.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['link-plain', { 'is-active': item.active }]}
              aria-current={item.active ? 'page' : undefined}
            >
              <span class="nav-link-text">{item.label}</span>
            </a>
          </li>
        ))
      }
      <li class="nav-indicator" aria-hidden="true"></li>
    </ul>

    <button
      class="hamburger-btn"
      aria-label="菜单"
      aria-expanded="false"
      aria-controls="mobile-dropdown"
    >
      <span class="icon-bars">
        <Icon name="la:bars" />
      </span>
      <span class="icon-close">
        <Icon name="la:times" />
      </span>
    </button>
  </div>

  <div id="mobile-dropdown" class="mobile-dropdown" aria-hidden="true">
    <div class="mobile-dropdown-inner">
      <ul class="mobile-menu">
        {
          items.map((item) => (
            <li class="mobile-item">
              <a
                href={item.href}
                class:list={['mobile-link', 'hoverable', 'link-plain', { 'is-active': item.active }]}
                aria-current={item.active ? 'page' : undefined}
                tabindex="-1"
              >
                <span class="mobile-link-left">
                  <Icon name={item.mobileIcon} class="mobile-link-icon" />
                  <span class="mobile-link-text">{item.label}</span>
                </span>
                <Icon name="la:external-link-alt" class="mobile-link-arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</nav>

<div class="mobile-overlay" aria-hidden="true"></div>

<script>
  // 每页加载断点模块，保证 window.__onEnterDesktop 存在：
  // 汉堡菜单脚本只在移动端加载，目录 / 筛选抽屉从全局取共享的断点监听器
  import '../../assets/js/breakpoint';

  const mq = window.matchMedia('(max-width: 768px)');
  let loaded = false;

  function loadHamburger() {
    if (!loaded) {
      loaded = true;
      import('../../assets/js/hamburger');
    }
  }

  if (mq.matches) loadHamburger();
  mq.addEventListener('change', (e) => {
    if (e.matches) loadHamburger();
  });

  const desktopMq = window.matchMedia('(min-width: 769px)');
  let navLoaded = false;

  function loadNavIndicator() {
    if (!navLoaded) {
      navLoaded = true;
      import('../../assets/js/nav-indicator');
    }
  }

  if (desktopMq.matches) loadNavIndicator();
  desktopMq.addEventListener('change', (e) => {
    if (e.matches) loadNavIndicator();
  });
</script>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    border-radius: 0;
  }

  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--hover-ink);
    white-space: nowrap;
  }

  .nav-home-icon {
    width: 1.15em;
    height: 1.15em;
    color: var(--icon-hover);
  }

  .nav-links {
    position: relative;
    display: flex;
    gap: 4px;
  }

  .nav-links a {
    display: block;
    padding: 8px 20px;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--icon-ink);
    transition: color 0.25s ease;
  }

  /* 悬停 / 聚焦 / 当前页不走全站 .hoverable（那会加白底描边）：
     只提亮文字，静止与高亮都走现有令牌（--icon-ink → --icon-hover） */
  .nav-links a:hover,
  .nav-links a:focus-visible,
  .nav-links a.is-active {
    color: var(--icon-hover);
  }

  /* 文字包裹：下划线的位置 / 宽度从它量（nav-indicator.ts）；
     inline-block 让 offset 度量稳定，::after 才有可靠的定位盒 */
  .nav-link-text {
    position: relative;
    display: inline-block;
  }

  /* 静态线：只负责首屏与加载期（is-active 服务端渲染，首帧即可见、不依赖 JS）；
     JS 接管（.js-ready）后由共享线独家绘制，静态线不再出现，两者同帧同位交接；
     bottom -8px 对齐链接底边（链接 padding-bottom 为 8px） */
  .nav-links:not(.js-ready) a.is-active .nav-link-text::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -8px;
    height: 2px;
    border-radius: 1px;
    background: var(--icon-hover);
  }

  /* 共享线：JS 接管后下划线的唯一画者，点击 / 切页 / resize 都只重设它的目标位置；
     位移由 motion 驱动（nav-indicator.ts）：时长按位移成比例（450–700ms），
     曲线快起缓收（与后台侧栏一致），改向时从飞行中位置平滑续接 */
  .nav-indicator {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    border-radius: 1px;
    background: var(--icon-hover);
    opacity: 0;
    pointer-events: none;
  }

  .nav-indicator.is-on {
    opacity: 1;
  }

  .hamburger-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    padding: 0;
  }

  .icon-bars,
  .icon-close {
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
    color: var(--icon-hover);
  }

  .icon-bars :global(svg),
  .icon-close :global(svg) {
    width: 24px;
    height: 24px;
  }

  .icon-close {
    opacity: 0;
    transform: rotate(-90deg);
  }

  .hamburger-btn.is-open .icon-bars {
    opacity: 0;
    transform: rotate(90deg);
  }

  .hamburger-btn.is-open .icon-close {
    opacity: 1;
    transform: rotate(0deg);
  }

  /* 手机端下拉菜单 - 常驻DOM，用高度+位移实现滑落；
     开合动效由 motion 驱动（hamburger.ts）：这里只定义开/关两个端点状态，
     动画飞行中的值由 motion 接管，结束后提交的最终值与端点一致 */
  .mobile-dropdown {
    max-height: 0;
    overflow: hidden;
    border-top: 1px solid transparent;
  }

  .mobile-dropdown.is-open {
    /* --dd-h 由 hamburger.ts 在展开前量出的内层实高；+1px 是 border-top
       （全局 border-box，max-height 含边框）；380px 是无 JS 时的兜底 */
    max-height: calc(var(--dd-h, 380px) + 1px);
    border-top-color: rgba(255, 255, 255, 0.12);
  }

  .mobile-menu {
    /* 上下都不留内边距（刻意）：菜单与首/末项齐平，边界靠顶部分隔线，
       呼吸感由 48px 行高自身承担，别再加回来 */
    display: flex;
    flex-direction: column;
  }

  .mobile-item {
    width: 100%;
    position: relative;
  }

  .mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    box-sizing: border-box;
    padding: 0 28px;
    height: 48px;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--icon-ink);
    border-radius: 0;
    border: none;
    text-decoration: none;
    position: relative;
    overflow: hidden;
  }

  .mobile-link-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .mobile-link-icon {
    width: 17px;
    height: 17px;
    color: var(--icon-ink);
    flex-shrink: 0;
    transition: color 0.15s;
  }

  .mobile-link-arrow {
    width: 14px;
    height: 14px;
    color: var(--icon-ink);
    flex-shrink: 0;
    transition:
      color 0.15s,
      transform 0.15s;
  }

  .mobile-link-text {
    font-size: 0.88rem;
    letter-spacing: 0.02em;
  }

  .mobile-link:hover .mobile-link-icon,
  .mobile-link:hover .mobile-link-arrow {
    color: var(--icon-hover);
  }

  /* 当前页：文字 + 该项图标提亮（刻意不加位移 / 底色，见 mobile-link 两级规则） */
  .mobile-link.is-active,
  .mobile-link.is-active .mobile-link-icon {
    color: var(--icon-hover);
  }

  .mobile-link:hover .mobile-link-arrow {
    transform: translateX(2px);
  }

  /* 遮罩层（透明度由 motion 驱动，见 hamburger.ts） */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    background: var(--mask);
    z-index: 90;
    opacity: 0;
    pointer-events: none;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  @media (max-width: 768px) {
    .nav-inner {
      height: 56px;
      padding: 0 16px;
    }

    .nav-logo {
      font-size: 1.05rem;
    }

    .nav-links {
      display: none;
    }

    .hamburger-btn {
      display: flex;
    }
  }
</style>
