---
// NavBar.astro — 导航栏

import { Icon } from "astro-icon/components";
---

<nav class="navbar glass">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="首页">
      <Icon name="la:home" class="nav-home-icon" />
      羽毛的小屋
    </a>

    <!-- 桌面端链接 -->
    <ul class="nav-links">
      <li><a href="/">首页</a></li>
      <li><a href="/about">关于</a></li>
      <li><a href="#projects">项目</a></li>
      <li><a href="#articles">文章</a></li>
      <li><a href="#friends">友链</a></li>
      <li><a href="/sponsor">赞助</a></li>
    </ul>

    <!-- 手机端汉堡按钮 -->
    <button
      class="hamburger-btn"
      aria-label="菜单"
      aria-expanded="false"
      aria-controls="mobile-dropdown"
    >
      <span class="icon-bars"><Icon name="la:bars" /></span>
      <span class="icon-close"><Icon name="la:times" /></span>
    </button>
  </div>

  <!-- 手机端下拉菜单 -->
  <div id="mobile-dropdown" class="mobile-dropdown" aria-hidden="true">
    <div class="mobile-dropdown-inner">
      <ul class="mobile-menu">
        <li class="mobile-item">
          <a href="/" class="mobile-link" tabindex="-1">
            <span class="mobile-link-left">
              <Icon name="la:home" class="mobile-link-icon" />
              <span class="mobile-link-text">首页</span>
            </span>
            <Icon name="la:external-link-alt" class="mobile-link-arrow" />
          </a>
        </li>
        <li class="mobile-item">
          <a href="/about" class="mobile-link" tabindex="-1">
            <span class="mobile-link-left">
              <Icon name="la:user" class="mobile-link-icon" />
              <span class="mobile-link-text">关于</span>
            </span>
            <Icon name="la:external-link-alt" class="mobile-link-arrow" />
          </a>
        </li>
        <li class="mobile-item">
          <a href="#projects" class="mobile-link" tabindex="-1">
            <span class="mobile-link-left">
              <Icon name="la:folder-open" class="mobile-link-icon" />
              <span class="mobile-link-text">项目</span>
            </span>
            <Icon name="la:external-link-alt" class="mobile-link-arrow" />
          </a>
        </li>
        <li class="mobile-item">
          <a href="#articles" class="mobile-link" tabindex="-1">
            <span class="mobile-link-left">
              <Icon name="la:pen-fancy" class="mobile-link-icon" />
              <span class="mobile-link-text">文章</span>
            </span>
            <Icon name="la:external-link-alt" class="mobile-link-arrow" />
          </a>
        </li>
        <li class="mobile-item">
          <a href="#friends" class="mobile-link" tabindex="-1">
            <span class="mobile-link-left">
              <Icon name="la:link" class="mobile-link-icon" />
              <span class="mobile-link-text">友链</span>
            </span>
            <Icon name="la:external-link-alt" class="mobile-link-arrow" />
          </a>
        </li>
        <li class="mobile-item">
          <a href="/sponsor" class="mobile-link" tabindex="-1">
            <span class="mobile-link-left">
              <Icon name="la:hand-holding-heart" class="mobile-link-icon" />
              <span class="mobile-link-text">赞助</span>
            </span>
            <Icon name="la:external-link-alt" class="mobile-link-arrow" />
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<!-- 遮罩层 -->
<div class="mobile-overlay" aria-hidden="true"></div>

<script>
  const mq = window.matchMedia('(max-width: 768px)');
  let loaded = false;

  function loadHamburger() {
    if (!loaded) {
      loaded = true;
      import('../../assets/js/hamburger.js');
    }
  }

  if (mq.matches) loadHamburger();
  mq.addEventListener('change', (e) => { if (e.matches) loadHamburger(); });
</script>

<style>
  /* 导航栏容器 */
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    border-radius: 0;
  }

  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Logo */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: #fff;
    white-space: nowrap;
  }

  .nav-home-icon {
    width: 1.15em;
    height: 1.15em;
    color: inherit;
  }

  /* 桌面端链接 */
  .nav-links {
    display: flex;
    gap: 4px;
  }

  .nav-links a {
    display: block;
    position: relative;
    padding: 8px 20px;
    font-size: 0.95rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.75);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .nav-links a::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.1);
    opacity: 0;
    transition: opacity 0.3s;
    border-radius: inherit;

  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    color: #fff;
  }

  .nav-links a:hover::before,
  .nav-links a:focus-visible::before {
    opacity: 1;
  }

  /* 汉堡按钮（桌面隐藏） */
  .hamburger-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    padding: 0;
  }

  .icon-bars,
  .icon-close {
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    transition: opacity 0.3s ease, transform 0.3s ease;
    color: rgba(255, 255, 255, 0.85);
  }

  .icon-bars :global(svg),
  .icon-close :global(svg) {
    width: 24px;
    height: 24px;
  }

  .icon-close {
    opacity: 0;
    transform: rotate(-90deg);
  }

  .hamburger-btn.is-open .icon-bars {
    opacity: 0;
    transform: rotate(90deg);
  }

  .hamburger-btn.is-open .icon-close {
    opacity: 1;
    transform: rotate(0deg);
  }

  /* 手机端下拉菜单 - 常驻DOM，用高度+位移实现滑落 */
  .mobile-dropdown {
    max-height: 0;
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    transition: max-height 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .mobile-dropdown.is-open {
    max-height: 380px;
  }

  .mobile-dropdown-inner {
    transform: translateY(-8px);
    opacity: 0;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease;
  }

  .mobile-dropdown.is-open .mobile-dropdown-inner {
    transform: translateY(0);
    opacity: 1;
  }

  .mobile-menu {
    list-style: none;
    margin: 0;
    padding: 6px 0 14px;
    display: flex;
    flex-direction: column;
  }

  .mobile-item {
    opacity: 0;
    transform: translateY(-12px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    width: 100%;
    position: relative;
  }

  .mobile-dropdown.is-open .mobile-item {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-dropdown.is-open .mobile-item:nth-child(1) { transition-delay: 0.04s; }
  .mobile-dropdown.is-open .mobile-item:nth-child(2) { transition-delay: 0.08s; }
  .mobile-dropdown.is-open .mobile-item:nth-child(3) { transition-delay: 0.12s; }
  .mobile-dropdown.is-open .mobile-item:nth-child(4) { transition-delay: 0.16s; }
  .mobile-dropdown.is-open .mobile-item:nth-child(5) { transition-delay: 0.20s; }
  .mobile-dropdown.is-open .mobile-item:nth-child(6) { transition-delay: 0.24s; }

  .mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    box-sizing: border-box;
    padding: 0 28px;
    height: 48px;
    font-size: 0.88rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.78);
    border-radius: 0;
    border: none;
    text-decoration: none;
    position: relative;
    overflow: hidden;
  }

  .mobile-link::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.1);
    opacity: 0;
    transition: opacity 0.15s ease;

  }

  .mobile-link:hover,
  .mobile-link:focus-visible {
    color: #fff;
  }

  .mobile-link:hover::before,
  .mobile-link:focus-visible::before {
    opacity: 1;
  }

  .mobile-link:active::before {
    background: rgba(255, 255, 255, 0.18);
    opacity: 1;
  }

  .mobile-link-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .mobile-link-icon {
    width: 17px;
    height: 17px;
    color: rgba(255, 255, 255, 0.6);
    flex-shrink: 0;
    transition: filter 0.15s;
  }

  .mobile-link:hover .mobile-link-icon {
    filter: brightness(1.67);
  }

  .mobile-link-text {
    font-size: 0.88rem;
    letter-spacing: 0.02em;
  }

  .mobile-link-arrow {
    width: 14px;
    height: 14px;
    color: rgba(255, 255, 255, 0.6);
    flex-shrink: 0;
    transition: filter 0.15s, transform 0.15s;
  }

  .mobile-link:hover .mobile-link-arrow {
    filter: brightness(1.67);
    transform: translateX(2px);
  }

  /* 遮罩层 */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 90;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  /* 手机端适配 */
  @media (max-width: 768px) {
    .nav-inner {
      height: 56px;
      padding: 0 16px;
    }

    .nav-logo {
      font-size: 1.05rem;
    }

    .nav-links {
      display: none;
    }

    .hamburger-btn {
      display: flex;
    }
  }
</style>