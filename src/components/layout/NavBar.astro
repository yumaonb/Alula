---
// NavBar.astro — 导航栏（桌面链接 + 移动端汉堡菜单）
// 用法：<NavBar />（BaseLayout 引入）
// 六个导航项来自唯一来源 src/data/nav.ts（桌面 / 手机共用，各界面页头标题图标也从这取）
import { Icon } from 'astro-icon/components';
import { site } from '../../data/site';
import { navItems } from '../../data/nav';
import { navMatch } from '../../lib/nav-match';

// is-active / aria-current 服务端渲染：下划线在首屏 HTML 里即可见，不依赖 JS；
// 切页后由 nav-indicator.ts 在这块常驻导航上更新
const items = navItems.map((item) => ({ ...item, active: navMatch(item.href, Astro.url.pathname) }));
---

<nav class="navbar glass">
  <div class="nav-inner">
    <a href="/" class="nav-logo link-plain" aria-label="首页">
      <Icon is:inline name="la:home" class="nav-home-icon" />
      {site.name}
    </a>

    <ul class="nav-links">
      {
        items.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['link-plain', { 'is-active': item.active }]}
              aria-current={item.active ? 'page' : undefined}
            >
              <span class="nav-link-inner">
                <Icon is:inline name={item.icon} class="nav-link-icon" />
                <span>{item.label}</span>
              </span>
            </a>
          </li>
        ))
      }
      <li class="nav-indicator" aria-hidden="true"></li>
    </ul>

    <button
      class="hamburger-btn"
      aria-label="菜单"
      aria-expanded="false"
      aria-controls="mobile-dropdown"
    >
      <span class="icon-bars">
        <Icon is:inline name="la:bars" />
      </span>
      <span class="icon-close">
        <Icon is:inline name="la:times" />
      </span>
    </button>
  </div>

  <div id="mobile-dropdown" class="mobile-dropdown" aria-hidden="true">
    <div class="mobile-dropdown-inner">
      <ul class="mobile-menu">
        {
          items.map((item) => (
            <li class="mobile-item">
              <a
                href={item.href}
                class:list={['mobile-link', 'hoverable', 'link-plain', { 'is-active': item.active }]}
                aria-current={item.active ? 'page' : undefined}
                tabindex="-1"
              >
                <span class="mobile-link-left">
                  <Icon is:inline name={item.icon} class="mobile-link-icon" />
                  <span class="mobile-link-text">{item.label}</span>
                </span>
                <Icon is:inline name="la:external-link-alt" class="mobile-link-arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</nav>

<div class="mobile-overlay" aria-hidden="true"></div>

<script>
  // 每页加载断点模块，保证 window.__onEnterDesktop 存在：
  // 汉堡菜单脚本只在移动端加载，目录 / 筛选抽屉从全局取共享的断点监听器
  import '../../assets/js/breakpoint';

  const mq = window.matchMedia('(max-width: 768px)');
  let loaded = false;

  function loadHamburger() {
    if (!loaded) {
      loaded = true;
      import('../../assets/js/hamburger');
    }
  }

  if (mq.matches) loadHamburger();
  mq.addEventListener('change', (e) => {
    if (e.matches) loadHamburger();
  });

  const desktopMq = window.matchMedia('(min-width: 769px)');
  let navLoaded = false;

  function loadNavIndicator() {
    if (!navLoaded) {
      navLoaded = true;
      import('../../assets/js/nav-indicator');
    }
  }

  if (desktopMq.matches) loadNavIndicator();
  desktopMq.addEventListener('change', (e) => {
    if (e.matches) loadNavIndicator();
  });
</script>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    border-radius: 0;
  }

  /* 与 .page-main 完全同一宽度公式（全站唯一宽度机制）：最宽 --content-width、
     视口不足时两侧各空 --page-gutter，左右边缘与页面内容在任何宽度下对齐。
     导航内容约 600px，最窄桌面视口（769px）的内容盒 657px 放得下，链接不折行 */
  .nav-inner {
    width: min(100% - var(--page-gutter) * 2, var(--content-width));
    margin: 0 auto;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--white);
    white-space: nowrap;
  }

  .nav-home-icon {
    width: 1.15em;
    height: 1.15em;
    color: var(--white);
  }

  .nav-links {
    position: relative;
    display: flex;
    gap: 4px;
  }

  .nav-links a {
    display: block;
    padding: 8px 12px;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink);
    transition: color var(--t-hover);
  }

  /* 图标 + 文字整体：下划线的位置 / 宽度从它量（nav-indicator.ts 量 .nav-link-inner），
     所以下划线一并描住图标；position: relative 给静态线 ::after 提供定位盒 */
  .nav-link-inner {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .nav-link-icon {
    width: 1em;
    height: 1em;
    margin-top: 2px; /* 数学居中观感偏高，视觉下移 2px */
    flex-shrink: 0;
  }

  /* 悬停 / 聚焦 / 当前页不走全站 .hoverable（那会加白底描边）：
     只提亮文字，静止与高亮都走现有令牌（--ink → --white） */
  .nav-links a:hover,
  .nav-links a:focus-visible,
  .nav-links a.is-active {
    color: var(--white);
  }

  /* 静态线：只负责首屏与加载期（is-active 服务端渲染，首帧即可见、不依赖 JS）；
     JS 接管（.js-ready）后由共享线独家绘制，静态线不再出现，两者同帧同位交接；
     bottom -8px 对齐链接底边（链接 padding-bottom 为 8px） */
  .nav-links:not(.js-ready) a.is-active .nav-link-inner::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -8px;
    height: 2px;
    border-radius: 1px;
    background: var(--white);
  }

  /* 共享线：JS 接管后下划线的唯一画者，点击 / 切页 / resize 都只重设它的目标位置；
     位移由 motion 驱动（nav-indicator.ts）：时长按位移成比例（450–700ms），
     曲线快起缓收（与后台侧栏一致），改向时从飞行中位置平滑续接 */
  .nav-indicator {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    border-radius: 1px;
    background: var(--white);
    opacity: 0;
    pointer-events: none;
  }

  .nav-indicator.is-on {
    opacity: 1;
  }

  .hamburger-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    padding: 0;
  }

  .icon-bars,
  .icon-close {
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
    color: var(--white);
  }

  .icon-bars :global(svg),
  .icon-close :global(svg) {
    width: 24px;
    height: 24px;
  }

  .icon-close {
    opacity: 0;
    transform: rotate(-90deg);
  }

  .hamburger-btn.is-open .icon-bars {
    opacity: 0;
    transform: rotate(90deg);
  }

  .hamburger-btn.is-open .icon-close {
    opacity: 1;
    transform: rotate(0deg);
  }

  /* 手机端下拉菜单 - 常驻DOM，用高度+位移实现滑落；
     开合动效由 motion 驱动（hamburger.ts）：这里只定义开/关两个端点状态，
     动画飞行中的值由 motion 接管，结束后提交的最终值与端点一致 */
  .mobile-dropdown {
    max-height: 0;
    overflow: hidden;
    border-top: 1px solid transparent;
  }

  .mobile-dropdown.is-open {
    /* --dd-h 由 hamburger.ts 在展开前量出的内层实高；+1px 是 border-top
       （全局 border-box，max-height 含边框）；380px 是无 JS 时的兜底 */
    max-height: calc(var(--dd-h, 380px) + 1px);
    border-top-color: rgba(255, 255, 255, 0.12);
  }

  .mobile-menu {
    /* 上下都不留内边距（刻意）：菜单与首/末项齐平，边界靠顶部分隔线，
       呼吸感由 48px 行高自身承担，别再加回来 */
    display: flex;
    flex-direction: column;
  }

  .mobile-item {
    width: 100%;
    position: relative;
  }

  .mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    box-sizing: border-box;
    padding: 0 28px;
    height: 48px;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--ink);
    border-radius: 0;
    border: none;
    text-decoration: none;
    position: relative;
    overflow: hidden;
  }

  .mobile-link-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .mobile-link-icon {
    width: 17px;
    height: 17px;
    color: var(--ink);
    flex-shrink: 0;
    transition: color var(--t-hover);
  }

  .mobile-link-arrow {
    width: 14px;
    height: 14px;
    color: var(--ink);
    flex-shrink: 0;
    /* color 是悬停提亮走 --t-hover；箭头 2px 挪位是位移，走自己的时长 */
    transition:
      color var(--t-hover),
      transform 0.15s;
  }

  .mobile-link-text {
    font-size: 0.88rem;
    letter-spacing: 0.02em;
  }

  .mobile-link:hover .mobile-link-icon,
  .mobile-link:hover .mobile-link-arrow {
    color: var(--white);
  }

  /* 当前页：文字 + 该项图标提亮（刻意不加位移 / 底色，见 mobile-link 两级规则） */
  .mobile-link.is-active,
  .mobile-link.is-active .mobile-link-icon {
    color: var(--white);
  }

  .mobile-link:hover .mobile-link-arrow {
    transform: translateX(2px);
  }

  /* 遮罩层（透明度由 motion 驱动，见 hamburger.ts） */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    background: var(--mask);
    z-index: 90;
    opacity: 0;
    pointer-events: none;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  @media (max-width: 768px) {
    .nav-inner {
      height: 56px;
      width: calc(100% - var(--page-gutter-mobile) * 2);
    }

    .nav-logo {
      font-size: 1.05rem;
    }

    .nav-links {
      display: none;
    }

    .hamburger-btn {
      display: flex;
    }
  }
</style>
