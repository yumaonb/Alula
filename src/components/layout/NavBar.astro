---
// NavBar.astro — 导航栏（桌面链接 + 移动端汉堡菜单）
// 用法：<NavBar />（BaseLayout 引入）
import { Icon } from 'astro-icon/components';
import { site } from '../../data/site';
import { navMatch } from '../../lib/nav-match';

// 导航项单一数据源：桌面与移动两套标记都从它生成，URL 只在这里出现一次
const navItems = [
  { href: '/', label: '首页', mobileIcon: 'la:home' },
  { href: '/about/', label: '关于', mobileIcon: 'la:user' },
  { href: '/projects/', label: '项目', mobileIcon: 'la:cubes' },
  { href: '/posts/', label: '文章', mobileIcon: 'la:pen-fancy' },
  { href: '/friends/', label: '友链', mobileIcon: 'la:link' },
  { href: '/sponsor/', label: '赞助', mobileIcon: 'la:hand-holding-heart' },
];

// is-active / aria-current 服务端渲染：下划线在首屏 HTML 里即可见，不依赖 JS；
// 切页后由 nav-indicator.ts 在这块常驻导航上更新
const items = navItems.map((item) => ({ ...item, active: navMatch(item.href, Astro.url.pathname) }));
---

<nav class="navbar glass">
  <div class="nav-inner">
    <a href="/" class="nav-logo link-plain" aria-label="首页">
      <Icon name="la:home" class="nav-home-icon" />
      {site.name}
    </a>

    <ul class="nav-links">
      {
        items.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['link-plain', { 'is-active': item.active }]}
              aria-current={item.active ? 'page' : undefined}
            >
              <span class="nav-link-text">{item.label}</span>
            </a>
          </li>
        ))
      }
      <!-- 共享线：绝对定位不占 flex 位；静态线（活动项 ::after）负责首屏，JS 接管后由它独家绘制（nav-indicator.ts） -->
      <li class="nav-indicator" aria-hidden="true"></li>
    </ul>

    <button
      class="hamburger-btn"
      aria-label="菜单"
      aria-expanded="false"
      aria-controls="mobile-dropdown"
    >
      <span class="icon-bars">
        <Icon name="la:bars" />
      </span>
      <span class="icon-close">
        <Icon name="la:times" />
      </span>
    </button>
  </div>

  <div id="mobile-dropdown" class="mobile-dropdown" aria-hidden="true">
    <div class="mobile-dropdown-inner">
      <ul class="mobile-menu">
        {
          items.map((item) => (
            <li class="mobile-item">
              <a href={item.href} class="mobile-link hoverable link-plain" tabindex="-1">
                <span class="mobile-link-left">
                  <Icon name={item.mobileIcon} class="mobile-link-icon" />
                  <span class="mobile-link-text">{item.label}</span>
                </span>
                <Icon name="la:external-link-alt" class="mobile-link-arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</nav>

<div class="mobile-overlay" aria-hidden="true"></div>

<script>
  // 每页加载断点模块，保证 window.__onEnterDesktop 存在：
  // 汉堡菜单脚本只在移动端加载，目录 / 筛选抽屉从全局取共享的断点监听器
  import '../../assets/js/breakpoint';

  const mq = window.matchMedia('(max-width: 768px)');
  let loaded = false;

  function loadHamburger() {
    if (!loaded) {
      loaded = true;
      import('../../assets/js/hamburger');
    }
  }

  if (mq.matches) loadHamburger();
  mq.addEventListener('change', (e) => {
    if (e.matches) loadHamburger();
  });

  // 下划线指示器只在桌面端加载，手机端不引入
  const desktopMq = window.matchMedia('(min-width: 769px)');
  let navLoaded = false;

  function loadNavIndicator() {
    if (!navLoaded) {
      navLoaded = true;
      import('../../assets/js/nav-indicator');
    }
  }

  if (desktopMq.matches) loadNavIndicator();
  desktopMq.addEventListener('change', (e) => {
    if (e.matches) loadNavIndicator();
  });
</script>

<style>
  /* 导航栏容器 */
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    border-radius: 0;
  }

  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Logo */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--hover-ink);
    white-space: nowrap;
  }

  .nav-home-icon {
    width: 1.15em;
    height: 1.15em;
    color: var(--icon-hover);
  }

  /* 桌面端链接 */
  .nav-links {
    position: relative;
    display: flex;
    gap: 4px;
  }

  .nav-links a {
    display: block;
    padding: 8px 20px;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--icon-ink);
    transition: color 0.25s ease;
  }

  /* 悬停 / 聚焦 / 当前页不走全站 .hoverable（那会加白底描边）：
     只提亮文字，静止与高亮都走现有令牌（--icon-ink → --icon-hover） */
  .nav-links a:hover,
  .nav-links a:focus-visible,
  .nav-links a.is-active {
    color: var(--icon-hover);
  }

  /* 文字包裹：下划线的位置 / 宽度从它量（nav-indicator.ts）；
     inline-block 让 offset 度量稳定，::after 才有可靠的定位盒 */
  .nav-link-text {
    position: relative;
    display: inline-block;
  }

  /* 静态线：只负责首屏与加载期（is-active 服务端渲染，首帧即可见、不依赖 JS）；
     JS 接管（.js-ready）后由共享线独家绘制，静态线不再出现，两者同帧同位交接；
     bottom -8px 对齐链接底边（链接 padding-bottom 为 8px） */
  .nav-links:not(.js-ready) a.is-active .nav-link-text::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -8px;
    height: 2px;
    border-radius: 1px;
    background: var(--icon-hover);
  }

  /* 共享线：JS 接管后下划线的唯一画者，点击 / 切页 / resize 都只重设它的目标位置；
     快速连点是过渡重定向，从当前位置平滑改向（线不会消失，所以不会跳变）。
     曲线快起缓收（与后台侧栏一致）：点击后线立刻起步，没有"没反应"的空窗。
     时长按位移成比例由 nav-indicator.ts 内联覆盖（300–450ms），这里的 0.3s 只是基线：
     改向的短距离若跑满 0.3s 会一闪而过，看着像跳变 */
  .nav-indicator {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    border-radius: 1px;
    background: var(--icon-hover);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.3s cubic-bezier(0.32, 0.72, 0, 1),
      width 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .nav-indicator.is-on {
    opacity: 1;
  }

  .nav-indicator.no-transition {
    transition: none;
  }

  /* 汉堡按钮（桌面隐藏） */
  .hamburger-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    padding: 0;
  }

  .icon-bars,
  .icon-close {
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
    color: var(--icon-hover);
  }

  .icon-bars :global(svg),
  .icon-close :global(svg) {
    width: 24px;
    height: 24px;
  }

  .icon-close {
    opacity: 0;
    transform: rotate(-90deg);
  }

  .hamburger-btn.is-open .icon-bars {
    opacity: 0;
    transform: rotate(90deg);
  }

  .hamburger-btn.is-open .icon-close {
    opacity: 1;
    transform: rotate(0deg);
  }

  /* 手机端下拉菜单 - 常驻DOM，用高度+位移实现滑落 */
  .mobile-dropdown {
    max-height: 0;
    overflow: hidden;
    border-top: 1px solid transparent;
    transition:
      max-height 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      /* 收回时顶线先保持（菜单收合的主体阶段），再随尾部一起淡出、
         总时长与 max-height 对齐：线要等菜单滑回顶栏重合后才消失 */
      border-color 0.2s ease 0.2s;
  }

  .mobile-dropdown.is-open {
    /* --dd-h 由 hamburger.ts 在展开前量出的内层实高；+1px 是 border-top
       （全局 border-box，max-height 含边框）；380px 是无 JS 时的兜底 */
    max-height: calc(var(--dd-h, 380px) + 1px);
    border-top-color: rgba(255, 255, 255, 0.12);
    transition:
      max-height 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.25s ease; /* 展开时线随菜单立即出现 */
  }

  /* 切页收起：用 0.2s 快于常规 0.4s 的收起，内容替换后菜单不残留 */
  .mobile-dropdown.is-closing-nav {
    transition:
      max-height 0.2s ease,
      /* 同常规收回：线先保持、随菜单尾部淡出（合计 0.2s） */
      border-color 0.1s ease 0.1s;
  }

  .mobile-overlay.is-closing-nav {
    transition: opacity 0.2s ease;
  }

  .hamburger-btn.is-closing-nav .icon-bars,
  .hamburger-btn.is-closing-nav .icon-close {
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  /* 内容替换兜底：菜单仍未关闭时直接跳过过渡 */
  .mobile-dropdown.no-transition,
  .mobile-overlay.no-transition,
  .hamburger-btn.no-transition .icon-bars,
  .hamburger-btn.no-transition .icon-close {
    transition: none !important;
    animation: none !important;
  }

  .mobile-dropdown.no-transition .mobile-dropdown-inner,
  .mobile-dropdown.no-transition .mobile-item {
    animation: none !important;
  }

  .mobile-dropdown.is-open .mobile-dropdown-inner {
    animation: mobile-inner-in 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes mobile-inner-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mobile-menu {
    /* 上下都不留内边距（刻意）：菜单与首/末项齐平，边界靠顶部分隔线，
       呼吸感由 48px 行高自身承担，别再加回来 */
    display: flex;
    flex-direction: column;
  }

  .mobile-item {
    width: 100%;
    position: relative;
  }

  .mobile-dropdown.is-open .mobile-item {
    animation: mobile-item-in 0.3s ease both;
  }

  .mobile-dropdown.is-open .mobile-item:nth-child(1) {
    animation-delay: 0.04s;
  }
  .mobile-dropdown.is-open .mobile-item:nth-child(2) {
    animation-delay: 0.08s;
  }
  .mobile-dropdown.is-open .mobile-item:nth-child(3) {
    animation-delay: 0.12s;
  }
  .mobile-dropdown.is-open .mobile-item:nth-child(4) {
    animation-delay: 0.16s;
  }
  .mobile-dropdown.is-open .mobile-item:nth-child(5) {
    animation-delay: 0.2s;
  }
  .mobile-dropdown.is-open .mobile-item:nth-child(6) {
    animation-delay: 0.24s;
  }

  @keyframes mobile-item-in {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    box-sizing: border-box;
    padding: 0 28px;
    height: 48px;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--icon-ink);
    border-radius: 0;
    border: none;
    text-decoration: none;
    position: relative;
    overflow: hidden;
  }

  .mobile-link-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .mobile-link-icon {
    width: 17px;
    height: 17px;
    color: var(--icon-ink);
    flex-shrink: 0;
    transition: color 0.15s;
  }

  .mobile-link-arrow {
    width: 14px;
    height: 14px;
    color: var(--icon-ink);
    flex-shrink: 0;
    transition:
      color 0.15s,
      transform 0.15s;
  }

  .mobile-link-text {
    font-size: 0.88rem;
    letter-spacing: 0.02em;
  }

  .mobile-link:hover .mobile-link-icon,
  .mobile-link:hover .mobile-link-arrow {
    color: var(--icon-hover);
  }

  .mobile-link:hover .mobile-link-arrow {
    transform: translateX(2px);
  }

  /* 遮罩层 */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    background: var(--mask);
    z-index: 90;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  /* 手机端适配 */
  @media (max-width: 768px) {
    .nav-inner {
      height: 56px;
      padding: 0 16px;
    }

    .nav-logo {
      font-size: 1.05rem;
    }

    .nav-links {
      display: none;
    }

    .hamburger-btn {
      display: flex;
    }
  }
</style>
