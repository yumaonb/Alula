---
// Quote.astro — 随机一言（客户端随机选取）
// 用法：<Quote />
import { quotes } from '../../data/quotes';
---

<div class="quote-body">
  <p class="quote-text" id="quote-text"></p>
  <p class="quote-source" id="quote-source"></p>
</div>

<script is:inline define:vars={{ quotes }}>
  (function () {
    const textEl = document.getElementById('quote-text');
    const sourceEl = document.getElementById('quote-source');
    const q = quotes[Math.floor(Math.random() * quotes.length)];
    // 数据集为空或这条缺 text：给出占位文案，不让卡片留白
    if (!q?.text) {
      console.error('[Quote] 一言数据集为空或数据缺 text');
      if (textEl) textEl.textContent = '暂无一言';
      return;
    }
    if (textEl) textEl.textContent = q.text;
    // 两个字段各自可选：只写了人物时不该拼出「某人「undefined」」
    const from = q.from || '';
    const source = q.fromWho ? (from ? q.fromWho + '\u300C' + from + '\u300D' : q.fromWho) : from;
    if (sourceEl) sourceEl.textContent = source;
  })();
</script>

<style>
  .quote-body {
    display: flex;
    flex-direction: column;
    min-height: 90px;
    justify-content: center;
    overflow: hidden;
  }
  .quote-text {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--ink);
    font-style: italic;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .quote-source {
    font-size: 0.75rem;
    color: var(--ink);
    text-align: right;
  }
  @media (min-width: 1024px) {
    .quote-text {
      font-size: 1rem;
    }
  }
</style>
