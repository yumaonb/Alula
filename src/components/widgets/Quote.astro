---
// Quote.astro — 随机一言（客户端随机）
import { quotes } from '../../data/quotes';
---

<div class="quote-body" id="quote-box">
  <p class="quote-text" id="quote-text"></p>
  <p class="quote-source" id="quote-source"></p>
</div>

<script is:inline define:vars={{ quotes }}>
  (function () {
    var idx = Math.floor(Math.random() * quotes.length);
    var q = quotes[idx];
    var textEl = document.getElementById('quote-text');
    var sourceEl = document.getElementById('quote-source');
    if (textEl) textEl.textContent = q.text;
    var source = q.fromWho
      ? q.fromWho + '\u300C' + q.from + '\u300D'
      : q.from || '';
    if (sourceEl) sourceEl.textContent = source;
  })();
</script>

<style>
.quote-body {
  display: flex;
  flex-direction: column;
  height: 90px;
  justify-content: center;
  overflow: hidden;
}
.quote-text {
  font-size: 0.95rem;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.8);
  font-style: italic;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.quote-source {
  font-size: 0.75rem;
  color: rgba(255, 255, 255, 0.4);
  text-align: right;
}
@media (min-width: 1024px) {
  .quote-text { font-size: 1rem; }
}
</style>