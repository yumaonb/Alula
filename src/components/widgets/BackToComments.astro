---
// BackToComments.astro — 到评论按钮
import { Icon } from 'astro-icon/components';
---

<button class="back-to-comments" id="back-to-comments" aria-label="到评论">
  <Icon name="la:comment" class="back-to-comments-icon" />
</button>

<script is:inline>
(function() {
  var btn = document.getElementById('back-to-comments');
  if (!btn) return;

  function toggleBtn() {
    var hasTarget = !!document.getElementById('comments');
    btn.classList.toggle('visible', hasTarget && window.scrollY > 300);
  }

  btn.addEventListener('click', function() {
    var target = document.getElementById('comments');
    if (!target) return;
    var y = target.getBoundingClientRect().top + window.scrollY - 88;
    window.scrollTo({ top: y, behavior: 'smooth' });
  });

  window.addEventListener('scroll', toggleBtn, { passive: true });
  toggleBtn();
})();
</script>

<style>
  .back-to-comments {
    position: fixed;
    right: 20px;
    bottom: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.03);
    color: rgba(255, 255, 255, 0.4);
    cursor: pointer;
    opacity: 0;
    transform: translateX(80px);
    transition: opacity 0.3s ease, transform 0.3s ease,
                color 0.15s ease, background 0.15s ease;
    pointer-events: none;
    z-index: 50;
  }

  .back-to-comments.visible {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  .back-to-comments:hover {
    color: rgba(255, 255, 255, 0.8);
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.15);
  }

  .back-to-comments-icon {
    width: 24px;
    height: 24px;
  }
</style>