---
// BackToBottom.astro — 到底部按钮
import { Icon } from 'astro-icon/components';
---

<button class="back-to-widget" id="back-to-bottom" aria-label="到底部">
  <Icon name="la:arrow-down" class="back-to-widget-icon" />
</button>

<script is:inline>
(function() {
  var btn = document.getElementById('back-to-bottom');
  if (!btn) return;

  function toggleBtn() {
    btn.classList.toggle('visible', window.scrollY > 300);
  }

  btn.addEventListener('click', function() {
    window.scrollTo({ top: document.documentElement.scrollHeight, behavior: 'smooth' });
  });

  window.addEventListener('scroll', toggleBtn, { passive: true });
  toggleBtn();
})();
</script>

<style>
  .back-to-widget { bottom: 100px; }
</style>