---
// 技能栈组件
const skills = [
  { name: 'Vue / Vue 3', level: 82, color: '#42b883' },
  { name: 'TypeScript', level: 70, color: '#3178c6' },
  { name: 'Astro', level: 65, color: '#ff5d01' },
  { name: 'React', level: 55, color: '#61dafb' },
  { name: 'Node.js', level: 58, color: '#68a063' },
  { name: 'CSS / Tailwind', level: 78, color: '#38bdf8' },
  { name: 'Git / GitHub', level: 72, color: '#f05032' },
  { name: 'Python', level: 48, color: '#ffd43b' },
];
---

<div class="skills-grid">
  {skills.map((skill) => (
    <div class="skill-card glass" style={{ '--accent': skill.color }}>
      <div class="skill-header">
        <span class="skill-name">{skill.name}</span>
        <span class="skill-pct">{skill.level}%</span>
      </div>
      <div class="skill-track">
        <div class="skill-fill" style={{ width: skill.level + '%' }}></div>
      </div>
    </div>
  ))}
</div>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .skill-card {
    padding: 14px 18px;
    border-radius: var(--radius);
  }

  .skill-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .skill-name {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.75);
    font-weight: 500;
  }

  .skill-pct {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .skill-track {
    height: 4px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 2px;
    overflow: hidden;
  }

  .skill-fill {
    height: 100%;
    border-radius: 2px;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    animation: skill-grow 1.2s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-timeline: view();
    animation-range: entry 0% entry 100%;
  }

  @keyframes skill-grow {
    from { width: 0; }
  }

  @media (max-width: 640px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>