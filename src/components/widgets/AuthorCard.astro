---
// AuthorCard.astro — 作者名片
// 用法：<AuthorCard />
import { getImage } from 'astro:assets';
import avatarRaw from '../../assets/images/avatar.png';
import { nickname, motto, socialLinks } from '../../data/profile';
import { Icon } from 'astro-icon/components';

const avatar = await getImage({ src: avatarRaw, format: 'webp', quality: 80, width: 96 });
---

<div class="author-card glass">
  <div class="author-main">
    <div class="avatar-ring author-avatar-ring">
      <img
        src={avatar.src}
        alt={nickname}
        class="avatar-img"
        width="56"
        height="56"
        loading="eager"
      />
    </div>
    <div class="author-text">
      <span class="author-name">{nickname}</span>
      <span class="author-motto">{motto}</span>
    </div>
  </div>
  <div class="author-socials">
    {socialLinks.map((s) => (
      <a
        href={s.url}
        target="_blank"
        rel="noopener"
        aria-label={s.label}
        class="author-social hoverable link-plain"
      >
        <Icon name={s.icon} class="social-icon" />
      </a>
    ))}
  </div>
</div>

<style>
  .author-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
    border-radius: var(--radius);
  }

  .author-main {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 14px;
  }

  /* 头像元件（白环 + 圆形裁切，尺寸由 --avatar-size 控制，默认 100px，
   * 本页用 .author-avatar-ring 改成 56px） */
  .avatar-ring {
    --avatar-size: 100px;
    width: var(--avatar-size);
    height: var(--avatar-size);
    border-radius: 50%;
    padding: 2px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 0 12px rgba(255, 255, 255, 0.25);
    flex-shrink: 0;
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .author-avatar-ring {
    --avatar-size: 56px;
  }

  .author-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .author-name {
    font-size: 1.02rem;
    font-weight: 700;
    color: #fff;
  }

  .author-motto {
    font-size: 0.76rem;
    color: rgba(255, 255, 255, 0.45);
    letter-spacing: 0.05em;
  }

  .author-socials {
    display: flex;
    justify-content: space-between;
    gap: 6px;
  }

  .author-social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.5);
  }

    .social-icon {
    width: 16px;
    height: 16px;
  }
</style>
